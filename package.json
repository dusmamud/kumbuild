{
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.158.0"
  },
  "name": "kumbuild",
  "packageManager": "pnpm@10.34.9",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:app": "turbo run build --filter=kumbuild-app",
    "build:web": "turbo run build --filter=kumbuild-web",
    "dev": "turbo run dev",
    "dev:app": "turbo run dev --filter=kumbuild-app",
    "dev:web": "turbo run dev --filter=kumbuild-web",
    "build:blog": "turbo run build --filter=kumbuild-blog",
    "build:docs": "turbo run build --filter=kumbuild-docs",
    "dev:blog": "turbo run dev --filter=kumbuild-blog",
    "dev:docs": "turbo run dev --filter=kumbuild-docs",
    "build:account": "turbo run build --filter=kumbuild-account",
    "build:admin": "turbo run build --filter=kumbuild-admin",
    "build:home": "turbo run build --filter=kumbuild-home",
    "dev:account": "turbo run dev --filter=kumbuild-account",
    "dev:admin": "turbo run dev --filter=kumbuild-admin",
    "dev:home": "turbo run dev --filter=kumbuild-home"
  },
  "version": "0.1.0"
}
