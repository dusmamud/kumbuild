# Cloudflare Tunnel (kumbuild-api) — systemd unit (Oracle VPS, Oracle Linux 9).
#
# Dev (current): a quick tunnel — `cloudflared tunnel --url http://localhost:8080` —
# hands out a random https://<random>.trycloudflare.com URL that changes on
# every restart (frontend must be rebuilt + redeployed with the new URL).
# Prod (after the domain is bought): swap ExecStart for a NAMED tunnel via
# /etc/cloudflared/config.yml (tunnel create kumbuild-api + route dns to
# api.kumbuild.com).
[Unit]
Description=Cloudflare Tunnel (kumbuild-api)
After=network-online.target kumbuild-api.service
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/cloudflared tunnel --url http://localhost:8080
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
