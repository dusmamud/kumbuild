# Kumbuild backend — example environment file.
# Copy to .env — never commit real values; all secrets live in env / GitHub
# Secrets, never in code. On the VPS this file's real values live in
# /etc/kumbuild/api.env, written by the deploy workflow from GitHub Secrets.

# --- Server ---
# dev or prod. Drives cookie SameSite/Domain defaults (dev: SameSite=None,
# no Domain; prod: SameSite=Lax, Domain=.kumbuild.com).
APP_ENV=dev
# Port the API listens on (localhost only — Cloudflare Tunnel fronts it).
PORT=8080

# --- Database ---
# Postgres connection string (same VPS box). Pool is capped at 10 conns;
# Postgres max_connections is 30 on the 1GB VPS.
DATABASE_URL=postgres://kumbuild:CHANGE_ME@localhost:5432/kumbuild

# --- Redis ---
# Rate limiting / OTP counters only — sessions live in Postgres, never here.
REDIS_ADDR=localhost:6379
# Redis password (set by the deploy workflow into redis.conf via sed).
REDIS_PASSWORD=CHANGE_ME

# --- Brevo (email) ---
# Brevo API key (free tier, 300 emails/day). Never commit the real key.
BREVO_API_KEY=CHANGE_ME
# Generic sender identity (fallback for both Tx and Promo).
MAIL_FROM_EMAIL=hello@example.com
MAIL_FROM_NAME=Kumbuild
# Transactional identity: OTP, invite, reset, order mails.
MAIL_TX_FROM_EMAIL=hello@example.com
MAIL_TX_FROM_NAME=Kumbuild
# Promotional identity: offers/updates, only to opted-in users.
MAIL_PROMO_FROM_EMAIL=hello@example.com
MAIL_PROMO_FROM_NAME=Kumbuild
# Brevo API base URL override — local testing ONLY. Point it at a fake Brevo
# server to smoke-test mail flows without a real key; leave the default in
# production (never point it at an untrusted host with a real API key).
MAILER_API_BASE_URL=https://api.brevo.com/v3

# --- App ---
# Public base URL of the API (dev: the trycloudflare quick-tunnel URL;
# prod: https://api.kumbuild.com). Used in invite/reset email links.
APP_BASE_URL=http://localhost:8080

# --- Turnstile ---
# Secret key for server-side verification (never in frontend code/logs).
TURNSTILE_SECRET_KEY=CHANGE_ME
# Dev only (from Cloudflare docs): the public test secret below always
# passes verification — use it ONLY in dev, never in production.
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Public sitekey for the frontend widget (not a secret).
TURNSTILE_SITE_KEY=CHANGE_ME

# --- Cookie ---
# Session cookie domain. Empty in dev; prod: .kumbuild.com (SSO across
# subdomains). Leave empty here for dev — prod sets it via GitHub Secrets.
COOKIE_DOMAIN=

# --- CORS ---
# Comma-separated allowed origins. Empty = the 7 *.pages.dev frontends +
# localhost dev servers (see internal/config DefaultAllowedOrigins).
ALLOWED_ORIGINS=
