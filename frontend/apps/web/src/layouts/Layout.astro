---
import "../styles/theme.css";
import { pageUrl, type Dictionary, type Locale } from "../i18n/utils";

interface Props {
  title: string;
  description: string;
  locale: Locale;
  dict: Dictionary;
  /** page slug without locale prefix, e.g. "/pricing" or "/" */
  slug: string;
}

const { title, description, locale, dict, slug } = Astro.props;
const nav = dict.nav;
const current = pageUrl(locale, slug);
const links = [
  { href: pageUrl(locale, "/services"), label: nav.services },
  { href: pageUrl(locale, "/pricing"), label: nav.pricing },
  { href: pageUrl(locale, "/how-it-works"), label: nav.howItWorks },
  { href: pageUrl(locale, "/examples"), label: nav.examples },
  { href: pageUrl(locale, "/faq"), label: nav.faq },
  { href: pageUrl(locale, "/contact"), label: nav.contact },
];
const locales: { code: Locale; label: string }[] = [
  { code: "en-US", label: "English" },
  { code: "hi", label: "हिन्दी" },
  { code: "bn", label: "বাংলা" },
];
const desktopLink = (active: boolean) =>
  active
    ? "font-semibold text-ink underline decoration-primary-500 decoration-2 underline-offset-8"
    : "font-medium text-body transition-colors hover:text-ink";
const mobileLink = (active: boolean) =>
  active
    ? "flex items-center justify-between gap-4 border-b border-line py-4 font-display text-[26px] font-semibold leading-tight text-primary-700"
    : "flex items-center justify-between gap-4 border-b border-line py-4 font-display text-[26px] font-semibold leading-tight text-ink";
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Kumbuild</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/logo/kumbuild-logo.svg" />
    {/*
      Fonts — same as dusrel-image docs-site (Inter for text, Sora for
      display), plus Noto Sans Devanagari/Bengali so hi/bn text renders
      in the same stack instead of falling back to system fonts.
      NOTE: Inter/Sora were declared in theme.css but never loaded —
      the site rendered in system sans until now.
    */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Sora:wght@600;700;800&family=Noto+Sans+Devanagari:wght@400;500;600;700&family=Noto+Sans+Bengali:wght@400;500;600;700&display=swap"
    />
  </head>
  <body class="min-h-screen bg-white text-body">
    <div class="hidden bg-ink text-white md:block">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-4 py-2 text-xs sm:px-6">
        <p class="flex items-center gap-2 text-white/80">
          <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-green-400" aria-hidden="true"></span>
          {dict.hero.badge}
        </p>
        <p class="hidden font-mono text-white/55 lg:block">{dict.hero.note}</p>
      </div>
    </div>
    <header class="sticky top-0 z-50">
      <div class="relative z-10 border-b border-line bg-white/95 backdrop-blur-md">
      <div class="mx-auto flex h-[72px] max-w-6xl items-center gap-3 px-4 sm:px-6">
        <a href={pageUrl(locale, "/")} class="flex shrink-0 items-center gap-2.5 text-ink">
          <img src="/logo/kumbuild-logo.svg" alt="Kumbuild" width="40" height="40" class="h-10 w-10" />
          <span class="font-display text-[19px] font-bold">Kumbuild</span>
        </a>
        <nav class="ml-8 hidden items-center gap-8 text-[15px] lg:flex" aria-label="Main">
          {links.map((l) => (
            <a href={l.href} aria-current={l.href === current ? "page" : undefined} class={desktopLink(l.href === current)}>{l.label}</a>
          ))}
        </nav>
        <div class="ml-auto flex items-center gap-2 sm:gap-3">
          <div class="relative hidden lg:block">
            <button
              id="locale-btn"
              type="button"
              class="flex items-center gap-1.5 rounded-lg border border-line px-3 py-2 text-[13px] font-semibold text-body transition-colors hover:bg-surface"
              aria-expanded="false"
              aria-haspopup="true"
              aria-label="Change language"
            >
              <svg class="h-3.5 w-3.5 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" /><path d="M2 12h20" /></svg>
              {locales.find((l) => l.code === locale)?.label}
              <svg class="h-3 w-3 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
            </button>
            <div id="locale-menu" class="absolute right-0 top-full z-50 mt-2 hidden w-40 overflow-hidden rounded-xl border border-line bg-white py-1 shadow-[0_8px_24px_rgba(15,23,42,0.12)]">
              {locales.map((l) => (
                <a
                  href={pageUrl(l.code, slug)}
                  class={l.code === locale
                    ? "block bg-primary-50 px-3 py-2 text-sm font-semibold text-primary-700"
                    : "block px-3 py-2 text-sm text-body hover:bg-surface hover:text-primary-700"}
                >{l.label}</a>
              ))}
            </div>
          </div>
          <a href="https://auth.kumbuild.com/login" class="hidden text-[15px] font-medium text-body transition-colors hover:text-ink lg:block">{nav.login}</a>
          <a href={pageUrl(locale, "/order")} class="inline-flex items-center gap-1.5 whitespace-nowrap rounded-xl bg-primary-500 px-5 py-2.5 text-[15px] font-semibold text-white transition-colors hover:bg-primary-600">
            {nav.order}
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </a>
          <button
            id="menu-btn"
            type="button"
            class="rounded-lg border border-line p-2.5 text-ink transition-colors hover:bg-surface lg:hidden"
            aria-expanded="false"
            aria-controls="mobile-menu"
            aria-label="Menu"
          >
            <svg id="icon-open" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
            <svg id="icon-close" class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
          </button>
        </div>
      </div>
      </div>
      <div id="mobile-menu" class="fixed inset-0 z-0 hidden overflow-y-auto bg-white lg:hidden">
        <div class="flex min-h-full flex-col px-5 pb-8 pt-[88px] sm:px-8">
          <nav class="flex flex-col" aria-label="Mobile">
            {links.map((l, i) => (
              <a href={l.href} aria-current={l.href === current ? "page" : undefined} class={mobileLink(l.href === current)}>
                <span class="flex items-baseline gap-3.5">
                  <span class="font-mono text-xs font-normal text-muted">{String(i + 1).padStart(2, "0")}</span>
                  {l.label}
                </span>
                <svg class={`h-5 w-5 shrink-0 ${l.href === current ? "text-primary-500" : "text-muted"}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
              </a>
            ))}
          </nav>
          <a href={pageUrl(locale, "/order")} class="mt-8 flex items-center justify-center gap-2 rounded-xl bg-primary-500 px-4 py-4 text-base font-semibold text-white">
            {nav.order}
            <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </a>
          <a href="https://auth.kumbuild.com/login" class="mt-4 text-center text-[15px] font-medium text-body">{nav.login}</a>
          <div class="mt-auto pt-12">
            <div class="flex items-center gap-2">
              {locales.map((l) => (
                <a
                  href={pageUrl(l.code, slug)}
                  class={l.code === locale
                    ? "rounded-full bg-primary-50 px-3.5 py-1.5 text-[13px] font-semibold text-primary-700 ring-1 ring-primary-500"
                    : "rounded-full px-3.5 py-1.5 text-[13px] font-semibold text-muted ring-1 ring-line"}
                >{l.label}</a>
              ))}
            </div>
            <p class="mt-5 text-[13px] text-muted">{dict.footer.tagline} · {dict.hero.note}</p>
          </div>
        </div>
      </div>
    </header>
    <script>
      const btn = document.getElementById("menu-btn");
      const menu = document.getElementById("mobile-menu");
      const iconOpen = document.getElementById("icon-open");
      const iconClose = document.getElementById("icon-close");
      function setOpen(open) {
        menu.classList.toggle("hidden", !open);
        iconOpen.classList.toggle("hidden", open);
        iconClose.classList.toggle("hidden", !open);
        btn.setAttribute("aria-expanded", String(open));
        document.body.style.overflow = open ? "hidden" : "";
      }
      btn.addEventListener("click", () => setOpen(menu.classList.contains("hidden")));
      menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          setOpen(false);
          setLocaleOpen(false);
        }
      });
      const localeBtn = document.getElementById("locale-btn");
      const localeMenu = document.getElementById("locale-menu");
      function setLocaleOpen(open) {
        if (!localeMenu) return;
        localeMenu.classList.toggle("hidden", !open);
        localeBtn.setAttribute("aria-expanded", String(open));
      }
      if (localeBtn) {
        localeBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          setLocaleOpen(localeMenu.classList.contains("hidden"));
        });
        document.addEventListener("click", (e) => {
          if (!localeMenu.classList.contains("hidden") && !localeMenu.contains(e.target)) {
            setLocaleOpen(false);
          }
        });
      }
    </script>

    <main>
      <slot />
    </main>

    <footer class="mt-16 border-t border-line bg-surface">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:grid-cols-3">
        <div>
          <div class="flex items-center gap-2 font-display font-semibold text-ink">
            <img src="/logo/kumbuild-logo.svg" alt="Kumbuild" width="28" height="28" />
            <span>Kumbuild</span>
          </div>
          <p class="mt-2 text-sm text-muted">{dict.footer.tagline}</p>
          <p class="mt-2 text-xs text-muted">{dict.footer.draftNote}</p>
        </div>
        <div>
          <p class="font-display text-sm font-semibold text-ink">{dict.footer.services}</p>
          <ul class="mt-2 space-y-1 text-sm text-muted">
            {dict.services.items.map((s) => (
              <li><a href={pageUrl(locale, "/services")} class="hover:text-primary-700">{s.title}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <p class="font-display text-sm font-semibold text-ink">{dict.footer.company}</p>
          <ul class="mt-2 space-y-1 text-sm text-muted">
            <li><a href={pageUrl(locale, "/about")} class="hover:text-primary-700">{dict.about.title}</a></li>
            <li><a href={pageUrl(locale, "/pricing")} class="hover:text-primary-700">{nav.pricing}</a></li>
            <li><a href={pageUrl(locale, "/faq")} class="hover:text-primary-700">{nav.faq}</a></li>
            <li><a href={pageUrl(locale, "/contact")} class="hover:text-primary-700">{nav.contact}</a></li>
            <li><a href={pageUrl(locale, "/privacy")} class="hover:text-primary-700">{dict.privacy.title}</a></li>
            <li><a href={pageUrl(locale, "/terms")} class="hover:text-primary-700">{dict.terms.title}</a></li>
          </ul>
        </div>
      </div>
      <div class="border-t border-line py-4 text-center text-xs text-muted">
        © 2026 Kumbuild · {dict.footer.rights}
      </div>
    </footer>
  </body>
</html>
