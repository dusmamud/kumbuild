---
import "../styles/theme.css";
import Icon from "../components/Icon.astro";
import { pageUrl, type Dictionary, type Locale } from "../i18n/utils";

interface Props {
  title: string;
  description: string;
  locale: Locale;
  dict: Dictionary;
  /** page slug without locale prefix, e.g. "/pricing" or "/" */
  slug: string;
}

const { title, description, locale, dict, slug } = Astro.props;
const nav = dict.nav;
const v2 = dict.v2;
const current = pageUrl(locale, slug);
const onServices = slug.startsWith("/services");
const links = [
  { href: pageUrl(locale, "/pricing"), label: nav.pricing },
  { href: pageUrl(locale, "/how-it-works"), label: nav.howItWorks },
  { href: pageUrl(locale, "/examples"), label: v2.nav.work },
  { href: pageUrl(locale, "/about"), label: dict.about.title.replace(" Kumbuild", "") },
  { href: pageUrl(locale, "/faq"), label: nav.faq },
  { href: pageUrl(locale, "/contact"), label: nav.contact },
];
const locales: { code: Locale; label: string }[] = [
  { code: "en-US", label: "English" },
  { code: "hi", label: "हिन्दी" },
  { code: "bn", label: "বাংলা" },
];
const desktopLink = (active: boolean) =>
  active
    ? "font-semibold text-ink underline decoration-primary-500 decoration-2 underline-offset-8"
    : "font-medium text-body transition-colors duration-200 hover:text-ink";
const mobileLink = (active: boolean) =>
  active
    ? "flex items-center justify-between gap-4 border-b border-line py-4 font-display text-[26px] font-semibold leading-tight text-primary-700"
    : "flex items-center justify-between gap-4 border-b border-line py-4 font-display text-[26px] font-semibold leading-tight text-ink";
const waLink = `https://wa.me/${v2.contact.waNumber}?text=${encodeURIComponent(v2.contact.waText)}`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Kumbuild</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf9f6" />
    <meta property="og:title" content={`${title} — Kumbuild`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/og/kumbuild-og.png" />
    <link rel="icon" type="image/svg+xml" href="/logo/kumbuild-logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Sora:wght@600;700&family=Noto+Sans+Devanagari:wght@400;500;600;700&family=Noto+Sans+Bengali:wght@400;500;600;700&display=swap"
    />
  </head>
  <body class="min-h-screen bg-paper text-body">
    <div class="hidden bg-ink text-white md:block">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-4 py-1.5 text-xs sm:px-6">
        <p class="flex items-center gap-2 text-white/85">
          <span class="h-1.5 w-1.5 shrink-0 animate-live-pulse rounded-full bg-live" aria-hidden="true"></span>
          {dict.hero.badge}
        </p>
        <p class="hidden font-mono text-white/55 lg:block">{dict.hero.note}</p>
      </div>
    </div>

    <header id="site-header" class="sticky top-0 z-50">
      <div class="relative z-10 border-b border-line bg-paper/92 backdrop-blur-md transition-shadow duration-300" id="header-bar">
        <div class="mx-auto flex h-14 max-w-6xl items-center gap-3 px-4 sm:px-6">
          <a href={pageUrl(locale, "/")} class="flex shrink-0 items-center gap-2 text-ink">
            <img src="/logo/kumbuild-logo.svg" alt="Kumbuild" width="32" height="32" class="h-8 w-8" />
            <span class="font-display text-[17px] font-bold">Kumbuild</span>
          </a>

          <nav class="ml-7 hidden items-center gap-5 whitespace-nowrap text-[14px] xl:flex min-[1440px]:gap-7 min-[1440px]:text-[15px]" aria-label="Main">
            <div class="relative" id="services-wrap">
              <button
                id="services-btn"
                type="button"
                aria-expanded="false"
                aria-haspopup="true"
                class={`flex items-center gap-1.5 whitespace-nowrap ${onServices ? "font-semibold text-ink underline decoration-primary-500 decoration-2 underline-offset-8" : "font-medium text-body transition-colors duration-200 hover:text-ink"}`}
              >
                {nav.services}
                <svg class="h-3.5 w-3.5 text-muted transition-transform duration-200" id="services-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
              </button>
              <div id="services-menu" class="invisible absolute left-0 top-full z-50 w-[26rem] pt-3">
                <div id="services-panel" class="translate-y-1.5 overflow-hidden rounded-2xl border border-line bg-white opacity-0 shadow-[0_16px_40px_rgba(28,25,23,0.12)] transition-[opacity,transform] duration-200">
                  {dict.services.items.map((s, si) => (
                    <a href={pageUrl(locale, `/services/${s.slug}`)} class="group flex items-start gap-3 px-5 py-3.5 transition-colors duration-200 first:pt-4 last:pb-4 hover:bg-paper">
                      <span class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-primary-50 text-primary-700 transition-colors duration-200 group-hover:bg-primary-100">
                        <Icon name={["globe", "rocket", "calendar-check", "book-open"][si] ?? "globe"} class="h-[18px] w-[18px]" />
                      </span>
                      <span>
                        <span class="block text-[15px] font-semibold text-ink">{s.title}</span>
                        <span class="mt-0.5 block text-[13px] leading-snug text-muted">{s.for}</span>
                      </span>
                    </a>
                  ))}
                  <a href={pageUrl(locale, "/services")} class="flex items-center justify-between border-t border-line bg-paper px-5 py-3 text-[13px] font-semibold text-primary-700 transition-colors duration-200 hover:bg-primary-50">
                    {v2.nav.allServices}
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
                  </a>
                </div>
              </div>
            </div>
            {links.map((l) => (
              <a href={l.href} aria-current={l.href === current ? "page" : undefined} class={desktopLink(l.href === current)}>{l.label}</a>
            ))}
          </nav>

          <div class="ml-auto flex items-center gap-2 sm:gap-3">
            <div class="relative hidden xl:block">
              <button
                id="locale-btn"
                type="button"
                class="flex items-center gap-1.5 rounded-lg border border-line bg-white px-2.5 py-1.5 text-[13px] font-semibold text-body transition-colors duration-200 hover:bg-surface"
                aria-expanded="false"
                aria-haspopup="true"
                aria-label="Change language"
              >
                <svg class="h-3.5 w-3.5 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" /><path d="M2 12h20" /></svg>
                {locales.find((l) => l.code === locale)?.label}
                <svg class="h-3 w-3 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
              </button>
              <div id="locale-menu" class="invisible absolute right-0 top-full z-50 mt-2 w-40 translate-y-1 overflow-hidden rounded-xl border border-line bg-white py-1 opacity-0 shadow-[0_12px_32px_rgba(28,25,23,0.12)] transition-[opacity,transform,visibility] duration-200">
                {locales.map((l) => (
                  <a
                    href={pageUrl(l.code, slug)}
                    class={l.code === locale
                      ? "block bg-primary-50 px-3 py-2 text-[15px] font-semibold text-primary-700"
                      : "block px-3 py-2 text-[15px] text-body transition-colors duration-200 hover:bg-surface hover:text-primary-700"}
                  >{l.label}</a>
                ))}
              </div>
            </div>
            <a href="https://auth.kumbuild.com/login" class="hidden text-[15px] font-medium text-body transition-colors duration-200 hover:text-ink xl:block">{nav.login}</a>
            <a href={pageUrl(locale, "/order")} class="inline-flex items-center gap-1.5 whitespace-nowrap rounded-xl bg-primary-600 px-4 py-2.5 text-[15px] font-semibold text-white transition-[background-color,transform] duration-200 hover:bg-primary-700 active:scale-[0.98]">
              {nav.order}
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
            </a>
            <button
              id="menu-btn"
              type="button"
              class="rounded-lg border border-line bg-white p-2.5 text-ink transition-colors duration-200 hover:bg-surface xl:hidden"
              aria-expanded="false"
              aria-controls="mobile-menu"
              aria-label="Menu"
            >
              <svg id="icon-open" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
              <svg id="icon-close" class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
            </button>
          </div>
        </div>
      </div>

      <div id="mobile-menu" data-lenis-prevent class="invisible fixed inset-0 z-0 translate-y-2 overflow-y-auto bg-paper opacity-0 transition-[opacity,transform,visibility] duration-200 xl:hidden">
        <div class="flex min-h-full flex-col px-5 pb-8 pt-[68px] sm:px-8">
          <nav class="flex flex-col" aria-label="Mobile">
            <a href={pageUrl(locale, "/services")} class={mobileLink(onServices)}>
              <span class="flex items-baseline gap-3.5">
                <span class="font-mono text-xs font-normal text-muted">01</span>
                {nav.services}
              </span>
              <svg class="h-5 w-5 shrink-0 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
            </a>
            {links.map((l, i) => (
              <a href={l.href} aria-current={l.href === current ? "page" : undefined} class={mobileLink(l.href === current)}>
                <span class="flex items-baseline gap-3.5">
                  <span class="font-mono text-xs font-normal text-muted">{String(i + 2).padStart(2, "0")}</span>
                  {l.label}
                </span>
                <svg class={`h-5 w-5 shrink-0 ${l.href === current ? "text-primary-500" : "text-muted"}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
              </a>
            ))}
          </nav>
          <a href={pageUrl(locale, "/order")} class="mt-8 flex items-center justify-center gap-2 rounded-xl bg-primary-600 px-4 py-4 text-base font-semibold text-white transition-colors duration-200 hover:bg-primary-700">
            {nav.order}
            <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </a>
          <a href={waLink} target="_blank" rel="noopener" class="mt-3 flex items-center justify-center gap-2 rounded-xl border border-line bg-white px-4 py-4 text-base font-semibold text-ink transition-colors duration-200 hover:bg-surface">
            {dict.contact.whatsapp}
          </a>
          <a href="https://auth.kumbuild.com/login" class="mt-4 text-center text-base font-medium text-body">{nav.login}</a>
          <div class="mt-auto pt-12">
            <div class="flex items-center gap-2">
              {locales.map((l) => (
                <a
                  href={pageUrl(l.code, slug)}
                  class={l.code === locale
                    ? "rounded-full bg-primary-50 px-3.5 py-2.5 text-[13px] font-semibold text-primary-700 ring-1 ring-primary-500"
                    : "rounded-full px-3.5 py-2.5 text-[13px] font-semibold text-muted ring-1 ring-line"}
                >{l.label}</a>
              ))}
            </div>
            <p class="mt-5 text-[13px] text-muted">{dict.footer.tagline} · {dict.hero.note}</p>
          </div>
        </div>
      </div>
    </header>

    <script>
      const btn = document.getElementById("menu-btn");
      const menu = document.getElementById("mobile-menu");
      const iconOpen = document.getElementById("icon-open");
      const iconClose = document.getElementById("icon-close");
      function setOpen(open) {
        menu.classList.toggle("invisible", !open);
        menu.classList.toggle("opacity-0", !open);
        menu.classList.toggle("translate-y-2", !open);
        iconOpen.classList.toggle("hidden", open);
        iconClose.classList.toggle("hidden", !open);
        btn.setAttribute("aria-expanded", String(open));
        document.body.style.overflow = open ? "hidden" : "";
        /* Lenis keeps its own scroll position — body overflow alone does not
           stop it, and the page jumps when the menu closes. Stop it for real. */
        const lenis = window.__lenis;
        if (lenis) open ? lenis.stop() : lenis.start();
      }
      btn.addEventListener("click", () => setOpen(menu.classList.contains("invisible")));
      menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));

      const localeBtn = document.getElementById("locale-btn");
      const localeMenu = document.getElementById("locale-menu");
      function setLocaleOpen(open) {
        if (!localeMenu) return;
        localeMenu.classList.toggle("invisible", !open);
        localeMenu.classList.toggle("opacity-0", !open);
        localeMenu.classList.toggle("translate-y-1", !open);
        localeBtn.setAttribute("aria-expanded", String(open));
      }
      if (localeBtn) {
        localeBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          setLocaleOpen(localeMenu.classList.contains("invisible"));
        });
        document.addEventListener("click", (e) => {
          if (!localeMenu.classList.contains("invisible") && !localeMenu.contains(e.target)) {
            setLocaleOpen(false);
          }
        });
      }

      /* Services dropdown — opens on hover (desktop) and click, closes on
         Escape or outside click. */
      const sWrap = document.getElementById("services-wrap");
      const sBtn = document.getElementById("services-btn");
      const sMenu = document.getElementById("services-menu");
      const sChevron = document.getElementById("services-chevron");
      let sPinned = false;
      const sPanel = document.getElementById("services-panel");
      function setServices(open) {
        sMenu.classList.toggle("invisible", !open);
        sPanel.classList.toggle("opacity-0", !open);
        sPanel.classList.toggle("translate-y-1.5", !open);
        sChevron.style.transform = open ? "rotate(180deg)" : "";
        sBtn.setAttribute("aria-expanded", String(open));
        if (!open) sPinned = false;
      }
      if (sWrap) {
        sWrap.addEventListener("mouseenter", () => setServices(true));
        sWrap.addEventListener("mouseleave", () => { if (!sPinned) setServices(false); });
        sBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          sPinned = sMenu.classList.contains("invisible");
          setServices(sPinned);
        });
        document.addEventListener("click", (e) => {
          if (!sMenu.classList.contains("invisible") && !sWrap.contains(e.target)) setServices(false);
        });
      }

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          setOpen(false);
          setLocaleOpen(false);
          setServices(false);
        }
      });

      /* Header gains depth once the page is scrolled. */
      const headerBar = document.getElementById("header-bar");
      const onScrollHeader = () => {
        const sc = window.scrollY > 8;
        headerBar.style.boxShadow = sc ? "0 8px 24px rgba(28,25,23,0.07)" : "none";
        headerBar.style.borderColor = sc ? "#ddd6c9" : "";
      };
      window.addEventListener("scroll", onScrollHeader, { passive: true });
      onScrollHeader();

      /* Scroll reveal — one observer for every [data-reveal] element. */
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((en) => {
            if (en.isIntersecting) {
              en.target.classList.add("is-in");
              io.unobserve(en.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
      );
      document.querySelectorAll("[data-reveal]").forEach((el) => io.observe(el));

      /* Back to top. */
      const toTop = document.getElementById("to-top");
      window.addEventListener("scroll", () => {
        const show = window.scrollY > 700;
        toTop.classList.toggle("opacity-0", !show);
        toTop.classList.toggle("invisible", !show);
        toTop.classList.toggle("pointer-events-none", !show);
        toTop.style.transform = show ? "translateY(0)" : "translateY(8px)";
      }, { passive: true });
      toTop.addEventListener("click", () => {
        /* Native smooth scroll fights Lenis's raf loop — ride Lenis when on. */
        if (window.__lenis) window.__lenis.scrollTo(0);
        else window.scrollTo({ top: 0, behavior: "smooth" });
      });
    </script>

    <main>
      <slot />
    </main>

    <footer class="mt-20 border-t border-line bg-surface">
      <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:grid-cols-2 sm:px-6 lg:grid-cols-[1.4fr_1fr_1fr_1.2fr]">
        <div>
          <div class="flex items-center gap-2 font-display font-semibold text-ink">
            <img src="/logo/kumbuild-logo.svg" alt="Kumbuild" width="28" height="28" />
            <span>Kumbuild</span>
          </div>
          <p class="mt-3 max-w-xs text-[15px] leading-relaxed text-muted">{v2.footer.about}</p>
          <div class="mt-5 flex gap-2.5">
            {[
              { label: "Instagram", href: "https://instagram.com", path: '<rect width="20" height="20" x="2" y="2" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><path d="M17.5 6.5h.01"/>' },
              { label: "Facebook", href: "https://facebook.com", path: '<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>' },
              { label: "YouTube", href: "https://youtube.com", path: '<path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/><path d="m10 15 5-3-5-3z"/>' },
              { label: "LinkedIn", href: "https://linkedin.com", path: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4V8h4"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>' },
            ].map((s) => (
              <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} class="flex h-10 w-10 items-center justify-center rounded-full border border-line bg-white text-muted transition-[color,border-color,transform] duration-200 hover:-translate-y-0.5 hover:border-primary-300 hover:text-primary-700">
                <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={s.path} />
              </a>
            ))}
          </div>
          <p class="mt-4 text-xs text-muted">{dict.footer.draftNote}</p>
        </div>
        <div>
          <p class="font-display text-[15px] font-semibold text-ink">{dict.footer.services}</p>
          <ul class="mt-3 space-y-2 text-[15px] text-muted">
            {dict.services.items.map((s) => (
              <li><a href={pageUrl(locale, `/services/${s.slug}`)} class="transition-colors duration-200 hover:text-primary-700">{s.title}</a></li>
            ))}
            <li><a href={pageUrl(locale, "/pricing")} class="transition-colors duration-200 hover:text-primary-700">{nav.pricing}</a></li>
          </ul>
        </div>
        <div>
          <p class="font-display text-[15px] font-semibold text-ink">{dict.footer.company}</p>
          <ul class="mt-3 space-y-2 text-[15px] text-muted">
            <li><a href={pageUrl(locale, "/about")} class="transition-colors duration-200 hover:text-primary-700">{dict.about.title}</a></li>
            <li><a href={pageUrl(locale, "/examples")} class="transition-colors duration-200 hover:text-primary-700">{v2.nav.work}</a></li>
            <li><a href={pageUrl(locale, "/blog")} class="transition-colors duration-200 hover:text-primary-700">{v2.nav.blog}</a></li>
            <li><a href={pageUrl(locale, "/how-it-works")} class="transition-colors duration-200 hover:text-primary-700">{nav.howItWorks}</a></li>
            <li><a href={pageUrl(locale, "/faq")} class="transition-colors duration-200 hover:text-primary-700">{nav.faq}</a></li>
            <li><a href={pageUrl(locale, "/contact")} class="transition-colors duration-200 hover:text-primary-700">{nav.contact}</a></li>
          </ul>
        </div>
        <div>
          <p class="font-display text-[15px] font-semibold text-ink">{v2.footer.start}</p>
          <p class="mt-3 text-[15px] leading-relaxed text-muted">{v2.footer.startText}</p>
          <div class="mt-4 flex flex-wrap gap-2">
            <a href={pageUrl(locale, "/order")} class="inline-flex items-center gap-1.5 rounded-xl bg-primary-600 px-4 py-2.5 text-[15px] font-semibold text-white transition-[background-color,transform] duration-200 hover:bg-primary-700 active:scale-[0.98]">
              {nav.order}
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
            </a>
            <a href={waLink} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 rounded-xl border border-line bg-white px-4 py-2 text-[15px] font-semibold text-ink transition-colors duration-200 hover:bg-paper">{dict.contact.whatsapp}</a>
          </div>
          <p class="mt-4 font-mono text-xs text-muted">{dict.hero.note}</p>
        </div>
      </div>
      <div class="border-t border-line">
        <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 pb-24 pt-4 text-xs text-muted sm:px-6 md:pb-20">
          <p>© 2026 Kumbuild · {dict.footer.rights}</p>
          <p class="flex gap-4">
            <a href={pageUrl(locale, "/privacy")} class="transition-colors duration-200 hover:text-primary-700">{dict.privacy.title}</a>
            <a href={pageUrl(locale, "/terms")} class="transition-colors duration-200 hover:text-primary-700">{dict.terms.title}</a>
            <a href={pageUrl(locale, "/refund")} class="transition-colors duration-200 hover:text-primary-700">{v2.nav.refund}</a>
          </p>
