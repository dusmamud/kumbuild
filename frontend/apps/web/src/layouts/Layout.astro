---
import "../styles/theme.css";
import Icon from "../components/Icon.astro";
import { pageUrl, type Dictionary, type Locale } from "../i18n/utils";

interface Props {
  title: string;
  description: string;
  locale: Locale;
  dict: Dictionary;
  /** page slug without locale prefix, e.g. "/pricing" or "/" */
  slug: string;
  /** Background of the section at the top of the page — the header bar
      matches it at rest, so there is no colour step. "surface" for pages
      whose first section is bg-surface (home hero, about intro); "paper"
      everywhere else (default). On scroll the header always becomes
      bg-paper/92 + blur + divider + shadow. */
  headerTopBg?: "paper" | "surface";
}

const { title, description, locale, dict, slug, headerTopBg = "paper" } = Astro.props;
const nav = dict.nav;
const v2 = dict.v2;
const current = pageUrl(locale, slug);
const onServices = slug.startsWith("/services");
const links = [
  { href: pageUrl(locale, "/pricing"), label: nav.pricing },
  { href: pageUrl(locale, "/how-it-works"), label: nav.howItWorks },
  { href: pageUrl(locale, "/examples"), label: v2.nav.work },
  { href: pageUrl(locale, "/about"), label: nav.about },
  { href: pageUrl(locale, "/faq"), label: nav.faq },
  { href: pageUrl(locale, "/contact"), label: nav.contact },
];
const locales: { code: Locale; label: string }[] = [
  { code: "en-US", label: "English" },
  { code: "hi", label: "हिन्दी" },
  { code: "bn", label: "বাংলা" },
  { code: "as", label: "অসমীয়া" },
];
const desktopLink = (active: boolean) =>
  active
    ? "font-semibold text-ink underline decoration-primary-500 decoration-2 underline-offset-8"
    : "font-medium text-body transition-colors duration-200 hover:text-ink";
const mobileLink = (active: boolean) =>
  active
    ? "flex items-center justify-between gap-4 border-b border-line py-4 font-display text-[20px] font-semibold leading-tight text-primary-700"
    : "flex items-center justify-between gap-4 border-b border-line py-4 font-display text-[20px] font-semibold leading-tight text-ink";
const waLink = `https://wa.me/${v2.contact.waNumber}?text=${encodeURIComponent(v2.contact.waText)}`;
/* Footer/top-strip note ("Starting at ₹3,999 · Delivery in …") is split on
   its separators so each fact stays on one line — the strip may wrap
   between facts, never in the middle of one. */
const noteParts = dict.hero.note.split(" · ");
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Proves JS runs: theme.css only hides [data-reveal] under html.js,
         so with JS disabled (or blocked) every section stays visible. -->
    <script>document.documentElement.classList.add("js");</script>
    <noscript><style>[data-reveal]{opacity:1 !important;transform:none !important;}</style></noscript>
    <title>{title} — Kumbuild</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf9f6" />
    <meta property="og:title" content={`${title} — Kumbuild`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/og/kumbuild-og.png" />
    <link rel="icon" type="image/svg+xml" href="/logo/kumbuild-logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Sora:wght@600;700&family=Noto+Sans+Devanagari:wght@400;500;600;700&family=Noto+Sans+Bengali:wght@400;500;600;700&display=swap"
    />
  </head>
  <body class="min-h-screen bg-paper text-body">
    <div class="hidden bg-ink text-white md:block">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-4 py-1.5 text-xs sm:px-6">
        <p class="flex items-center gap-2 text-white/85">
          <span class="h-1.5 w-1.5 shrink-0 animate-live-pulse rounded-full bg-live" aria-hidden="true"></span>
          {dict.hero.badge}
        </p>
        <p class="hidden font-mono text-white/55 lg:block">{noteParts.map((seg, i) => (<><span class="whitespace-nowrap">{seg}</span>{i < noteParts.length - 1 ? " · " : ""}</>))}</p>
      </div>
    </div>

    <header id="site-header" class="sticky top-0 z-50">
      <div class={`relative z-10 border-b border-transparent ${headerTopBg === "surface" ? "bg-surface" : "bg-paper"} transition-[box-shadow,border-color,background-color] duration-300`} id="header-bar" data-rest-bg={headerTopBg === "surface" ? "bg-surface" : "bg-paper"}>
        <div class="mx-auto flex h-14 max-w-6xl items-center gap-3 px-4 sm:px-6">
          <a href={pageUrl(locale, "/")} class="flex shrink-0 items-center gap-2 text-ink">
            <img src="/logo/kumbuild-logo.svg" alt="Kumbuild" width="32" height="32" class="h-8 w-8" />
            {/* Wordmark hidden below 360px: at 320 the header row (logo +
                "Order now" + hamburger) needs ~306px but only 288px are
                available, so the right div spilled 2px past the viewport.
                Logo mark alone below 360 — same pattern as the account /
                home headers, which hide the wordmark below sm. */}
            <span class="font-display text-[17px] font-bold max-[359px]:hidden">Kumbuild</span>
          </a>

          <nav class="ml-7 hidden items-center gap-4 whitespace-nowrap text-[14px] xl:flex" aria-label="Main">
            <div class="relative" id="services-wrap">
              <button
                id="services-btn"
                type="button"
                aria-expanded="false"
                aria-haspopup="true"
                class={`flex items-center gap-1.5 whitespace-nowrap ${onServices ? "font-semibold text-ink underline decoration-primary-500 decoration-2 underline-offset-8" : "font-medium text-body transition-colors duration-200 hover:text-ink"}`}
              >
                {nav.services}
                <svg class="h-3.5 w-3.5 text-muted transition-transform duration-200" id="services-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
              </button>
              <div id="services-menu" class="invisible absolute left-0 top-full z-50 w-[26rem] pt-3">
                <div id="services-panel" class="translate-y-1.5 overflow-hidden rounded-2xl border border-line bg-white opacity-0 shadow-[0_16px_40px_rgba(28,25,23,0.12)] transition-[opacity,transform] duration-200">
                  {dict.services.items.map((s, si) => (
                    <a href={pageUrl(locale, `/services/${s.slug}`)} class="group flex items-start gap-3 px-5 py-3.5 transition-colors duration-200 first:pt-4 last:pb-4 hover:bg-paper">
                      <span class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-primary-50 text-primary-700 transition-colors duration-200 group-hover:bg-primary-100">
                        <Icon name={["globe", "rocket", "calendar-check", "book-open"][si] ?? "globe"} class="h-[18px] w-[18px]" />
                      </span>
                      <span>
                        <span class="block text-[15px] font-semibold text-ink">{s.title}</span>
                        <span class="mt-0.5 block text-[13px] leading-snug text-muted">{s.for}</span>
                      </span>
                    </a>
                  ))}
                  <a href={pageUrl(locale, "/services")} class="flex items-center justify-between border-t border-line bg-paper px-5 py-3 text-[13px] font-semibold text-primary-700 transition-colors duration-200 hover:bg-primary-50">
                    {v2.nav.allServices}
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
                  </a>
                </div>
              </div>
            </div>
            {links.map((l) => (
              <a href={l.href} aria-current={l.href === current ? "page" : undefined} class={desktopLink(l.href === current)}>{l.label}</a>
            ))}
          </nav>

          <div class="ml-auto flex items-center gap-2 sm:gap-3">
            <div class="relative hidden xl:block">
              <button
                id="locale-btn"
                type="button"
                class="flex items-center gap-1.5 rounded-lg border border-line bg-white px-2.5 py-1.5 text-[13px] font-semibold text-body transition-colors duration-200 hover:bg-surface"
                aria-expanded="false"
                aria-haspopup="true"
                aria-label="Change language"
              >
                <svg class="h-3.5 w-3.5 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" /><path d="M2 12h20" /></svg>
                {locales.find((l) => l.code === locale)?.label}
                <svg class="h-3 w-3 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
              </button>
              <div id="locale-menu" class="invisible absolute right-0 top-full z-50 mt-2 w-40 translate-y-1 overflow-hidden rounded-xl border border-line bg-white py-1 opacity-0 shadow-[0_12px_32px_rgba(28,25,23,0.12)] transition-[opacity,transform,visibility] duration-200">
                {locales.map((l) => (
                  <a
                    href={pageUrl(l.code, slug)}
                    class={l.code === locale
                      ? "block bg-primary-50 px-3 py-2 text-[15px] font-semibold text-primary-700"
                      : "block px-3 py-2 text-[15px] text-body transition-colors duration-200 hover:bg-surface hover:text-primary-700"}
                  >{l.label}</a>
                ))}
              </div>
            </div>
            <a href="https://account.kumbuild.com/login" class="hidden text-[15px] font-medium text-body transition-colors duration-200 hover:text-ink xl:block">{nav.login}</a>
            <a href={pageUrl(locale, "/order")} class="inline-flex items-center gap-1.5 whitespace-nowrap rounded-xl bg-cta px-4 py-3 text-[15px] font-semibold text-white transition-[background-color,transform] duration-200 hover:bg-cta-hover active:scale-[0.98]">
              {nav.order}
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
            </a>
            <button
              id="menu-btn"
              type="button"
              class="rounded-lg border border-line bg-white p-3 text-ink transition-colors duration-200 hover:bg-surface xl:hidden"
              aria-expanded="false"
              aria-controls="mobile-menu"
              aria-label="Menu"
            >
              <svg id="icon-open" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
              <svg id="icon-close" class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
            </button>
          </div>
        </div>
      </div>

      <div id="mobile-menu" data-lenis-prevent class="invisible fixed inset-0 z-0 translate-y-2 overflow-y-auto bg-paper opacity-0 transition-[opacity,transform,visibility] duration-200 motion-reduce:transition-none xl:hidden">
        <div class="flex min-h-full flex-col px-5 pb-8 pt-[68px] sm:px-8">
          <nav class="flex flex-col" aria-label="Mobile">
            {/* Services is an accordion button, not a link: tapping it expands
                the four service pages with a smooth grid-rows animation
                (300ms, same pattern as the FAQ accordion). The landing page
                stays one tap away via "See all services" inside the panel.
                Below xl the desktop dropdown never renders, so without this
                panel the four service pages were unreachable at 768–1279. */}
            <button
              type="button"
              id="mobile-services-btn"
              class={mobileLink(onServices) + " w-full text-left"}
              aria-expanded="false"
              aria-controls="mobile-services-sub"
            >
              <span>{nav.services}</span>
              <svg id="mobile-services-chevron" class="h-5 w-5 shrink-0 text-muted transition-transform duration-300 motion-reduce:transition-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
            </button>
            <div id="mobile-services-sub" class="grid transition-[grid-template-rows] duration-300 ease-out [grid-template-rows:0fr] motion-reduce:transition-none" inert>
              <div class="overflow-hidden">
                <div class="border-b border-line py-1.5">
                  <a href={pageUrl(locale, "/services")} class="group flex items-center gap-3 py-3 pr-1 text-[16px] font-semibold text-ink transition-colors duration-200 hover:text-primary-700">
                    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-primary-50 text-primary-700 transition-colors duration-200 group-hover:bg-primary-100">
                      <Icon name="layers" class="h-[18px] w-[18px]" />
                    </span>
                    <span class="flex-1">{v2.nav.allServices}</span>
                    <svg class="h-4 w-4 shrink-0 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
                  </a>
                  {dict.services.items.map((s, si) => (
                    <a href={pageUrl(locale, `/services/${s.slug}`)} class="group flex items-center gap-3 py-3 pr-1 text-[16px] font-medium text-body transition-colors duration-200 hover:text-primary-700">
                      <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-primary-50 text-primary-700 transition-colors duration-200 group-hover:bg-primary-100">
                        <Icon name={["globe", "rocket", "calendar-check", "book-open"][si] ?? "globe"} class="h-[18px] w-[18px]" />
                      </span>
                      <span class="flex-1">{s.title}</span>
                      <svg class="h-4 w-4 shrink-0 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
                    </a>
                  ))}
                </div>
              </div>
            </div>
            {links.map((l) => (
              <a href={l.href} aria-current={l.href === current ? "page" : undefined} class={mobileLink(l.href === current)}>
                <span>{l.label}</span>
                <svg class={`h-5 w-5 shrink-0 ${l.href === current ? "text-primary-500" : "text-muted"}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
              </a>
            ))}
          </nav>
          <a href={pageUrl(locale, "/order")} class="mt-8 flex items-center justify-center gap-2 rounded-xl bg-cta px-4 py-4 text-base font-semibold text-white transition-colors duration-200 hover:bg-cta-hover">
            {nav.order}
            <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </a>
          <a href={waLink} target="_blank" rel="noopener" class="mt-3 flex items-center justify-center gap-2 rounded-xl border border-line bg-white px-4 py-4 text-base font-semibold text-ink transition-colors duration-200 hover:bg-surface">
            {dict.contact.whatsapp}
          </a>
          <a href="https://account.kumbuild.com/login" class="mt-4 text-center text-base font-medium text-body">{nav.login}</a>
          <div class="mt-auto pt-12">
            <div class="flex items-center gap-2">
              {locales.map((l) => (
                <a
                  href={pageUrl(l.code, slug)}
                  class={l.code === locale
                    ? "rounded-full bg-primary-50 px-3.5 py-2.5 text-[13px] font-semibold text-primary-700 ring-1 ring-primary-500"
                    : "rounded-full px-3.5 py-2.5 text-[13px] font-semibold text-muted ring-1 ring-line"}
                >{l.label}</a>
              ))}
            </div>
            <p class="mt-5 text-[13px] text-muted">{dict.footer.tagline} · {noteParts.map((seg, i) => (<><span class="whitespace-nowrap">{seg}</span>{i < noteParts.length - 1 ? " · " : ""}</>))}</p>
          </div>
        </div>
      </div>
    </header>

    <script>
      const btn = document.getElementById("menu-btn");
      const menu = document.getElementById("mobile-menu");
      const iconOpen = document.getElementById("icon-open");
      const iconClose = document.getElementById("icon-close");
      function setOpen(open) {
        menu.classList.toggle("invisible", !open);
        menu.classList.toggle("opacity-0", !open);
        menu.classList.toggle("translate-y-2", !open);
        iconOpen.classList.toggle("hidden", open);
        iconClose.classList.toggle("hidden", !open);
        btn.setAttribute("aria-expanded", String(open));
        document.body.style.overflow = open ? "hidden" : "";
        /* Accordion resets when the menu closes, so the next open starts
           clean with Services collapsed. */
        if (!open) setMobileServices(false);
        /* The menu overlay is bg-paper — force the header to paper while it
           is open, so a surface-top page (home, about) doesn't show a band
           over the menu. On close, restore the scroll-appropriate state. */
        if (open) {
          headerBar.classList.remove(restBg, "bg-paper/92");
          headerBar.classList.add("bg-paper");
        } else {
          onScrollHeader();
        }
        /* Lenis keeps its own scroll position — body overflow alone does not
           stop it, and the page jumps when the menu closes. Stop it for real. */
        const lenis = window.__lenis;
        if (lenis) open ? lenis.stop() : lenis.start();
      }
      btn.addEventListener("click", () => setOpen(menu.classList.contains("invisible")));
      menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));

      /* Services accordion — button + grid-rows animation (300ms). While
         collapsed the panel is inert, so its links leave the tab order and
         screen readers skip them. */
      const mServicesBtn = document.getElementById("mobile-services-btn");
      const mServicesSub = document.getElementById("mobile-services-sub");
      const mServicesChevron = document.getElementById("mobile-services-chevron");
      function setMobileServices(open) {
        mServicesSub.classList.toggle("[grid-template-rows:0fr]", !open);
        mServicesSub.classList.toggle("[grid-template-rows:1fr]", open);
        mServicesSub.inert = !open;
        mServicesChevron.classList.toggle("rotate-180", open);
        mServicesBtn.setAttribute("aria-expanded", String(open));
      }
      mServicesBtn.addEventListener("click", () =>
        setMobileServices(mServicesBtn.getAttribute("aria-expanded") !== "true")
      );

      /* Focus trap: while the menu is open, Tab cycles through the menu's
         own links and buttons only. Escape exits and returns focus to the
         hamburger button (see the keydown handler below). */
      menu.addEventListener("keydown", (e) => {
        if (e.key !== "Tab") return;
        const items = [...menu.querySelectorAll("a[href], button:not([disabled])")].filter(
          (el) => !el.closest("[inert]")
        );
        if (!items.length) return;
        const first = items[0];
        const last = items[items.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      });

      const localeBtn = document.getElementById("locale-btn");
      const localeMenu = document.getElementById("locale-menu");
      function setLocaleOpen(open) {
        if (!localeMenu) return;
        localeMenu.classList.toggle("invisible", !open);
        localeMenu.classList.toggle("opacity-0", !open);
        localeMenu.classList.toggle("translate-y-1", !open);
        localeBtn.setAttribute("aria-expanded", String(open));
      }
      if (localeBtn) {
        localeBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          setLocaleOpen(localeMenu.classList.contains("invisible"));
        });
        document.addEventListener("click", (e) => {
          if (!localeMenu.classList.contains("invisible") && !localeMenu.contains(e.target)) {
            setLocaleOpen(false);
          }
        });
      }

      /* Services dropdown — opens on hover (desktop) and click, closes on
         Escape or outside click. */
      const sWrap = document.getElementById("services-wrap");
      const sBtn = document.getElementById("services-btn");
      const sMenu = document.getElementById("services-menu");
      const sChevron = document.getElementById("services-chevron");
      let sPinned = false;
      const sPanel = document.getElementById("services-panel");
      function setServices(open) {
        sMenu.classList.toggle("invisible", !open);
        sPanel.classList.toggle("opacity-0", !open);
        sPanel.classList.toggle("translate-y-1.5", !open);
        sChevron.style.transform = open ? "rotate(180deg)" : "";
        sBtn.setAttribute("aria-expanded", String(open));
        if (!open) sPinned = false;
      }
      if (sWrap) {
        sWrap.addEventListener("mouseenter", () => setServices(true));
        sWrap.addEventListener("mouseleave", () => { if (!sPinned) setServices(false); });
        sBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          sPinned = sMenu.classList.contains("invisible");
          setServices(sPinned);
        });
        document.addEventListener("click", (e) => {
          if (!sMenu.classList.contains("invisible") && !sWrap.contains(e.target)) setServices(false);
        });
      }

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          const menuWasOpen = !menu.classList.contains("invisible");
          setOpen(false);
          setLocaleOpen(false);
          setServices(false);
          /* Focus returns to the trigger that opened the menu. */
          if (menuWasOpen) btn.focus();
        }
      });

      /* Header gains depth once the page is scrolled. */
      const headerBar = document.getElementById("header-bar");
      const restBg = headerBar.dataset.restBg || "bg-paper";
      const onScrollHeader = () => {
        const sc = window.scrollY > 8;
        /* At rest the bar matches the section at the top of the page
           (data-rest-bg: bg-surface on home/about, bg-paper elsewhere).
           Once scrolled it gains its paper fill + blur + divider + shadow. */
        headerBar.classList.toggle(restBg, !sc);
        headerBar.classList.toggle("bg-paper/92", sc);
        headerBar.classList.toggle("backdrop-blur-md", sc);
        headerBar.style.boxShadow = sc ? "0 8px 24px rgba(28,25,23,0.07)" : "none";
        headerBar.style.borderColor = sc ? "#ddd6c9" : "";
      };
      window.addEventListener("scroll", onScrollHeader, { passive: true });
      onScrollHeader();

      /* Scroll reveal — one observer for every [data-reveal] element. */
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((en) => {
            if (en.isIntersecting) {
              en.target.classList.add("is-in");
              io.unobserve(en.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
      );
      document.querySelectorAll("[data-reveal]").forEach((el) => io.observe(el));

      /* Floating actions — back to top + WhatsApp. Both hide while the
         footer is in view (so they never cover footer links) and while
         scrolling down (so they never cover the content being read);
         they return on scroll-up. Thresholds unchanged: FAB past 500px,
         back-to-top past 700px. */
      const toTop = document.getElementById("to-top");
      const waFab = document.getElementById("wa-fab");
      let lastFabY = window.scrollY;
      let footerVisible = false;
      function setFabVisible(el, show) {
        el.classList.toggle("opacity-0", !show);
        el.classList.toggle("invisible", !show);
        el.classList.toggle("pointer-events-none", !show);
        el.style.transform = show ? "translateY(0)" : "translateY(8px)";
      }
      function onScrollFabs() {
        const y = window.scrollY;
        const scrollingUp = y < lastFabY;
        lastFabY = y;
        setFabVisible(toTop, y > 700 && !footerVisible && scrollingUp);
        setFabVisible(waFab, y > 500 && !footerVisible && scrollingUp);
      }
      const footerEl = document.querySelector("footer");
      if (footerEl) {
        new IntersectionObserver((entries) => {
          footerVisible = entries[0].isIntersecting;
          onScrollFabs();
        }).observe(footerEl);
      }
      window.addEventListener("scroll", onScrollFabs, { passive: true });
      onScrollFabs();
      toTop.addEventListener("click", () => {
        /* Native smooth scroll fights Lenis's raf loop — ride Lenis when on. */
        if (window.__lenis) window.__lenis.scrollTo(0);
        else window.scrollTo({ top: 0, behavior: "smooth" });
      });
