---
import ServiceDetailPage from "../../components/pages/ServiceDetailPage.astro";
import { dictFor } from "../../i18n/utils";
export function getStaticPaths() {
  return dictFor("en-US").services.items.map((item) => ({ params: { slug: item.slug } }));
}
const dict = dictFor("en-US");
const slug = Astro.params.slug ?? "";
---
<ServiceDetailPage dict={dict} locale={"en-US"} slug={slug} />
