---
import BlogPostPage from "../../../components/pages/BlogPostPage.astro";
import { dictFor } from "../../../i18n/utils";
export function getStaticPaths() {
  return dictFor("bn").v2.blog.posts.map((post) => ({ params: { slug: post.slug } }));
}
const { slug } = Astro.params;
const dict = dictFor("bn");
---
<BlogPostPage dict={dict} locale="bn" slug={slug ?? ""} />
