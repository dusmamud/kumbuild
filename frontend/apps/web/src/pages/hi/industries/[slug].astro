---
import IndustryDetailPage from "../../../components/pages/IndustryDetailPage.astro";
import { dictFor } from "../../../i18n/utils";
export function getStaticPaths() {
  return dictFor("hi").industries.items.map((item) => ({ params: { slug: item.slug } }));
}
const dict = dictFor("hi");
const slug = Astro.params.slug ?? "";
---
<IndustryDetailPage dict={dict} locale={"hi"} slug={slug} />
