---
import SectionHead from "./SectionHead.astro";
import Icon from "./Icon.astro";
import type { Dictionary } from "../i18n/utils";
interface Props { dict: Dictionary; no?: string; }
const { dict, no } = Astro.props;
const home = dict.home;
/* One icon per included item, matched to the dictionary order (all locales):
   mobile-first, WhatsApp, Maps, form, domain, SSL, SEO, preview. */
const icons = ["smartphone", "message-circle", "map-pin", "send", "globe", "lock", "search", "eye"];
---

<section class="mx-auto max-w-6xl px-4 py-16 sm:py-24">
  <div class="grid gap-10 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <SectionHead no={no} title={home.includedTitle} subtitle={home.includedSubtitle} />
      <ul class="mt-10 grid gap-x-8 sm:grid-cols-2">
        {home.included.map((item, i) => (
          <li class="flex items-start gap-3.5 border-t border-line py-4">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-primary-50 text-primary-700">
              <Icon name={icons[i] ?? "check"} class="h-5 w-5" />
            </span>
            <span class="pt-1.5 text-base leading-[28px] text-body">{item}</span>
          </li>
        ))}
      </ul>
    </div>
    <aside class="h-fit rounded-2xl border border-line bg-surface p-6 sm:p-7 lg:col-span-5">
      <h3 class="text-[clamp(1rem,0.94rem+0.35vw,1.125rem)] font-semibold text-ink">{home.notTitle}</h3>
      <ul class="mt-4 space-y-4">
        {home.notItems.map((item) => (
          <li class="flex gap-3">
            <svg class="mt-0.5 h-5 w-5 shrink-0 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M5 5l14 14" /></svg>
            <span class="text-base leading-[25px] text-body sm:text-base sm:leading-[28px]">{item}</span>
          </li>
        ))}
      </ul>
      <p class="mt-5 border-t border-dashed border-line pt-4 text-sm leading-[22px] text-muted">{home.notNote}</p>
    </aside>
  </div>
</section>
