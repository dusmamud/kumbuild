---
import type { Dictionary } from "../i18n/utils";
interface Props { dict: Dictionary; }
const { dict } = Astro.props;
const stats = dict.v2.aboutV2.stats;
---

<section class="bg-paper">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <dl data-reveal class="grid grid-cols-2 overflow-hidden rounded-2xl border border-line bg-white lg:grid-cols-4">
      {stats.map((s, i) => (
        <div class={`px-6 py-7 sm:px-8 ${i > 0 ? "border-line max-lg:odd:border-l lg:border-l" : ""} ${i > 1 ? "max-lg:border-t" : ""}`}>
          <dd class="font-display text-[clamp(1.75rem,1.4rem+1.6vw,2.5rem)] font-semibold tabular-nums text-ink">{s.value}</dd>
          <dt class="mt-1.5 text-sm leading-[22px] text-muted">{s.label}</dt>
        </div>
      ))}
    </dl>
  </div>
</section>
