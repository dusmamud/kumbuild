---
import type { Dictionary } from "../i18n/utils";
interface Props { dict: Dictionary; }
const { dict } = Astro.props;
const stats = dict.v2.aboutV2.stats;
---

<section class="bg-paper pt-10 sm:pt-12">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <dl data-reveal class="grid grid-cols-2 overflow-hidden rounded-2xl border border-line bg-white lg:grid-cols-4">
      {stats.map((s, i) => (
        <div class={`flex flex-col px-6 py-7 sm:px-8 ${i % 2 === 1 ? "border-l border-line lg:border-l-0" : ""} ${i > 0 ? "lg:border-l lg:border-line" : ""} ${i > 1 ? "max-lg:border-t max-lg:border-line" : ""}`}>
          <dt class="order-2 mt-1.5 text-sm leading-[22px] text-muted">{s.label}</dt>
          <dd class="order-1 font-display text-[clamp(1.5rem,1.25rem+1.2vw,2.125rem)] font-semibold tabular-nums text-ink">{s.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
