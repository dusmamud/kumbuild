---
import type { Dictionary } from "../i18n/utils";
interface Props { dict: Dictionary; }
const { dict } = Astro.props;
const e = dict.examples;
---

<section class="mx-auto max-w-6xl px-4 py-12">
  <h2 class="text-2xl font-bold sm:text-3xl">{e.title}</h2>
  <p class="mt-2 max-w-2xl text-body">{e.subtitle}</p>
  <div class="mt-8 grid gap-4 sm:grid-cols-3">
    {e.items.map((item) => (
      <article class="rounded-xl border border-line bg-white p-5">
        <span class="inline-block rounded-full bg-primary-50 px-2.5 py-1 text-xs font-bold text-primary-700">{e.comingSoon}</span>
        <h3 class="mt-3 font-bold">{item.title}</h3>
        <p class="mt-1 text-sm leading-relaxed text-body">{item.desc}</p>
      </article>
    ))}
  </div>
</section>
