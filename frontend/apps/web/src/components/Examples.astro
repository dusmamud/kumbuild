---
import SectionHead from "./SectionHead.astro";
import SmartImage from "./SmartImage.astro";
import type { Dictionary } from "../i18n/utils";
interface Props { dict: Dictionary; no?: string; }
const { dict, no } = Astro.props;
const e = dict.examples;
/* Real demo sites — one per business type, with their live address in
   the browser bar. Thumbnails live in public/work/ (work-<slug>.webp). */
const demos = [
  { img: "/work/work-shopmate.webp", url: "shopmates.pages.dev", name: "ShopMate", type: "Online store", alt: "ShopMate online store — products, cart, checkout and order tracking" },
  { img: "/work/work-dental-clinic.webp", url: "navix-dental.pages.dev", name: "NaviX Dental", type: "Dental clinic", alt: "NaviX dental clinic — treatments, pricing and appointment booking" },
  { img: "/work/work-lumina-beauty-studio.webp", url: "lumina-beauty-studio.pages.dev", name: "Lumina Beauty Studio", type: "Beauty salon", alt: "Lumina Beauty Studio — services, pricing and booking" },
];
---

<section class="border-y border-line bg-surface">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:py-16">
    <SectionHead no={no} title={e.title} subtitle={e.subtitle} />
    <div class="mt-10 grid gap-5 sm:grid-cols-3">
      {demos.map((d) => (
        <figure class="overflow-hidden rounded-xl border border-line bg-white">
          <div class="flex items-center gap-2 border-b border-line bg-white px-3 py-2">
            <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-line"></span>
            <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-line"></span>
            <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-line"></span>
            <span class="ml-1 truncate rounded-md border border-line bg-surface px-2 py-0.5 font-mono text-xs text-muted">{d.url}</span>
          </div>
          <SmartImage src={d.img} alt={d.alt} width="1280" height="800" loading="lazy" class="block aspect-[8/5] w-full object-cover object-top" />
          <figcaption class="flex items-baseline justify-between gap-2 px-4 py-3">
            <span class="font-display text-base font-semibold text-ink sm:text-base">{d.name}</span>
            <span class="shrink-0 text-xs text-muted">{d.type}</span>
          </figcaption>
        </figure>
      ))}
    </div>
    <p class="mt-5 text-sm text-muted">{dict.home.examplesNote}</p>
  </div>
</section>
