---
import SectionHead from "./SectionHead.astro";
import type { Dictionary } from "../i18n/utils";
interface Props { dict: Dictionary; no?: string; }
const { dict, no } = Astro.props;
const home = dict.home;
---

<section class="border-y border-line bg-surface">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:py-16">
  <SectionHead no={no} title={home.whoTitle} subtitle={home.whoSubtitle} />
  <ul class="mt-10 border-b border-line">
    {home.audiences.map((a) => (
      <li class="grid items-baseline gap-2 border-t border-line py-5 sm:grid-cols-12 sm:gap-4">
        <p class="font-display text-[clamp(0.9375rem,0.9rem+0.35vw,1.125rem)] font-semibold text-ink sm:col-span-4">{a.name}</p>
        <p class="text-base leading-[28px] text-body sm:col-span-8">{a.need}</p>
      </li>
    ))}
  </ul>
  </div>
</section>
