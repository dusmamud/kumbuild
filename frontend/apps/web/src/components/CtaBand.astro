---
import { pageUrl, type Dictionary, type Locale } from "../i18n/utils";
interface Props { dict: Dictionary; locale: Locale; }
const { dict, locale } = Astro.props;
const c = dict.v2.homeV2;
---

<section class="mx-auto max-w-6xl px-4 pb-20">
  <div data-reveal class="grid items-center gap-8 rounded-2xl bg-ink px-6 py-10 sm:px-10 lg:grid-cols-[1fr_auto]">
    <div>
      <h2 class="font-display text-[clamp(1.5rem,1.2rem+1.5vw,1.875rem)] font-semibold leading-[1.25] text-white">{c.ctaTitle}</h2>
      <p class="mt-2 max-w-xl text-[15px] leading-[26px] text-white/70 sm:text-base">{c.ctaText}</p>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
      <a href={pageUrl(locale, "/order")} class="rounded-[10px] bg-primary-500 px-6 py-3.5 text-center text-[15px] font-semibold text-white transition hover:bg-primary-600 active:scale-[0.98]">{dict.nav.order}</a>
      <a href={pageUrl(locale, "/pricing")} class="rounded-[10px] border border-white/25 px-6 py-3.5 text-center text-[15px] font-semibold text-white transition hover:border-white/60 active:scale-[0.98]">{dict.nav.pricing}</a>
    </div>
  </div>
</section>
