---
import type { Dictionary } from "../i18n/utils";
interface Props { dict: Dictionary; }
const { dict } = Astro.props;
const m = dict.v2.marquee;
const items = [...m.items, ...m.items];
---

<section class="border-b border-line bg-paper" aria-label={m.label}>
  <div class="mx-auto max-w-6xl px-4 pt-8 sm:px-6">
    <p class="text-center font-mono text-xs text-muted">{m.label}</p>
  </div>
  <div class="marquee-track relative overflow-hidden py-6 [mask-image:linear-gradient(to_right,transparent,black_8%,black_92%,transparent)]">
    <div class="animate-marquee flex w-max items-center gap-10 pr-10" aria-hidden="true">
      {items.map((item) => (
        <span class="flex items-center gap-10 whitespace-nowrap font-display text-lg font-semibold text-ink/70">
          {item}
          <span class="h-1.5 w-1.5 rounded-full bg-primary-300" aria-hidden="true"></span>
        </span>
      ))}
    </div>
  </div>
  {/* The animated track is aria-hidden (it duplicates the items for the
      loop), so screen readers get this static list instead. */}
  <ul class="sr-only">
    {m.items.map((item) => (
      <li>{item}</li>
    ))}
  </ul>
</section>
