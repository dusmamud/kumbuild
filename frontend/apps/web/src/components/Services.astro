---
import type { Dictionary } from "../i18n/utils";
interface Props { dict: Dictionary; }
const { dict } = Astro.props;
const s = dict.services;
---

<section class="mx-auto max-w-6xl px-4 py-12">
  <h2 class="text-2xl font-extrabold sm:text-3xl">{s.title}</h2>
  <p class="mt-2 max-w-2xl text-slate-600">{s.subtitle}</p>
  <div class="mt-8 grid gap-4 sm:grid-cols-2">
    {s.items.map((item) => (
      <article class="rounded-xl border border-slate-200 bg-white p-5">
        <h3 class="text-lg font-bold">{item.title}</h3>
        <p class="mt-1 text-sm leading-relaxed text-slate-600">{item.desc}</p>
        <p class="mt-3 text-xs font-semibold text-primary-700">{item.for}</p>
      </article>
    ))}
  </div>
</section>
