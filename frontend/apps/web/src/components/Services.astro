---
import type { Dictionary } from "../i18n/utils";
interface Props { dict: Dictionary; }
const { dict } = Astro.props;
const s = dict.services;
/* Icons by service order in the dictionary (locked order):
   0 Business Website, 1 Landing Page, 2 Booking / Enquiry, 3 Catalogue / Menu. */
const icons = [
  '<circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>',
  '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/>',
  '<path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/>',
  '<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>',
];
---

<section class="mx-auto max-w-6xl px-4 py-12">
  <h2 class="text-2xl font-bold sm:text-3xl">{s.title}</h2>
  <p class="mt-2 max-w-2xl text-body">{s.subtitle}</p>
  <div class="mt-8 grid gap-4 sm:grid-cols-2">
    {s.items.map((item, i) => (
      <article class="rounded-xl border border-line bg-white p-6">
        <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary-50">
          <svg class="h-5 w-5 text-primary-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[i] ?? icons[0]} />
        </span>
        <h3 class="mt-3 text-lg font-bold">{item.title}</h3>
        <p class="mt-1 text-sm leading-relaxed text-body">{item.desc}</p>
        <p class="mt-3 text-xs font-semibold text-primary-700">{item.for}</p>
      </article>
    ))}
  </div>
</section>
