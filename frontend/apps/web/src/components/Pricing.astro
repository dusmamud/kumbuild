---
import SectionHead from "./SectionHead.astro";
import { pageUrl, type Dictionary, type Locale } from "../i18n/utils";
interface Props { dict: Dictionary; locale: Locale; no?: string; hideHead?: boolean; showRenewal?: boolean; }
const { dict, locale, no, hideHead, showRenewal = true } = Astro.props;
const p = dict.pricing;
---

<section class={`mx-auto max-w-6xl px-4 sm:px-6 ${hideHead ? "pt-10 pb-16 sm:pb-24" : "py-16 sm:py-24"}`}>
  {!hideHead && (
    <div data-reveal>
      <SectionHead no={no} title={p.title} subtitle={p.subtitle} />
    </div>
  )}
  <div class="mt-10 grid gap-6 lg:grid-cols-3">
    {p.packages.map((pkg, pi) => {
      const featured = pkg.slug === "business";
      return (
        <article data-reveal style={`--reveal-delay:${pi * 80}ms`} class={`relative flex flex-col rounded-2xl border bg-white p-6 transition-[border-color,box-shadow] duration-300 sm:p-7 ${featured ? "border-primary-500 shadow-[0_20px_40px_-24px_rgba(28,25,23,0.3)] ring-1 ring-primary-500 hover:shadow-[0_26px_48px_-24px_rgba(28,25,23,0.38)]" : "border-line hover:border-primary-200 hover:shadow-[0_20px_40px_-24px_rgba(28,25,23,0.3)]"}`}>
          {featured && (
            <span class="absolute -top-3 left-6 rounded-full bg-primary-600 px-3 py-1 text-xs font-semibold text-white">{dict.v2.ui.popular}</span>
          )}
          <h3 class="text-base font-semibold text-ink sm:text-lg">{pkg.name}</h3>
          <p class="mt-3 font-display text-[clamp(1.875rem,1.55rem+1.4vw,2.5rem)] font-semibold leading-none tabular-nums text-ink">{pkg.price} <span class="font-sans text-sm font-medium text-muted">/ {pkg.per}</span></p>
          <p class="mt-3 text-base leading-[28px] text-body">{pkg.bestFor}</p>
          <ul class="mt-5 flex-1 space-y-2.5 border-t border-line pt-5 text-base text-body">
            {pkg.features.map((f) => (
              <li class="flex gap-2.5">
                <svg class="mt-0.5 h-[18px] w-[18px] shrink-0 text-primary-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                <span>{f}</span>
              </li>
            ))}
          </ul>
          <a href={pageUrl(locale, "/order")} class={`mt-7 block rounded-xl px-4 py-3 text-center text-base font-semibold transition-[background-color,border-color,transform] duration-200 active:scale-[0.98] ${featured ? "bg-primary-600 text-white hover:bg-primary-700" : "border border-line text-primary-700 hover:border-primary-500"}`}>{pkg.cta}</a>
        </article>
      );
    })}
  </div>
  {showRenewal && (
    <div class="mt-10 flex flex-wrap items-baseline justify-between gap-x-10 gap-y-2 border-t border-line pt-6">
      <div class="max-w-xl">
        <h3 class="text-base font-semibold text-ink sm:text-lg">{p.renewal.title}</h3>
        <p class="mt-1 text-base leading-[28px] text-body">{p.renewal.desc}</p>
      </div>
      <p class="font-display text-[clamp(1.25rem,1.1rem+0.7vw,1.5rem)] font-semibold tabular-nums text-ink">{p.renewal.price} <span class="font-sans text-sm font-medium text-muted">/ {p.renewal.per}</span></p>
    </div>
  )}
  <p class="mt-6 text-[13px] leading-[20px] text-muted">{p.terms}</p>
  <p class="mt-1 text-[13px] leading-[20px] text-muted">{p.note}</p>
</section>
