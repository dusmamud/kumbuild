---
import SectionHead from "./SectionHead.astro";
import Icon from "./Icon.astro";
import { pageUrl, type Dictionary, type Locale } from "../i18n/utils";
interface Props { dict: Dictionary; locale: Locale; }
const { dict, locale } = Astro.props;
const b = dict.v2.blog;
const fmtDate = (iso: string) =>
  new Date(`${iso}T00:00:00`).toLocaleDateString(locale === "en-US" ? "en-IN" : locale, {
    day: "numeric",
    month: "short",
    year: "numeric",
  });
---

<section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
  <div data-reveal class="flex flex-wrap items-end justify-between gap-x-8 gap-y-5">
    <SectionHead title={b.title} subtitle={b.subtitle} />
    <a href={pageUrl(locale, "/blog")} class="inline-flex min-h-[44px] items-center gap-1.5 text-base font-semibold text-primary-600 transition-colors duration-200 hover:text-primary-700">
      {b.allPosts}
      <Icon name="arrow-right" class="h-4 w-4" />
    </a>
  </div>
  <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {b.posts.map((post) => (
      <a
        data-reveal
        href={pageUrl(locale, `/blog/${post.slug}`)}
        class="group flex flex-col overflow-hidden rounded-2xl border border-line bg-white transition-[border-color,box-shadow,transform] duration-300 hover:-translate-y-0.5 hover:border-primary-200 hover:shadow-[0_20px_40px_-24px_rgba(28,25,23,0.3)]"
      >
        <span class="relative block overflow-hidden">
          <img src={post.img} alt={post.title} width="1200" height="675" loading="lazy" class="aspect-[16/9] w-full object-cover transition duration-500 group-hover:scale-[1.04]" />
          <span class="absolute bottom-3 left-3 rounded-full bg-white/95 px-2.5 py-1 font-mono text-xs font-medium text-primary-700 shadow-sm">{post.tag}</span>
        </span>
        <span class="flex flex-1 flex-col p-6">
          <span class="font-display text-[clamp(1rem,0.95rem+0.5vw,1.25rem)] font-semibold leading-snug text-ink group-hover:text-primary-700">{post.title}</span>
          <span class="mt-2 flex-1 text-base leading-[28px] text-body">{post.excerpt}</span>
          <span class="mt-5 font-mono text-xs text-muted">{fmtDate(post.date)} · {post.readMins} {dict.v2.ui.minRead}</span>
          <span class="mt-3 inline-flex items-center gap-1.5 text-base font-semibold text-primary-700">
            {dict.v2.ui.readMore}
            <Icon name="arrow-right" class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5" />
          </span>
        </span>
      </a>
    ))}
  </div>
</section>
