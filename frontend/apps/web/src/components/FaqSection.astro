---
import type { Dictionary } from "../i18n/utils";
interface Props { dict: Dictionary; limit?: number; }
const { dict, limit } = Astro.props;
const items = limit ? dict.faq.items.slice(0, limit) : dict.faq.items;
---

<section class="mx-auto max-w-6xl px-4 py-12">
  <h2 class="text-2xl font-bold sm:text-3xl">{dict.faq.title}</h2>
  <p class="mt-2 max-w-2xl text-body">{dict.faq.subtitle}</p>
  <div class="mt-6 space-y-3">
    {items.map((item) => (
      <details class="group rounded-xl border border-line bg-white px-5 py-4">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-bold [&::-webkit-details-marker]:hidden">
          <span>{item.q}</span>
          <svg class="h-5 w-5 shrink-0 text-muted transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
        </summary>
        <p class="mt-2 text-sm leading-relaxed text-body">{item.a}</p>
      </details>
    ))}
  </div>
</section>
