---
import SectionHead from "./SectionHead.astro";
import FaqAccordion from "./react/FaqAccordion";
import type { Dictionary } from "../i18n/utils";
interface Props { dict: Dictionary; limit?: number; no?: string; }
const { dict, limit, no } = Astro.props;
const items = limit ? dict.faq.items.slice(0, limit) : dict.faq.items;
---

<section class="mx-auto max-w-6xl px-4 py-16 sm:py-24">
  <SectionHead no={no} title={dict.faq.title} subtitle={dict.faq.subtitle} />
  <div class="mt-8 max-w-3xl">
    <FaqAccordion client:visible items={items} variant="rows" />
  </div>
</section>
