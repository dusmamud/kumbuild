---
import SectionHead from "./SectionHead.astro";
import Icon from "./Icon.astro";
import type { Dictionary } from "../i18n/utils";
interface Props { dict: Dictionary; }
const { dict } = Astro.props;
const t = dict.v2.tech;
/* Icons per group, locked to the dictionary item order:
   Build / Experience / Hosting & payments. */
const groupIcons = [
  ["rocket", "layers", "smartphone", "zap", "code", "wind"],
  ["trending-up", "gauge", "refresh-cw", "star"],
  ["globe", "wallet", "message-circle", "search"],
];
/* Real brand logos (Simple Icons, public/tech/) where one exists;
   items without a logo fall back to the Lucide-style icon above. */
const groupLogos = [
  ["html5", "css3", "javascript", "astro", "nextjs", "react", "vite", "typescript", "tailwindcss"],
  ["motion", null, null, "lucide"],
  ["cloudflare", "razorpay", "whatsapp", "google"],
  ["nodejs", "pnpm", "turborepo", "github"],
];
---

<section class="border-y border-line bg-surface">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
    <div data-reveal>
      <SectionHead title={t.title} subtitle={t.subtitle} />
    </div>
    {t.groups.map((group, gi) => (
      <div class={gi === 0 ? "mt-12" : "mt-14"}>
        <h3 data-reveal class="flex items-center gap-3 font-mono text-xs font-medium uppercase tracking-[0.14em] text-muted">
          {group.label}
          <span class="h-px flex-1 bg-line" aria-hidden="true"></span>
        </h3>
        <ul class={`mt-6 grid gap-4 sm:grid-cols-2 ${gi === 0 ? "lg:grid-cols-3" : "lg:grid-cols-4"}`}>
          {group.items.map((item, i) => (
            <li
              data-reveal
              style={`--reveal-delay:${(i % 4) * 60}ms`}
              class="rounded-2xl border border-line bg-white p-5 transition-[border-color,box-shadow,transform] duration-300 hover:-translate-y-0.5 hover:border-primary-200 hover:shadow-[0_20px_40px_-24px_rgba(28,25,23,0.3)]"
            >
              <span class="flex items-center gap-3">
                {groupLogos[gi]?.[i] ? (
                  <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-line bg-white p-2">
                    <img src={`/tech/${groupLogos[gi][i]}.svg`} alt="" width="28" height="28" loading="lazy" class="h-7 w-7 object-contain" />
                  </span>
                ) : (
                  <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-primary-50 text-primary-700">
                    <Icon name={groupIcons[gi]?.[i] ?? "code"} class="h-5 w-5" />
                  </span>
                )}
                <span class="font-display text-base font-semibold text-ink">{item.name}</span>
              </span>
              <p class="mt-3 text-[15px] leading-[24px] text-body">{item.desc}</p>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
