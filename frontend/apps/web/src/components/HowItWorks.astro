---
import SectionHead from "./SectionHead.astro";
import type { Dictionary } from "../i18n/utils";
interface Props { dict: Dictionary; no?: string; }
const { dict, no } = Astro.props;
const h = dict.how;
---

<section class="mx-auto max-w-6xl px-4 py-16 sm:py-20">
  <SectionHead no={no} title={h.title} subtitle={h.subtitle} />
  <ol class="relative mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-5 lg:gap-6">
    <span class="absolute left-0 right-0 top-4 hidden h-px bg-[#ddd6c9] lg:block" aria-hidden="true"></span>
    {h.steps.map((step, i) => (
      <li class="relative">
        <span class="relative z-10 flex h-8 w-8 items-center justify-center rounded-full border border-[#ddd6c9] bg-white font-mono text-[13px] font-semibold text-primary-700">{i + 1}</span>
        <h3 class="mt-4 text-[15px] font-semibold text-ink sm:text-base">{step.title}</h3>
        <p class="mt-1.5 text-sm leading-[22px] text-body sm:text-[15px] sm:leading-[24px]">{step.desc}</p>
      </li>
    ))}
  </ol>
</section>
