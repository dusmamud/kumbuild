---
import type { Dictionary } from "../i18n/utils";
interface Props { dict: Dictionary; }
const { dict } = Astro.props;
const h = dict.how;
---

<section class="bg-slate-50 py-12">
  <div class="mx-auto max-w-6xl px-4">
    <h2 class="text-2xl font-extrabold sm:text-3xl">{h.title}</h2>
    <p class="mt-2 max-w-2xl text-slate-600">{h.subtitle}</p>
    <ol class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {h.steps.map((step, i) => (
        <li class="rounded-xl border border-slate-200 bg-white p-5">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-primary-500 text-sm font-bold text-white">{i + 1}</span>
          <h3 class="mt-3 font-bold">{step.title}</h3>
          <p class="mt-1 text-sm leading-relaxed text-slate-600">{step.desc}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
