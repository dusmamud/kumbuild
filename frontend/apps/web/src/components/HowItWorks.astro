---
import SectionHead from "./SectionHead.astro";
import { pageUrl, type Dictionary, type Locale } from "../i18n/utils";
interface Props { dict: Dictionary; locale: Locale; no?: string; }
const { dict, locale, no } = Astro.props;
const h = dict.how;
---

<section class="mx-auto max-w-6xl px-4 py-12 sm:py-16">
  <SectionHead no={no} title={h.title} subtitle={h.subtitle} />
  {/* Timeline, not five separate tiles: the numbered steps are visibly
      joined — a horizontal line on desktop, a vertical line on mobile —
      so the visitor reads one process from Tell us to Go live. */}
  <ol class="relative mt-10 sm:mt-12">
    <span class="absolute left-0 right-0 top-5 hidden h-0.5 bg-primary-100 lg:block" aria-hidden="true"></span>
    <span class="absolute bottom-5 left-5 top-5 hidden w-0.5 bg-primary-100 max-lg:block" aria-hidden="true"></span>
    <div class="grid gap-8 lg:grid-cols-5 lg:gap-6">
      {h.steps.map((step, i) => (
        <li class="relative">
          <div class="flex items-center gap-3.5 lg:block">
            <span class="relative z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary-600 font-display text-base font-semibold text-white shadow-sm">{i + 1}</span>
            <h3 class="text-lg font-semibold leading-snug text-ink lg:mt-4">{step.title}</h3>
          </div>
          <p class="mt-2 pl-[54px] text-[15px] leading-[26px] text-body lg:mt-1.5 lg:pl-0">{step.desc}</p>
        </li>
      ))}
    </div>
  </ol>
  {/* CTA right below the steps — the visitor now knows the process,
      so the next action sits here, not a scroll away. */}
  <div class="mt-10 flex flex-col gap-3 sm:mt-12 sm:flex-row sm:items-center">
    <a href={pageUrl(locale, "/order")} class="inline-flex items-center justify-center gap-2 rounded-xl bg-cta px-7 py-3.5 text-base font-semibold text-white transition-[background-color,transform] duration-200 hover:bg-cta-hover active:scale-[0.98]">
      {dict.hero.ctaOrder}
    </a>
    <a href={pageUrl(locale, "/pricing")} class="inline-flex items-center justify-center gap-2 rounded-xl border border-line bg-white px-7 py-3.5 text-base font-semibold text-ink transition-colors duration-200 hover:border-primary-300 hover:text-primary-700">
      {dict.hero.ctaPricing}
    </a>
  </div>
</section>
