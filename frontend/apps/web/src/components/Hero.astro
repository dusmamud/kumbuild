---
import { pageUrl, type Dictionary, type Locale } from "../i18n/utils";
interface Props { dict: Dictionary; locale: Locale; }
const { dict, locale } = Astro.props;
const hero = dict.hero;
/* Demo website previews — real rendered screenshots.
   Replace the files in public/demo/ to change them (same names, 1280x800). */
const demos = [
  { img: "/demo/shop.png", url: "sharma-general-store.in", name: "Sharma General Store", type: "Shop website", alt: "Demo shop website — Sharma General Store, with products, prices and WhatsApp ordering" },
  { img: "/demo/clinic.png", url: "smile-dental-clinic.in", name: "Smile Dental Clinic", type: "Clinic website", alt: "Demo clinic website — Smile Dental Clinic, with treatments, prices and appointment booking" },
  { img: "/demo/salon.png", url: "glow-salon.in", name: "Glow Salon", type: "Salon website", alt: "Demo salon website — Glow Salon, with services, prices and WhatsApp booking" },
];
---

<section class="mx-auto max-w-6xl px-4 pb-10 pt-14 text-center sm:pt-20">
  <span class="inline-block rounded-full bg-primary-50 px-3 py-1 text-xs font-bold text-primary-700">{hero.badge}</span>
  <h1 class="mx-auto mt-5 max-w-3xl text-4xl font-bold leading-tight sm:text-5xl">{hero.title}</h1>
  <p class="mx-auto mt-4 max-w-2xl text-lg text-body">{hero.subtitle}</p>
  <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
    <a href={pageUrl(locale, "/order")} class="rounded-lg bg-primary-500 px-6 py-3 font-bold text-white hover:bg-primary-600">{hero.ctaOrder}</a>
    <a href={pageUrl(locale, "/pricing")} class="rounded-lg border border-line bg-white px-6 py-3 font-bold text-primary-700 hover:border-primary-500">{hero.ctaPricing}</a>
  </div>
  <p class="mt-4 text-sm text-muted">{hero.note}</p>
  <div class="mt-10 flex flex-wrap justify-center gap-2">
    {dict.trust.map((t) => (
      <span class="inline-flex items-center gap-1 rounded-full border border-line bg-surface px-3 py-1 text-xs font-semibold text-body">
        <svg class="h-4 w-4 text-primary-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
        {t}
      </span>
    ))}
  </div>

  {/* Demo website previews — screenshots of example sites built the Kumbuild way. */}
  <div class="mx-auto mt-12 text-left">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {demos.map((d) => (
        <figure class="overflow-hidden rounded-xl border border-line bg-white shadow-[0_2px_16px_rgba(15,23,42,0.08)]">
          <div class="flex items-center gap-2 border-b border-line bg-surface px-3 py-2">
            <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-line"></span>
            <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-line"></span>
            <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-line"></span>
            <span class="ml-1 truncate rounded-md border border-line bg-white px-2 py-0.5 text-[11px] text-muted">{d.url}</span>
          </div>
          <img src={d.img} alt={d.alt} width="1280" height="800" class="block aspect-[8/5] w-full object-cover object-top" />
          <figcaption class="flex items-baseline justify-between gap-2 px-4 py-3">
            <span class="text-sm font-bold text-ink">{d.name}</span>
            <span class="shrink-0 text-xs text-muted">{d.type}</span>
          </figcaption>
        </figure>
      ))}
    </div>
    <p class="mt-4 text-center text-xs text-muted">Example previews — shop, clinic and salon websites, with products, prices and WhatsApp ordering.</p>
  </div>
</section>
