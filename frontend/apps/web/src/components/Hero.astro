---
import { pageUrl, type Dictionary, type Locale } from "../i18n/utils";
interface Props { dict: Dictionary; locale: Locale; }
const { dict, locale } = Astro.props;
const hero = dict.hero;
const home = dict.home;
/* Demo website preview — a real rendered screenshot.
   Replace the file in public/demo/ to change it (same name, 1280x800). */
const mainDemo = { img: "/demo/shop.png", url: "sharma-general-store.in", name: "Sharma General Store", type: "Shop website", alt: "Demo shop website — Sharma General Store, with products, prices and WhatsApp ordering" };
---

<section class="mx-auto max-w-6xl px-4 pb-16 pt-12 sm:pt-16 lg:pb-20">
  <div class="grid items-center gap-12 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <p class="flex items-center gap-2.5 text-[13px] font-semibold text-primary-700">
        <span class="h-2 w-2 shrink-0 bg-primary-500" aria-hidden="true"></span>
        {hero.badge}
      </p>
      <h1 class="mt-5 text-[38px] font-semibold leading-[46px] sm:text-[52px] sm:leading-[60px]">{hero.headlineA}<span class="text-primary-700 underline decoration-primary-200 decoration-[5px] underline-offset-[6px]">{hero.headlineAccent}</span>{hero.headlineB}</h1>
      <p class="mt-5 max-w-xl text-[17px] leading-[28px] text-body">{hero.subtitle}</p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href={pageUrl(locale, "/order")} class="rounded-lg bg-primary-500 px-6 py-3.5 text-[15px] font-semibold text-white transition-colors hover:bg-primary-600">{hero.ctaOrder}</a>
        <a href={pageUrl(locale, "/pricing")} class="rounded-lg border border-line bg-white px-6 py-3.5 text-[15px] font-semibold text-primary-700 transition-colors hover:border-primary-500">{hero.ctaPricing}</a>
      </div>
      <p class="mt-4 text-sm text-muted">{hero.note}</p>
      <dl class="mt-10 grid grid-cols-3 gap-4 border-t border-line pt-6">
        {home.stats.map((s) => (
          <div>
            <dd class="font-display text-[22px] font-semibold tabular-nums text-ink">{s.v}</dd>
            <dt class="mt-1 text-xs leading-[18px] text-muted">{s.k}</dt>
          </div>
        ))}
      </dl>
    </div>

    <div class="relative lg:col-span-7">
      {/* The one bright moment: a real customer's website, in a browser frame. */}
      <figure class="overflow-hidden rounded-xl border border-line bg-white shadow-[0_24px_48px_-24px_rgba(15,23,42,0.28)]">
        <div class="flex items-center gap-2 border-b border-line bg-surface px-3 py-2">
          <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-line"></span>
          <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-line"></span>
          <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-line"></span>
          <span class="ml-1 truncate rounded-md border border-line bg-white px-2 py-0.5 font-mono text-[11px] text-muted">{mainDemo.url}</span>
        </div>
        <img src={mainDemo.img} alt={mainDemo.alt} width="1280" height="800" class="block aspect-[8/5] w-full object-cover object-top" />
        <figcaption class="flex items-baseline justify-between gap-2 px-4 py-3">
          <span class="font-display text-sm font-semibold text-ink">{mainDemo.name}</span>
          <span class="shrink-0 text-xs text-muted">{mainDemo.type}</span>
        </figcaption>
      </figure>

      {/* Signature detail: the order slip that comes with every website. */}
      <div class="mt-4 rounded-xl border border-line bg-white p-5 shadow-[0_16px_32px_-16px_rgba(15,23,42,0.22)] sm:absolute sm:-bottom-8 sm:left-6 sm:mt-0 sm:w-72">
        <div class="flex items-baseline justify-between gap-3">
          <p class="font-mono text-xs text-muted">{home.slip.heading} · {home.slip.ref}</p>
          <p class="flex items-center gap-1.5 text-xs font-semibold text-ink">
            <span class="h-2 w-2 rounded-full bg-green-600" aria-hidden="true"></span>
            {home.slip.status}
          </p>
        </div>
        <p class="mt-2 font-display text-[15px] font-semibold text-ink">{home.slip.business}</p>
        <dl class="mt-2">
          {home.slip.rows.map((r) => (
            <div class="flex items-baseline justify-between gap-4 border-b border-dashed border-line py-2 text-sm last:border-b-0">
              <dt class="shrink-0 text-muted">{r.k}</dt>
              <dd class="text-right font-medium text-ink">{r.v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </div>

  {/* Trust strip — quiet facts on hairlines, not pills. */}
  <ul class="mt-16 flex flex-wrap gap-x-10 gap-y-3 border-y border-line py-5 sm:mt-20">
    {dict.trust.map((t) => (
      <li class="flex items-center gap-2 text-sm font-medium text-body">
        <svg class="h-4 w-4 shrink-0 text-primary-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
        {t}
      </li>
    ))}
  </ul>
</section>
