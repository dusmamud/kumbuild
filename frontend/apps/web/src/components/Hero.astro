---
import { pageUrl, type Dictionary, type Locale } from "../i18n/utils";
interface Props { dict: Dictionary; locale: Locale; }
const { dict, locale } = Astro.props;
const hero = dict.hero;
---

<section class="mx-auto max-w-6xl px-4 pb-10 pt-14 text-center sm:pt-20">
  <span class="inline-block rounded-full bg-primary-50 px-3 py-1 text-xs font-bold text-primary-700">{hero.badge}</span>
  <h1 class="mx-auto mt-5 max-w-3xl text-4xl font-extrabold leading-tight sm:text-5xl">{hero.title}</h1>
  <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-600">{hero.subtitle}</p>
  <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
    <a href={pageUrl(locale, "/order")} class="rounded-lg bg-primary-500 px-6 py-3 font-bold text-white hover:bg-primary-600">{hero.ctaOrder}</a>
    <a href={pageUrl(locale, "/pricing")} class="rounded-lg border border-slate-300 bg-white px-6 py-3 font-bold text-primary-700 hover:border-primary-500">{hero.ctaPricing}</a>
  </div>
  <p class="mt-4 text-sm text-slate-500">{hero.note}</p>
  <div class="mt-10 flex flex-wrap justify-center gap-2">
    {dict.trust.map((t) => (
      <span class="rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-xs font-semibold text-slate-600">✓ {t}</span>
    ))}
  </div>
</section>
