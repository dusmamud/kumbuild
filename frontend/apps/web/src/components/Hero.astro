---
import { pageUrl, type Dictionary, type Locale } from "../i18n/utils";
interface Props { dict: Dictionary; locale: Locale; }
const { dict, locale } = Astro.props;
const hero = dict.hero;
---

<section class="mx-auto max-w-6xl px-4 pb-10 pt-14 text-center sm:pt-20">
  <span class="inline-block rounded-full bg-primary-50 px-3 py-1 text-xs font-bold text-primary-700">{hero.badge}</span>
  <h1 class="mx-auto mt-5 max-w-3xl text-4xl font-bold leading-tight sm:text-5xl">{hero.title}</h1>
  <p class="mx-auto mt-4 max-w-2xl text-lg text-body">{hero.subtitle}</p>
  <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
    <a href={pageUrl(locale, "/order")} class="rounded-lg bg-primary-500 px-6 py-3 font-bold text-white hover:bg-primary-600">{hero.ctaOrder}</a>
    <a href={pageUrl(locale, "/pricing")} class="rounded-lg border border-line bg-white px-6 py-3 font-bold text-primary-700 hover:border-primary-500">{hero.ctaPricing}</a>
  </div>
  <p class="mt-4 text-sm text-muted">{hero.note}</p>
  <div class="mt-10 flex flex-wrap justify-center gap-2">
    {dict.trust.map((t) => (
      <span class="inline-flex items-center gap-1 rounded-full border border-line bg-surface px-3 py-1 text-xs font-semibold text-body">
        <svg class="h-4 w-4 text-primary-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
        {t}
      </span>
    ))}
  </div>

  {/* Preview mock — a shop website built the Kumbuild way (HTML/CSS only, no images). */}
  <div class="mx-auto mt-12 max-w-4xl text-left">
    <div class="overflow-hidden rounded-xl border border-line bg-white shadow-[0_2px_16px_rgba(15,23,42,0.08)]">
      <div class="flex items-center gap-2 border-b border-line bg-surface px-4 py-2.5">
        <span class="h-2.5 w-2.5 rounded-full bg-line"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-line"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-line"></span>
        <span class="ml-2 flex items-center gap-1.5 rounded-md border border-line bg-white px-2.5 py-1 text-xs text-muted">
          <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
          sharma-general-store.in
        </span>
      </div>
      <div class="px-5 py-4 sm:px-6">
        <div class="flex items-center gap-3">
          <p class="text-sm font-bold text-ink">Sharma General Store</p>
          <nav class="ml-2 hidden items-center gap-4 text-xs text-muted sm:flex">
            <span>Home</span><span>Products</span><span>Contact</span>
          </nav>
          <span class="ml-auto rounded-lg bg-[#128c7e] px-3 py-1.5 text-xs font-bold text-white">WhatsApp us</span>
        </div>
        <div class="mt-4 rounded-lg bg-primary-50 px-4 py-3">
          <p class="text-sm font-bold text-ink">Fresh groceries at your doorstep</p>
          <p class="mt-0.5 text-xs text-muted">Order on WhatsApp — pay on delivery.</p>
        </div>
        <div class="mt-4 grid gap-3 sm:grid-cols-3">
          <div class="rounded-lg border border-line p-3">
            <p class="text-sm font-bold text-ink">Basmati Rice 1 kg</p>
            <p class="mt-0.5 text-xs text-muted">Premium long-grain</p>
            <p class="mt-2 flex items-baseline justify-between"><span class="text-sm font-bold text-ink">₹120</span><span class="text-xs font-semibold text-primary-700">Order</span></p>
          </div>
          <div class="rounded-lg border border-line p-3">
            <p class="text-sm font-bold text-ink">Toor Dal 1 kg</p>
            <p class="mt-0.5 text-xs text-muted">Unpolished, protein-rich</p>
            <p class="mt-2 flex items-baseline justify-between"><span class="text-sm font-bold text-ink">₹145</span><span class="text-xs font-semibold text-primary-700">Order</span></p>
          </div>
          <div class="rounded-lg border border-line p-3">
            <p class="text-sm font-bold text-ink">Groundnut Oil 1 L</p>
            <p class="mt-0.5 text-xs text-muted">Cold-pressed</p>
            <p class="mt-2 flex items-baseline justify-between"><span class="text-sm font-bold text-ink">₹210</span><span class="text-xs font-semibold text-primary-700">Order</span></p>
          </div>
        </div>
        <div class="mt-4 flex items-center gap-2 rounded-lg bg-surface px-4 py-2.5">
          <svg class="h-4 w-4 shrink-0 text-primary-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" /><circle cx="12" cy="10" r="3" /></svg>
          <p class="text-xs text-muted">Sharma General Store · MG Road · Open 9am–9pm · Find us on Google Maps</p>
        </div>
        <p class="mt-4 border-t border-line pt-3 text-center text-xs text-muted">© 2026 Sharma General Store</p>
      </div>
    </div>
    <p class="mt-3 text-center text-xs text-muted">Example preview — a shop website with products, prices and WhatsApp ordering.</p>
  </div>
</section>
