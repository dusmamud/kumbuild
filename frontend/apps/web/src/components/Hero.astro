---
import { pageUrl, type Dictionary, type Locale } from "../i18n/utils";
interface Props { dict: Dictionary; locale: Locale; }
const { dict, locale } = Astro.props;
const hero = dict.hero;
const home = dict.home;
/* Mini website built in code — crisp at every size, unlike a screenshot.
   It shows exactly what the customer gets: shop name, products with
   prices, and the WhatsApp order button. Copy mirrors the demo sites. */
const miniProducts = [
  { name: "Basmati Rice · 1 kg", price: "₹92" },
  { name: "Toor Dal · 500 g", price: "₹78" },
  { name: "Sunflower Oil · 1 L", price: "₹145" },
];
---

<section class="border-b border-line bg-surface">
  <div class="mx-auto max-w-6xl px-4 pb-20 pt-12 sm:px-6 sm:pt-16 lg:pb-24 lg:pt-20">
    <div class="grid items-center gap-14 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-6">
        <p class="flex items-center gap-3 text-[13px] font-semibold text-primary-700">
          <span class="h-px w-8 bg-primary-500" aria-hidden="true"></span>
          {hero.badge}
        </p>
        <h1 class="mt-6 max-w-[560px] text-[40px] font-semibold leading-[1.1] sm:text-[56px] lg:text-[64px] lg:leading-[1.05]">{hero.headlineA}<span class="text-primary-700 underline decoration-primary-200 decoration-[6px] underline-offset-[8px]">{hero.headlineAccent}</span>{hero.headlineB}</h1>
        <p class="mt-6 max-w-[520px] text-lg leading-[30px] text-body sm:text-xl sm:leading-[32px]">{hero.subtitle}</p>
        <div class="mt-9 flex flex-col gap-3 min-[420px]:flex-row min-[420px]:items-center">
          <a href={pageUrl(locale, "/order")} class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary-500 px-7 py-3.5 text-base font-semibold text-white transition-colors hover:bg-primary-600">
            {hero.ctaOrder}
            <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </a>
          <a href={pageUrl(locale, "/pricing")} class="inline-flex items-center justify-center rounded-xl border border-[#cbd5e1] bg-white px-7 py-3.5 text-base font-semibold text-primary-700 transition-colors hover:border-primary-500">{hero.ctaPricing}</a>
        </div>
        <p class="mt-5 text-sm text-muted">{hero.note}</p>
        <dl class="mt-12 grid max-w-[520px] grid-cols-3 gap-6">
          {home.stats.map((s) => (
            <div class="border-l-2 border-primary-500/70 pl-4">
              <dd class="font-display text-[26px] font-semibold leading-none tabular-nums text-ink">{s.v}</dd>
              <dt class="mt-2 text-[13px] leading-[18px] text-muted">{s.k}</dt>
            </div>
          ))}
        </dl>
      </div>

      <div class="relative lg:col-span-6">
        {/* The moment: a real shop owner, in his own shop. */}
        <figure class="relative mx-auto max-w-[520px]">
          <img
            src="/hero/shop-owner.jpg"
            alt="A shop owner in his general store, holding his phone — the kind of business Kumbuild builds websites for"
            width="1280"
            height="1920"
            class="aspect-[4/5] w-full rounded-[24px] object-cover object-top shadow-[0_32px_64px_-32px_rgba(15,23,42,0.4)] sm:aspect-[5/5.4]"
            loading="eager"
          />
          <figcaption class="absolute right-4 top-4 flex items-center gap-2 rounded-full bg-white/95 py-1.5 pl-2.5 pr-3.5 text-[13px] font-semibold text-ink shadow-[0_8px_20px_-8px_rgba(15,23,42,0.4)] backdrop-blur-sm">
            <span class="flex h-5 w-5 items-center justify-center rounded-full bg-green-600">
              <svg class="h-3 w-3 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
            </span>
            {home.slip.rows[2].k} · {home.slip.rows[2].v}
          </figcaption>
        </figure>

        {/* The product, built in code: the customer's website on a phone. */}
        <div class="relative z-10 mx-auto -mt-16 w-[280px] max-w-[86vw] rounded-[20px] border border-line bg-white p-2 shadow-[0_32px_56px_-24px_rgba(15,23,42,0.35)] sm:absolute sm:-bottom-10 sm:left-0 sm:mt-0 lg:-left-6">
          <div class="overflow-hidden rounded-[14px] border border-line">
            <div class="flex items-center gap-1.5 bg-surface px-3 py-2">
              <span class="h-2 w-2 shrink-0 rounded-full bg-line"></span>
              <span class="h-2 w-2 shrink-0 rounded-full bg-line"></span>
              <span class="ml-1 truncate rounded bg-white px-1.5 py-0.5 font-mono text-[10px] leading-none text-muted">sharma-general-store.in</span>
              <span class="ml-auto flex items-center gap-1 text-[10px] font-semibold text-ink">
                <span class="h-1.5 w-1.5 rounded-full bg-green-600" aria-hidden="true"></span>
                {home.slip.status}
              </span>
            </div>
            <div class="px-4 py-3.5">
              <p class="font-display text-[15px] font-semibold leading-tight text-ink">Sharma General Store</p>
              <p class="mt-0.5 text-[11px] text-muted">Fresh groceries at your doorstep</p>
              <ul class="mt-3 space-y-2">
                {miniProducts.map((p) => (
                  <li class="flex items-baseline justify-between gap-3 text-[12.5px]">
                    <span class="text-body">{p.name}</span>
                    <span class="font-semibold tabular-nums text-ink">{p.price}</span>
                  </li>
                ))}
              </ul>
              <p class="mt-3.5 flex items-center justify-center gap-1.5 rounded-lg bg-[#1faa55] py-2 text-[12.5px] font-semibold text-white">
                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.028 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z" /></svg>
                Order on WhatsApp
              </p>
            </div>
          </div>
        </div>

        {/* Order slip — the signature, tucked at the photo's lower right. */}
        <div class="mx-auto mt-5 w-[264px] max-w-[86vw] rounded-[16px] border border-line bg-white p-5 shadow-[0_24px_40px_-24px_rgba(15,23,42,0.35)] sm:absolute sm:-bottom-4 sm:right-0 sm:mt-0 lg:-right-2">
          <div class="flex items-baseline justify-between gap-3">
            <p class="font-mono text-[11px] text-muted">{home.slip.heading} · {home.slip.ref}</p>
            <p class="text-[11px] font-semibold text-primary-700">{home.slip.business}</p>
          </div>
          <dl class="mt-1.5">
            {home.slip.rows.slice(0, 2).map((r) => (
              <div class="flex items-baseline justify-between gap-4 border-b border-dashed border-line py-1.5 text-[13px] last:border-b-0">
                <dt class="shrink-0 text-muted">{r.k}</dt>
                <dd class="text-right font-medium text-ink">{r.v}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </div>

    {/* Trust strip — quiet facts on a hairline. */}
    <ul class="mt-20 flex flex-wrap gap-x-10 gap-y-3 border-t border-line pt-7 lg:mt-28">
      {dict.trust.map((t) => (
        <li class="flex items-center gap-2 text-sm font-medium text-body">
          <svg class="h-4 w-4 shrink-0 text-primary-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
          {t}
        </li>
      ))}
    </ul>
  </div>
</section>
