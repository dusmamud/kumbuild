---
import Layout from "../../layouts/Layout.astro";
import CtaBand from "../CtaBand.astro";
import Icon from "../Icon.astro";
import { pageUrl, type Dictionary, type Locale } from "../../i18n/utils";
interface Props { dict: Dictionary; locale: Locale; }
const { dict, locale } = Astro.props;
const r = dict.v2.refund;
const waLink = `https://wa.me/${dict.v2.contact.waNumber}?text=${encodeURIComponent(dict.v2.contact.waText)}`;
---

<Layout title={r.title} description={r.subtitle} locale={locale} dict={dict} slug="/refund">
  <section class="mx-auto max-w-6xl px-4 py-12 sm:py-16">
    <div data-reveal class="max-w-3xl">
      <h1 class="font-display text-[clamp(2rem,1.6rem+2vw,3rem)] font-semibold leading-[1.15] text-ink">{r.title}</h1>
      <p class="mt-3 text-base leading-[28px] text-body">{r.subtitle}</p>
    </div>
    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      {r.points.map((point, i) => (
        <article data-reveal class="rounded-2xl border border-line bg-white p-6 sm:p-7">
          <span class="font-mono text-sm font-medium text-primary-700">{String(i + 1).padStart(2, "0")}</span>
          <h2 class="mt-3 font-display text-[clamp(1.125rem,1.02rem+0.5vw,1.25rem)] font-semibold leading-snug text-ink">{point.title}</h2>
          <p class="mt-2 text-base leading-[28px] text-body">{point.text}</p>
        </article>
      ))}
    </div>
    <div data-reveal class="mt-10 flex flex-wrap items-center justify-between gap-x-8 gap-y-5 rounded-2xl border border-line bg-surface px-6 py-6 sm:px-8">
      <div class="max-w-xl">
        <h2 class="font-display text-lg font-semibold text-ink">{r.help.title}</h2>
        <p class="mt-1.5 text-base leading-[28px] text-body">{r.help.text}</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href={waLink} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-xl bg-live px-5 py-3 text-base font-semibold text-white transition hover:bg-[#127032] active:scale-[0.98]">
          <Icon name="message-circle" class="h-[18px] w-[18px]" />
          {dict.contact.whatsapp}
        </a>
        <a href={pageUrl(locale, "/contact")} class="inline-flex items-center gap-2 rounded-xl border border-line bg-white px-5 py-3 text-base font-semibold text-ink transition hover:bg-paper active:scale-[0.98]">{dict.nav.contact}</a>
      </div>
    </div>
  </section>
  <CtaBand dict={dict} locale={locale} />
</Layout>
