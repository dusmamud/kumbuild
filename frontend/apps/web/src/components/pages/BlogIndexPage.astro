---
import Layout from "../../layouts/Layout.astro";
import CtaBand from "../CtaBand.astro";
import { pageUrl, type Dictionary, type Locale } from "../../i18n/utils";
interface Props { dict: Dictionary; locale: Locale; }
const { dict, locale } = Astro.props;
const b = dict.v2.blog;
const fmtDate = (iso: string) =>
  new Date(`${iso}T00:00:00`).toLocaleDateString(locale === "en-US" ? "en-IN" : locale, {
    day: "numeric",
    month: "short",
    year: "numeric",
  });
---

<Layout title={b.title} description={b.subtitle} locale={locale} dict={dict} slug="/blog">
  <section class="mx-auto max-w-6xl px-4 py-12 sm:py-16">
    <div data-reveal>
      <h1 class="font-display text-[clamp(2rem,1.55rem+2.2vw,2.75rem)] font-semibold leading-[1.15] text-ink">{b.title}</h1>
      <p class="mt-3 max-w-2xl text-[15px] leading-[26px] text-body sm:text-base">{b.subtitle}</p>
    </div>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {b.posts.map((post) => (
        <a
          data-reveal
          href={pageUrl(locale, `/blog/${post.slug}`)}
          class="group flex flex-col rounded-2xl border border-line bg-white p-6 transition hover:border-primary-300"
        >
          <span class="w-fit rounded-full bg-primary-50 px-2.5 py-1 font-mono text-xs font-medium text-primary-700">{post.tag}</span>
          <h2 class="mt-4 font-display text-[clamp(1.125rem,1.02rem+0.5vw,1.25rem)] font-semibold leading-snug text-ink group-hover:text-primary-700">{post.title}</h2>
          <p class="mt-2 flex-1 text-[15px] leading-[26px] text-body">{post.excerpt}</p>
          <p class="mt-5 font-mono text-xs text-muted">{fmtDate(post.date)} · {post.readMins} {dict.v2.ui.minRead}</p>
          <span class="mt-3 inline-flex items-center gap-1.5 text-[15px] font-semibold text-primary-700">
            {dict.v2.ui.readMore}
            <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </span>
        </a>
      ))}
    </div>
  </section>
  <CtaBand dict={dict} locale={locale} />
</Layout>
