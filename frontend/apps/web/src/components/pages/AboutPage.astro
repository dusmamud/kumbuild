---
import Layout from "../../layouts/Layout.astro";
import CtaBand from "../CtaBand.astro";
import type { Dictionary, Locale } from "../../i18n/utils";
interface Props { dict: Dictionary; locale: Locale; }
const { dict, locale } = Astro.props;
const a = dict.about;
const v = dict.v2.aboutV2;
---

<Layout title={a.title} description={a.p1} locale={locale} dict={dict} slug="/about">
  <section class="mx-auto max-w-6xl px-4 py-12 sm:py-16">
    <div data-reveal class="max-w-3xl">
      <h1 class="font-display text-[clamp(2rem,1.55rem+2.2vw,2.75rem)] font-semibold leading-[1.15] text-ink">{a.title}</h1>
      <p class="mt-4 text-[15px] leading-[28px] text-body sm:text-base sm:leading-[30px]">{a.p1}</p>
      <p class="mt-3 text-[15px] leading-[28px] text-body sm:text-base sm:leading-[30px]">{a.p2}</p>
    </div>
    <dl data-reveal class="mt-12 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-line bg-line lg:grid-cols-4">
      {v.stats.map((stat) => (
        <div class="bg-white px-6 py-7">
          <dd class="font-display text-[clamp(1.875rem,1.5rem+1.6vw,2.5rem)] font-semibold leading-none tabular-nums text-ink">{stat.value}</dd>
          <dt class="mt-2.5 text-sm leading-[20px] text-muted">{stat.label}</dt>
        </div>
      ))}
    </dl>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 sm:pb-20">
    <div data-reveal class="max-w-3xl">
      <h2 class="font-display text-[clamp(1.625rem,1.28rem+1.7vw,2.125rem)] font-semibold leading-[1.2] text-ink">{v.storyTitle}</h2>
      {v.story.map((para) => (
        <p class="mt-4 text-[15px] leading-[28px] text-body sm:text-base sm:leading-[30px]">{para}</p>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 sm:pb-20">
    <h2 data-reveal class="font-display text-[clamp(1.625rem,1.28rem+1.7vw,2.125rem)] font-semibold leading-[1.2] text-ink">{v.valuesTitle}</h2>
    <div class="mt-8 grid gap-5 sm:grid-cols-2">
      {v.values.map((value) => (
        <article data-reveal class="rounded-2xl border border-line bg-white p-6 sm:p-7">
          <h3 class="font-display text-[clamp(1.125rem,1.02rem+0.5vw,1.25rem)] font-semibold leading-snug text-ink">{value.title}</h3>
          <p class="mt-2 text-[15px] leading-[26px] text-body">{value.text}</p>
        </article>
      ))}
    </div>
  </section>

  <CtaBand dict={dict} locale={locale} />
</Layout>
