---
import Layout from "../../layouts/Layout.astro";
import type { Dictionary, Locale } from "../../i18n/utils";
interface Props { dict: Dictionary; locale: Locale; }
const { dict, locale } = Astro.props;
---

<Layout title={dict.about.title} description={dict.about.p1} locale={locale} dict={dict} slug="/about">
  <section class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-2xl font-bold sm:text-3xl">{dict.about.title}</h1>
    <p class="mt-4 leading-relaxed text-body">{dict.about.p1}</p>
    <p class="mt-3 leading-relaxed text-body">{dict.about.p2}</p>
  </section>
</Layout>
