---
import Layout from "../../layouts/Layout.astro";
import CtaBand from "../CtaBand.astro";
import Icon from "../../components/Icon.astro";
import { pageUrl, type Dictionary, type Locale } from "../../i18n/utils";
interface Props { dict: Dictionary; locale: Locale; }
const { dict, locale } = Astro.props;
const a = dict.about;
const v = dict.v2.aboutV2;
const slip = dict.home.slip;
const steps = dict.how.steps;
const t = dict.v2.testimonials.items[0];
const valueIcons = ["shield-check", "smartphone", "lock", "message-circle"];
---

<Layout title={a.title} description={a.p1} locale={locale} dict={dict} slug="/about">
  {/* Hero band — who we are, the studio, and the order slip that
      signs every Kumbuild job. */}
  <section class="border-b border-line bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20">
      <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-10">
        <div data-reveal class="lg:col-span-6">
          <p class="flex items-center gap-3 text-[13px] font-semibold text-primary-700">
            <span class="h-px w-8 bg-primary-500" aria-hidden="true"></span>
            {v.eyebrow}
          </p>
          <h1 class="mt-5 font-display text-[clamp(2rem,1.6rem+2vw,3rem)] font-semibold leading-[1.15] text-ink">{a.title}</h1>
          <p class="mt-5 max-w-[520px] text-base leading-[28px] text-body sm:leading-[30px]">{a.p1}</p>
          <p class="mt-3 max-w-[520px] text-base leading-[28px] text-body sm:leading-[30px]">{a.p2}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={pageUrl(locale, "/order")} class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary-600 px-6 py-3 text-base font-semibold text-white transition-[background-color,transform] duration-200 hover:bg-primary-700 active:scale-[0.98]">
              {dict.nav.order}
              <Icon name="arrow-right" class="h-4 w-4" />
            </a>
            <a href={pageUrl(locale, "/examples")} class="inline-flex items-center justify-center rounded-xl border border-[#ddd6c9] bg-white px-6 py-3 text-base font-semibold text-primary-700 transition-[border-color,transform] duration-200 hover:border-primary-500 active:scale-[0.98]">{dict.v2.work.title}</a>
          </div>
        </div>
        <figure data-reveal class="relative lg:col-span-6">
          <img src="/about/studio.webp" alt={v.imgAlt} width="1600" height="686" loading="lazy" class="aspect-[21/9] w-full rounded-[24px] border border-line object-cover shadow-[0_32px_64px_-32px_rgba(28,25,23,0.35)] lg:aspect-[4/3]" />
          <figcaption class="mt-4 flex items-center justify-between gap-4 rounded-2xl border border-line bg-white px-5 py-4 shadow-[0_16px_32px_-20px_rgba(28,25,23,0.3)] xl:absolute xl:-bottom-6 xl:left-6 xl:mt-0 xl:w-[320px]">
            <span>
              <span class="block font-mono text-[11px] text-muted">{slip.heading} · {slip.ref}</span>
              <span class="mt-1 block text-[13px] font-medium text-ink">{slip.rows[0].k} · {slip.rows[0].v}</span>
            </span>
            <span class="flex shrink-0 items-center gap-1.5 text-[13px] font-semibold text-ink">
              <span class="h-2 w-2 animate-live-pulse rounded-full bg-live" aria-hidden="true"></span>
              {slip.status}
            </span>
          </figcaption>
        </figure>
      </div>
      <dl data-reveal class="mt-16 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-line bg-line lg:grid-cols-4">
        {v.stats.map((stat) => (
          <div class="flex flex-col bg-white px-6 py-7">
            <dt class="order-2 mt-2.5 text-sm leading-[20px] text-muted">{stat.label}</dt>
            <dd class="order-1 font-display text-[clamp(1.625rem,1.35rem+1.3vw,2.125rem)] font-semibold leading-none tabular-nums text-ink">{stat.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  {/* Story — the words on the left, the promise pulled out large. */}
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
      <div data-reveal class="lg:col-span-7">
        <h2 class="font-display text-[clamp(1.625rem,1.32rem+1.5vw,2.25rem)] font-semibold leading-[1.2] text-ink">{v.storyTitle}</h2>
        {v.story.map((para) => (
          <p class="mt-5 text-base leading-[28px] text-body sm:leading-[30px]">{para}</p>
        ))}
      </div>
      <figure data-reveal class="lg:col-span-5">
        <div class="rounded-[24px] bg-ink p-7 text-white shadow-[0_32px_56px_-28px_rgba(28,25,23,0.5)] sm:p-8 lg:sticky lg:top-24">
          <span class="font-display text-5xl leading-none text-primary-500" aria-hidden="true">&ldquo;</span>
          <blockquote class="mt-2 font-display text-[clamp(1.375rem,1.2rem+1vw,1.625rem)] font-medium leading-[1.4]">{v.pullQuote}</blockquote>
          <figcaption class="mt-6 flex items-center gap-2.5 border-t border-white/10 pt-5 font-mono text-xs text-white/60">
            <img src="/logo/kumbuild-logo.svg" alt="" width="20" height="20" class="h-5 w-5" />
            {slip.heading} · {slip.ref}
          </figcaption>
        </div>
      </figure>
    </div>
  </section>

  {/* Values — how we work, as cards. */}
  <section class="border-y border-line bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
      <h2 data-reveal class="font-display text-[clamp(1.625rem,1.32rem+1.5vw,2.25rem)] font-semibold leading-[1.2] text-ink">{v.valuesTitle}</h2>
      <div class="mt-10 grid gap-5 sm:grid-cols-2">
        {v.values.map((value, i) => (
          <article data-reveal class="rounded-2xl border border-line bg-white p-6 transition-[border-color,box-shadow,transform] duration-300 hover:-translate-y-0.5 hover:border-primary-200 hover:shadow-[0_20px_40px_-24px_rgba(28,25,23,0.3)] sm:p-7">
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-primary-50">
              <Icon name={valueIcons[i % valueIcons.length]} class="h-5 w-5 text-primary-700" />
            </span>
            <h3 class="mt-4 font-display text-[clamp(1.125rem,1.02rem+0.5vw,1.25rem)] font-semibold leading-snug text-ink">{value.title}</h3>
            <p class="mt-2 text-base leading-[28px] text-body">{value.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* Process — the same five steps as the homepage, in a strip. */}
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
    <div data-reveal class="max-w-2xl">
      <h2 class="font-display text-[clamp(1.625rem,1.32rem+1.5vw,2.25rem)] font-semibold leading-[1.2] text-ink">{v.processTitle}</h2>
      <p class="mt-3 text-base leading-[28px] text-body">{v.processText}</p>
    </div>
    <ol class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {steps.map((s, i) => (
        <li data-reveal style={`--reveal-delay:${i * 60}ms`} class="rounded-2xl border border-line bg-white p-5">
          <span class="font-mono text-[13px] font-medium text-primary-700">{String(i + 1).padStart(2, "0")}</span>
          <h3 class="mt-3 font-display text-base font-semibold text-ink">{s.title}</h3>
          <p class="mt-1.5 text-sm leading-[22px] text-body">{s.desc}</p>
        </li>
      ))}
    </ol>
  </section>

  {/* Proof — one owner, in his own words. */}
  <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6 sm:pb-24">
    <figure data-reveal class="rounded-[24px] border border-line bg-white p-7 shadow-[0_24px_48px_-28px_rgba(28,25,23,0.25)] sm:p-10">
      <span class="flex gap-1 text-primary-600" role="img" aria-label={`${t.stars} / 5`}>
        {[1, 2, 3, 4, 5].map(() => (
          <Icon name="star" class="h-5 w-5 fill-current" />
        ))}
      </span>
      <blockquote class="mt-5 max-w-3xl font-display text-[clamp(1.25rem,1.1rem+0.9vw,1.5rem)] font-medium leading-[1.5] text-ink">&ldquo;{t.text}&rdquo;</blockquote>
      <figcaption class="mt-7 flex items-center gap-3.5 border-t border-line pt-6">
        <img src={t.avatar} alt={t.name} width="96" height="96" loading="lazy" class="h-12 w-12 rounded-full object-cover" />
        <span>
          <span class="block font-display text-base font-semibold text-ink">{t.name}</span>
          <span class="block text-sm text-muted">{t.business} · {t.city}</span>
        </span>
        <a href={pageUrl(locale, "/examples")} class="ml-auto hidden items-center gap-1.5 text-base font-semibold text-primary-600 transition-colors duration-200 hover:text-primary-700 sm:inline-flex">
          {dict.v2.work.title}
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </figcaption>
    </figure>
  </section>

  <CtaBand dict={dict} locale={locale} />
</Layout>
