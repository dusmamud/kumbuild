---
import Layout from "../../layouts/Layout.astro";
import Icon from "../Icon.astro";
import { pageUrl, type Dictionary, type Locale } from "../../i18n/utils";
interface Props { dict: Dictionary; locale: Locale; slug: string; }
const { dict, locale, slug } = Astro.props;
const work = dict.v2.work;
const labels = work.caseLabels;
const idx = Math.max(0, work.projects.findIndex((p) => p.slug === slug));
const project = work.projects[idx];
const next = work.projects[(idx + 1) % work.projects.length];
const waLink = `https://wa.me/${dict.v2.contact.waNumber}?text=${encodeURIComponent(dict.v2.contact.waText)}`;
const checkIcon = '<path d="M20 6 9 17l-5-5"/>';
const chevronIcon = '<path d="m9 18 6-6-6-6"/>';
const arrowIcon = '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>';
const meta = [
  { label: labels.service, value: project.service },
  { label: labels.city, value: project.city },
  { label: labels.result, value: project.result },
];
---

<Layout title={project.name} description={project.desc} locale={locale} dict={dict} slug={`/work/${project.slug}`}>
  {/* Breadcrumb + hero */}
  <section class="mx-auto max-w-6xl px-4 pt-10 sm:pt-14" data-reveal>
    <nav aria-label="breadcrumb">
      <ol class="flex flex-wrap items-center gap-1.5 text-sm text-muted">
        <li>
          <a href={pageUrl(locale, "/examples")} class="-my-2 inline-flex min-h-[40px] items-center font-medium text-primary-600 transition-colors duration-200 hover:text-primary-700">{work.title}</a>
        </li>
        <li aria-hidden="true"><Icon name="chevron-right" class="h-4 w-4 text-faint" /></li>
        <li class="text-body" aria-current="page">{project.name}</li>
      </ol>
    </nav>
    <div class="mt-6 flex flex-wrap items-end justify-between gap-x-10 gap-y-4">
      <div>
        <h1 class="font-display text-[clamp(1.75rem,1.35rem+2.1vw,3rem)] font-semibold leading-[1.15] text-ink">{project.name}</h1>
        <p class="mt-3 font-mono text-[13px] text-muted">{project.type} · {project.city}</p>
      </div>
      <a href={pageUrl(locale, `/preview/${project.slug}`)} class="inline-flex min-h-[44px] items-center gap-1.5 rounded-xl border border-line bg-white px-5 py-3 text-base font-semibold text-ink transition duration-200 hover:bg-paper active:scale-[0.98]">
        {dict.preview.viewPreview}
        <Icon name="arrow-right" class="h-[18px] w-[18px]" />
      </a>
    </div>
    <figure class="mt-8 overflow-hidden rounded-2xl border border-line bg-white shadow-[0_16px_40px_rgba(28,25,23,0.08)]">
      <div class="flex items-center gap-1.5 border-b border-line bg-surface px-4 py-2.5">
        <span class="h-2.5 w-2.5 rounded-full bg-[#E8B4AE]" aria-hidden="true"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-[#EBD9A8]" aria-hidden="true"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-[#AED8BC]" aria-hidden="true"></span>
        <span class="ml-2 truncate rounded-md bg-white px-2.5 py-0.5 font-mono text-[12px] text-muted">{project.slug}.in</span>
      </div>
      <img src={project.img} alt={`${project.name} — ${project.type}, ${project.city}`} width="1600" height="900" class="block aspect-[16/9] w-full object-cover object-top sm:aspect-[21/10]" />
    </figure>
  </section>

  {/* Overview + meta table */}
  <section class="mx-auto max-w-6xl px-4 py-12 sm:py-14" data-reveal>
    <div class="grid gap-6 lg:grid-cols-[1fr_340px] lg:gap-10">
      <div>
        <h2 class="font-display text-[clamp(1.125rem,1.05rem+0.6vw,1.5rem)] font-semibold text-ink">{labels.overview}</h2>
        <p class="mt-4 max-w-2xl text-base leading-[28px] text-body sm:text-lg sm:leading-[30px]">{project.desc}</p>
        <h2 class="mt-10 font-display text-[clamp(1.125rem,1.05rem+0.6vw,1.5rem)] font-semibold text-ink">{labels.story}</h2>
        <p class="mt-4 max-w-2xl text-base leading-[28px] text-body">{project.story}</p>
      </div>
      <aside class="h-fit rounded-2xl border border-line bg-white p-6 sm:p-7 lg:sticky lg:top-24">
        <dl>
          {meta.map((row, i) => (
            <div class={i > 0 ? "mt-5 border-t border-line pt-5" : ""}>
              <dt class="font-mono text-[12px] font-medium uppercase tracking-wide text-muted">{row.label}</dt>
              <dd class="mt-1.5 text-base font-medium leading-[24px] text-ink">{row.value}</dd>
            </div>
          ))}
        </dl>
      </aside>
    </div>
  </section>

  {/* Deliverables */}
  <section class="border-y border-line bg-surface" data-reveal>
    <div class="mx-auto max-w-6xl px-4 py-12 sm:py-14">
      <h2 class="font-display text-[clamp(1.125rem,1.05rem+0.6vw,1.5rem)] font-semibold text-ink">{labels.deliverables}</h2>
      <ul class="mt-7 grid gap-x-10 gap-y-4 sm:grid-cols-2">
        {project.deliverables.map((d) => (
          <li class="flex gap-3 text-base leading-[26px] text-body">
            <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-lg bg-live-soft text-live">
              <Icon name="check" class="h-4 w-4" />
            </span>
            <span>{d}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* Next project */}
  <section class="mx-auto max-w-6xl px-4 py-12 sm:py-14" data-reveal>
    <a href={pageUrl(locale, `/work/${next.slug}`)} class="group flex flex-wrap items-center gap-5 rounded-2xl border border-line bg-white p-5 transition duration-300 hover:border-primary-200 hover:shadow-[0_20px_40px_-24px_rgba(28,25,23,0.3)] sm:p-6">
      <img src={next.img} alt={`${next.name} — ${next.type}, ${next.city}`} width="640" height="400" loading="lazy" class="block aspect-[8/5] w-full rounded-xl border border-line object-cover object-top sm:w-44" />
      <span class="min-w-0 flex-1">
        <span class="font-mono text-[12px] font-medium uppercase tracking-wide text-muted">{dict.v2.ui.viewCase}</span>
        <span class="mt-1 block font-display text-[clamp(1rem,1rem+0.5vw,1.375rem)] font-semibold text-ink">{next.name}</span>
        <span class="mt-1 block text-sm text-muted">{next.type} · {next.city}</span>
      </span>
      <svg class="h-5 w-5 shrink-0 text-primary-700 transition-transform duration-200 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrowIcon} />
    </a>
  </section>

  {/* CTA band */}
  <section class="mx-auto max-w-6xl px-4 pb-14 sm:pb-16" data-reveal>
    <div class="rounded-2xl border border-line bg-white p-6 sm:p-10">
      <div class="flex flex-wrap items-center justify-between gap-x-10 gap-y-6">
        <div class="max-w-xl">
          <h2 class="font-display text-[clamp(1.375rem,1.2rem+1.1vw,2rem)] font-semibold leading-[1.25] text-ink">{dict.contact.title}</h2>
          <p class="mt-2 text-base leading-[28px] text-body">{dict.contact.subtitle}</p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <a href={pageUrl(locale, "/order")} class="inline-flex items-center gap-2 rounded-xl bg-cta px-5 py-3 text-base font-semibold text-white transition duration-200 hover:bg-cta-hover active:scale-[0.98]">
            {dict.hero.ctaOrder}
            <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrowIcon} />
          </a>
          <a href={waLink} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-xl border border-line bg-white px-5 py-3 text-base font-semibold text-ink transition duration-200 hover:bg-paper active:scale-[0.98]">{dict.contact.whatsapp}</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
