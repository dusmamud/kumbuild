---
import Layout from "../../layouts/Layout.astro";
import FaqAccordion from "../react/FaqAccordion";
import type { Dictionary, Locale } from "../../i18n/utils";
interface Props { dict: Dictionary; locale: Locale; }
const { dict, locale } = Astro.props;
---

<Layout title={dict.faq.title} description={dict.faq.subtitle} locale={locale} dict={dict} slug="/faq">
  <section class="mx-auto max-w-6xl px-4 py-12">
    <h1 class="text-2xl font-extrabold sm:text-3xl">{dict.faq.title}</h1>
    <p class="mt-2 max-w-2xl text-slate-600">{dict.faq.subtitle}</p>
    <div class="mt-8">
      <FaqAccordion client:load items={dict.faq.items} />
    </div>
  </section>
</Layout>
