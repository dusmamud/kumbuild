---
import Layout from "../../layouts/Layout.astro";
import type { Dictionary, Locale } from "../../i18n/utils";
interface Props { dict: Dictionary; locale: Locale; }
const { dict, locale } = Astro.props;
---

<Layout title={dict.terms.title} description={dict.terms.intro} locale={locale} dict={dict} slug="/terms">
  <section class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-[32px] font-semibold leading-[40px]">{dict.terms.title}</h1>
    <p class="mt-4 leading-relaxed text-body">{dict.terms.intro}</p>
  </section>
</Layout>
