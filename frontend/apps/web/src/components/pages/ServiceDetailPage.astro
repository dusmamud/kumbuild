---
import Layout from "../../layouts/Layout.astro";
import { pageUrl, type Dictionary, type Locale } from "../../i18n/utils";
interface Props { dict: Dictionary; locale: Locale; slug: string; }
const { dict, locale, slug } = Astro.props;
const sv = dict.v2.servicesV2;
const item = dict.services.items.find((i) => i.slug === slug) ?? dict.services.items[0];
const page = sv.pages[slug as keyof typeof sv.pages] ?? sv.pages["business-website"];
const waLink = `https://wa.me/${dict.v2.contact.waNumber}?text=${encodeURIComponent(dict.v2.contact.waText)}`;
const orderUrl = `${pageUrl(locale, "/order")}?service=${item.slug}`;
const checkIcon = '<path d="M20 6 9 17l-5-5"/>';
const chevronIcon = '<path d="m9 18 6-6-6-6"/>';
const arrowIcon = '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>';
---

<Layout title={item.title} description={page.intro} locale={locale} dict={dict} slug={`/services/${item.slug}`}>
  {/* Breadcrumb + intro */}
  <section class="mx-auto max-w-6xl px-4 pt-10 sm:pt-14" data-reveal>
    <nav aria-label="breadcrumb" class="flex flex-wrap items-center gap-1.5 text-sm text-muted">
      <a href={pageUrl(locale, "/services")} class="font-medium text-primary-700 transition-colors duration-200 hover:text-primary-600">{dict.nav.services}</a>
      <svg class="h-4 w-4 text-faint" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={chevronIcon} />
      <span class="text-body" aria-current="page">{item.title}</span>
    </nav>
    <h1 class="mt-6 max-w-3xl font-display text-[clamp(1.875rem,1.5rem+1.9vw,2.75rem)] font-semibold leading-[1.15] text-ink">{page.h1}</h1>
    <p class="mt-4 max-w-2xl text-base leading-[28px] text-body sm:text-lg sm:leading-[30px]">{page.intro}</p>
    <p class="mt-5 flex flex-wrap items-baseline gap-x-2 text-[15px] sm:text-base">
      <span class="font-mono text-[13px] font-medium uppercase tracking-wide text-muted">{sv.detailFor}</span>
      <span class="font-medium text-primary-700">{item.for}</span>
    </p>
  </section>

  {/* Includes + order rail */}
  <section class="mx-auto max-w-6xl px-4 py-12 sm:py-14" data-reveal>
    <div class="grid gap-6 lg:grid-cols-[1fr_340px] lg:gap-10">
      <div class="rounded-2xl border border-line bg-white p-6 sm:p-8">
        <h2 class="font-display text-[clamp(1.25rem,1.12rem+0.6vw,1.5rem)] font-semibold text-ink">{sv.detailIncludes}</h2>
        <ul class="mt-6 grid gap-x-8 gap-y-4 sm:grid-cols-2">
          {page.features.map((f) => (
            <li class="flex gap-2.5 text-[15px] leading-[24px] text-body sm:text-base">
              <svg class="mt-0.5 h-[18px] w-[18px] shrink-0 text-primary-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={checkIcon} />
              <span>{f}</span>
            </li>
          ))}
        </ul>
      </div>
      <aside class="h-fit rounded-2xl border border-line bg-white p-6 sm:p-7">
        <h2 class="font-display text-lg font-semibold text-ink">{dict.pricing.title}</h2>
        <p class="mt-2 text-[15px] leading-[26px] text-body">{dict.hero.note}</p>
        <a href={orderUrl} class="mt-5 flex items-center justify-center gap-2 rounded-[10px] bg-primary-500 px-4 py-3 text-[15px] font-semibold text-white transition duration-200 hover:bg-primary-600 active:scale-[0.98]">
          {dict.nav.order}
          <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrowIcon} />
        </a>
        <a href={pageUrl(locale, "/pricing")} class="mt-4 inline-flex items-center gap-1.5 text-[15px] font-semibold text-primary-700 transition-colors duration-200 hover:text-primary-600">
          {dict.hero.ctaPricing}
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrowIcon} />
        </a>
        <p class="mt-5 border-t border-line pt-4 text-[13px] leading-[20px] text-muted">{dict.pricing.note}</p>
      </aside>
    </div>
  </section>

  {/* Process strip — the same five steps as How it works, titles only */}
  <section class="border-y border-line bg-surface" data-reveal>
    <div class="mx-auto max-w-6xl px-4 py-12 sm:py-14">
      <h2 class="font-display text-[clamp(1.25rem,1.12rem+0.6vw,1.5rem)] font-semibold text-ink">{dict.how.title}</h2>
      <ol class="mt-7 grid gap-x-8 gap-y-5 sm:grid-cols-2 lg:grid-cols-5">
        {dict.how.steps.map((step, i) => (
          <li class="flex items-baseline gap-3 border-t border-line pt-4 lg:border-t-0 lg:pt-0">
            <span class="font-mono text-sm font-medium text-primary-700">{String(i + 1).padStart(2, "0")}</span>
            <span class="text-[15px] font-medium text-ink sm:text-base">{step.title}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* CTA band */}
  <section class="mx-auto max-w-6xl px-4 py-14 sm:py-16" data-reveal>
    <div class="rounded-2xl border border-line bg-white p-6 sm:p-10">
      <div class="flex flex-wrap items-center justify-between gap-x-10 gap-y-6">
        <div class="max-w-xl">
          <h2 class="font-display text-[clamp(1.5rem,1.3rem+1vw,2rem)] font-semibold leading-[1.25] text-ink">{sv.detailCtaTitle}</h2>
          <p class="mt-2 text-[15px] leading-[26px] text-body sm:text-base">{sv.detailCtaText}</p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <a href={orderUrl} class="inline-flex items-center gap-2 rounded-[10px] bg-primary-500 px-5 py-3 text-[15px] font-semibold text-white transition duration-200 hover:bg-primary-600 active:scale-[0.98]">
            {dict.nav.order}
            <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrowIcon} />
          </a>
          <a href={waLink} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-[10px] border border-line bg-white px-5 py-3 text-[15px] font-semibold text-ink transition duration-200 hover:bg-paper active:scale-[0.98]">{dict.contact.whatsapp}</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
