---
import Layout from "../../layouts/Layout.astro";
import { pageUrl, type Dictionary, type Locale } from "../../i18n/utils";
interface Props { dict: Dictionary; locale: Locale; }
const { dict, locale } = Astro.props;
---

<Layout title={dict.contact.title} description={dict.contact.subtitle} locale={locale} dict={dict} slug="/contact">
  <section class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-2xl font-bold sm:text-3xl">{dict.contact.title}</h1>
    <p class="mt-2 text-body">{dict.contact.subtitle}</p>
    <p class="mt-2 text-sm text-muted">{dict.contact.note}</p>
    <div class="mt-8">
      <a href={pageUrl(locale, "/order")} class="rounded-lg bg-primary-500 px-6 py-3 font-bold text-white hover:bg-primary-600">{dict.nav.order}</a>
    </div>
  </section>
</Layout>
