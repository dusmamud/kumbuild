---
import Layout from "../../layouts/Layout.astro";
import Pricing from "../Pricing.astro";
import PricingTable from "../PricingTable.astro";
import TestimonialsSection from "../TestimonialsSection.astro";
import SectionHead from "../SectionHead.astro";
import CtaBand from "../CtaBand.astro";
import Icon from "../Icon.astro";
import { pageUrl, type Dictionary, type Locale } from "../../i18n/utils";
interface Props { dict: Dictionary; locale: Locale; }
const { dict, locale } = Astro.props;
const r = dict.pricing.renewal;
/* Service + offer schema (SEO audit 2026-11-22): real plans, real prices
   from the same dictionary the page renders — the two can never drift.
   Store is a separate plan, so it gets its own Offer entry. */
const offerList = dict.pricing.packages.map((p) => ({
  "@type": "Offer",
  name: p.name,
  price: Number(String(p.price).replace(/[^0-9]/g, "")),
  priceCurrency: "INR",
  itemOffered: { "@type": "Service", name: p.name },
}));
offerList.push({
  "@type": "Offer",
  name: dict.pricing.store.name,
  price: Number(String(dict.pricing.store.price).replace(/[^0-9]/g, "")),
  priceCurrency: "INR",
  itemOffered: { "@type": "Service", name: dict.pricing.store.name },
});
const pricingSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Website design and development",
  serviceType: "Website design and development",
  provider: { "@id": "https://kumbuild.com/#org" },
  areaServed: "Worldwide",
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Website plans",
    itemListElement: offerList,
  },
};
const s = dict.pricing.store;
const a = dict.pricing.addons;
const w = dict.pricing.whoFor;
const x = dict.pricing.exclusions;
const rc = dict.pricing.runningCosts;
---

<Layout title={dict.meta.pricing.t} description={dict.meta.pricing.d} locale={locale} dict={dict} slug="/pricing" extraSchema={pricingSchema}>
  <section class="mx-auto max-w-6xl px-4 pt-10 sm:px-6 sm:pt-14">
    <h1 class="max-w-2xl font-display text-[clamp(1.75rem,1.35rem+2.1vw,3rem)] font-semibold leading-[1.15] text-ink">{dict.pricing.title}</h1>
    <p class="mt-4 max-w-2xl text-base leading-[28px] text-body">{dict.pricing.subtitle}</p>
  </section>
  <Pricing dict={dict} locale={locale} hideHead showRenewal={false} />
  {/* Honesty note (from the pricing doc): features that depend on systems
      still being set up are included in the plan, not presented as live. */}
  <p class="mx-auto max-w-6xl px-4 pb-2 text-[13px] leading-[20px] text-muted sm:px-6">{dict.pricing.honestyNote}</p>
  <div class="mx-auto max-w-6xl px-4 pb-10 sm:px-6">
    <SectionHead title={dict.v2.pricingTable.title} subtitle={dict.v2.pricingTable.subtitle} />
  </div>
  <PricingTable dict={dict} locale={locale} />
  {/* What is included + renewal explained in words (SEO audit 2026-11-22):
      the table compares plans, but the inclusions and the renewal logic
      were nowhere in text a searcher (or a careful buyer) could read. */}
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <h2 class="font-display text-[clamp(1.5rem,1.2rem+1.4vw,2.25rem)] font-semibold leading-[1.2] text-ink">{dict.pricing.extra.heading}</h2>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {dict.pricing.extra.items.map((item) => (
        <li class="flex gap-3 rounded-2xl border border-line bg-white p-5 text-[15px] leading-[26px] text-body">
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-primary-50 text-primary-700"><Icon name="check" class="h-4 w-4" /></span>
          <span>{item}</span>
        </li>
      ))}
    </ul>
    <h2 class="mt-12 font-display text-[clamp(1.5rem,1.2rem+1.4vw,2.25rem)] font-semibold leading-[1.2] text-ink">{dict.pricing.extra.renewalTitle}</h2>
    <p class="mt-3 max-w-3xl text-base leading-[28px] text-body">{dict.pricing.extra.renewalText}</p>
  </section>
  {/* Store plan — a separate plan, not a fourth card in the 3-plan grid. */}
  <section class="mx-auto max-w-6xl px-4 pb-12 sm:px-6">
    <div data-reveal class="rounded-2xl border border-primary-500 bg-white p-6 shadow-[0_20px_40px_-24px_rgba(28,25,23,0.3)] sm:p-8">
      <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
        <div>
          <h2 class="font-display text-[clamp(1.5rem,1.2rem+1.4vw,2.25rem)] font-semibold leading-[1.2] text-ink">{s.title}</h2>
          <p class="mt-2 max-w-2xl text-base leading-[28px] text-body">{s.subtitle}</p>
        </div>
        <p class="font-display text-[clamp(1.75rem,1.45rem+1.4vw,2.5rem)] font-semibold leading-none tabular-nums text-ink">{s.price} <span class="font-sans text-sm font-medium text-muted">/ {s.per}</span></p>
      </div>
      <p class="mt-4 text-base leading-[28px] text-body"><span class="font-semibold text-ink">{s.name}</span> — {s.bestFor}</p>
      <ul class="mt-6 grid gap-x-8 gap-y-2.5 sm:grid-cols-2">
        {s.features.map((f) => (
          <li class="flex gap-2.5 text-base text-body">
            <Icon name="check" class="mt-0.5 h-[18px] w-[18px] shrink-0 text-primary-600" />
            <span>{f}</span>
          </li>
        ))}
      </ul>
      <div class="mt-7 flex flex-wrap items-center gap-4">
        <a href={pageUrl(locale, "/order")} class="inline-block rounded-xl bg-cta px-5 py-3 text-base font-semibold text-white transition hover:bg-cta-hover active:scale-[0.98]">{s.cta}</a>
        <p class="text-sm leading-[22px] text-muted">{s.note}</p>
      </div>
    </div>
  </section>
  {/* Add-ons — every add-on from the pricing doc, with its price. */}
  <section class="mx-auto max-w-6xl px-4 pb-12 sm:px-6">
    <SectionHead title={a.title} subtitle={a.subtitle} />
    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {a.items.map((item) => (
        <li class="rounded-2xl border border-line bg-white p-5">
          <div class="flex items-baseline justify-between gap-3">
            <h3 class="text-base font-semibold text-ink">{item.name}</h3>
            <span class="shrink-0 font-display text-base font-semibold tabular-nums text-primary-700">{item.price}</span>
          </div>
          {item.desc && <p class="mt-2 text-[15px] leading-[26px] text-body">{item.desc}</p>}
        </li>
      ))}
    </ul>
  </section>
  {/* Which plan is for whom — the customer-type map from the pricing doc. */}
  <section class="mx-auto max-w-6xl px-4 pb-12 sm:px-6">
    <SectionHead title={w.title} subtitle={w.subtitle} />
    <div data-reveal class="mt-8 overflow-x-auto rounded-2xl border border-line bg-white" data-lenis-prevent>
      <table class="w-full min-w-[560px] border-collapse text-left">
        <tbody>
          {w.items.map((row) => (
            <tr class="border-b border-line last:border-b-0">
              <th scope="row" class="px-5 py-3.5 text-base font-semibold text-ink sm:px-6">{row.who}</th>
              <td class="px-4 py-3.5"><span class="inline-block rounded-full bg-primary-50 px-3 py-1 text-sm font-semibold text-primary-700">{row.plan}</span></td>
              <td class="px-5 py-3.5 text-base text-body sm:px-6">{row.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
  {/* Exclusions — what the plans deliberately do not cover, and why. */}
  <section class="mx-auto max-w-6xl px-4 pb-12 sm:px-6">
    <SectionHead title={x.title} subtitle={x.subtitle} />
    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {x.items.map((item) => (
        <li class="rounded-2xl border border-line bg-white p-5">
          <h3 class="text-base font-semibold text-ink">{item.name}</h3>
          <p class="mt-2 text-[15px] leading-[26px] text-body">{item.why}</p>
        </li>
      ))}
    </ul>
  </section>
  {/* Running costs — the Model A explainer, in short, clear form. */}
  <section class="mx-auto max-w-6xl px-4 pb-12 sm:px-6">
    <SectionHead title={rc.title} subtitle={rc.intro} />
    <dl class="mt-8 space-y-5">
      {rc.items.map((item) => (
        <div class="rounded-2xl border border-line bg-white p-5 sm:p-6">
          <dt class="text-base font-semibold text-ink">{item.name}</dt>
          <dd class="mt-1.5 text-base leading-[28px] text-body">{item.text}</dd>
        </div>
      ))}
    </dl>
    <div class="mt-6 rounded-2xl border border-line bg-surface p-5 sm:p-6">
      <p class="text-base leading-[28px] text-body">{rc.careNote}</p>
    </div>
  </section>
  {/* Social proof right after the comparison, at the moment of decision:
      the same testimonials that sit above pricing on the home page. */}
  <TestimonialsSection dict={dict} />
  <section class="mx-auto max-w-6xl px-4 pb-12 sm:pb-16">
    <div data-reveal class="grid items-center gap-6 rounded-2xl border border-line bg-surface px-6 py-8 sm:px-8 lg:grid-cols-[auto_1fr_auto] lg:gap-10">
      <span class="flex h-12 w-12 items-center justify-center rounded-full bg-white text-primary-700">
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 0 1 15.36-6.36L21 8" /><path d="M21 3v5h-5" /><path d="M21 12a9 9 0 0 1-15.36 6.36L3 16" /><path d="M3 21v-5h5" /></svg>
      </span>
      <div>
        <h2 class="font-display text-[clamp(1.125rem,1.05rem+0.7vw,1.5rem)] font-semibold leading-snug text-ink">{r.title}</h2>
        <p class="mt-1.5 max-w-2xl text-base leading-[28px] text-body">{r.desc}</p>
        <a href={pageUrl(locale, "/maintenance")} class="mt-2 inline-flex min-h-[44px] items-center gap-1.5 text-base font-semibold text-primary-600 transition-colors duration-200 hover:text-primary-700">{r.link} →</a>
      </div>
      <p class="font-display text-[clamp(1.375rem,1.2rem+1vw,1.875rem)] font-semibold tabular-nums text-ink">{r.price} <span class="font-sans text-sm font-medium text-muted">/ {r.per}</span></p>
    </div>
  </section>
  <CtaBand dict={dict} locale={locale} />
</Layout>
