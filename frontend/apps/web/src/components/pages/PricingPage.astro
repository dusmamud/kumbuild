---
import Layout from "../../layouts/Layout.astro";
import Pricing from "../Pricing.astro";
import PricingTable from "../PricingTable.astro";
import TestimonialsSection from "../TestimonialsSection.astro";
import SectionHead from "../SectionHead.astro";
import CtaBand from "../CtaBand.astro";
import { pageUrl, type Dictionary, type Locale } from "../../i18n/utils";
interface Props { dict: Dictionary; locale: Locale; }
const { dict, locale } = Astro.props;
const r = dict.pricing.renewal;
---

<Layout title={dict.pricing.title} description={dict.pricing.subtitle} locale={locale} dict={dict} slug="/pricing">
  <section class="mx-auto max-w-6xl px-4 pt-10 sm:px-6 sm:pt-14">
    <h1 class="max-w-2xl font-display text-[clamp(1.75rem,1.35rem+2.1vw,3rem)] font-semibold leading-[1.15] text-ink">{dict.pricing.title}</h1>
    <p class="mt-4 max-w-2xl text-base leading-[28px] text-body">{dict.pricing.subtitle}</p>
  </section>
  <Pricing dict={dict} locale={locale} hideHead showRenewal={false} />
  <div class="mx-auto max-w-6xl px-4 pb-10 sm:px-6">
    <SectionHead title={dict.v2.pricingTable.title} subtitle={dict.v2.pricingTable.subtitle} />
  </div>
  <PricingTable dict={dict} locale={locale} />
  {/* Social proof right after the comparison, at the moment of decision:
      the same testimonials that sit above pricing on the home page. */}
  <TestimonialsSection dict={dict} />
  <section class="mx-auto max-w-6xl px-4 pb-12 sm:pb-16">
    <div data-reveal class="grid items-center gap-6 rounded-2xl border border-line bg-surface px-6 py-8 sm:px-8 lg:grid-cols-[auto_1fr_auto] lg:gap-10">
      <span class="flex h-12 w-12 items-center justify-center rounded-full bg-white text-primary-700">
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 0 1 15.36-6.36L21 8" /><path d="M21 3v5h-5" /><path d="M21 12a9 9 0 0 1-15.36 6.36L3 16" /><path d="M3 21v-5h5" /></svg>
      </span>
      <div>
        <h2 class="font-display text-[clamp(1.125rem,1.05rem+0.7vw,1.5rem)] font-semibold leading-snug text-ink">{r.title}</h2>
        <p class="mt-1.5 max-w-2xl text-base leading-[28px] text-body">{r.desc}</p>
        <a href={pageUrl(locale, "/maintenance")} class="mt-2 inline-flex min-h-[44px] items-center gap-1.5 text-base font-semibold text-primary-600 transition-colors duration-200 hover:text-primary-700">{dict.common.learnMore} →</a>
      </div>
      <p class="font-display text-[clamp(1.375rem,1.2rem+1vw,1.875rem)] font-semibold tabular-nums text-ink">{r.price} <span class="font-sans text-sm font-medium text-muted">/ {r.per}</span></p>
    </div>
  </section>
  <CtaBand dict={dict} locale={locale} />
</Layout>
