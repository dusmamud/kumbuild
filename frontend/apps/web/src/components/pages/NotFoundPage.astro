---
import Layout from "../../layouts/Layout.astro";
import Icon from "../Icon.astro";
import { pageUrl, type Dictionary, type Locale } from "../../i18n/utils";
interface Props { dict: Dictionary; locale: Locale; }
const { dict, locale } = Astro.props;
const nf = dict.v2.notFound;
---

<Layout title={nf.title} description={nf.text} locale={locale} dict={dict} slug="/">
  <section class="mx-auto max-w-6xl px-4 py-20 sm:py-28">
    <div class="mx-auto max-w-xl text-center">
      <p class="font-mono text-sm font-medium text-primary-700">404</p>
      <h1 class="mt-3 font-display text-[clamp(2rem,1.6rem+2vw,3rem)] font-semibold leading-[1.15] text-ink">{nf.title}</h1>
      <p class="mt-4 text-base leading-[28px] text-body">{nf.text}</p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href={pageUrl(locale, "/")} class="inline-flex items-center justify-center gap-2 rounded-xl border border-line bg-white px-6 py-3.5 text-base font-semibold text-ink transition hover:bg-paper active:scale-[0.98]">{nf.home}</a>
        <a href={pageUrl(locale, "/order")} class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary-600 px-6 py-3.5 text-base font-semibold text-white transition hover:bg-primary-700 active:scale-[0.98]">
          {dict.hero.ctaOrder}
          <Icon name="arrow-right" class="h-[18px] w-[18px]" />
        </a>
      </div>
    </div>
  </section>
</Layout>
