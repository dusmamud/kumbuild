---
import Layout from "../../layouts/Layout.astro";
import Icon from "../Icon.astro";
import CtaBand from "../CtaBand.astro";
import { pageUrl, type Dictionary, type Locale } from "../../i18n/utils";
interface Props { dict: Dictionary; locale: Locale; slug?: string; }
const { dict, locale, slug = "/examples" } = Astro.props;
const work = dict.v2.work;
---

<Layout title={work.title} description={work.subtitle} locale={locale} dict={dict} slug={slug}>
  <section class="mx-auto max-w-6xl px-4 pt-10 pb-14 sm:pt-14 sm:pb-16" data-reveal>
    <h1 class="max-w-2xl font-display text-[clamp(1.75rem,1.35rem+2.1vw,3rem)] font-semibold leading-[1.15] text-ink">{work.title}</h1>
    <p class="mt-4 max-w-2xl text-base leading-[28px] text-body sm:text-lg sm:leading-[30px]">{work.subtitle}</p>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {work.projects.map((p) => (
        <a
          href={pageUrl(locale, `/work/${p.slug}`)}
          class="group flex flex-col overflow-hidden rounded-2xl border border-line bg-white transition-[border-color,box-shadow,transform] duration-300 hover:-translate-y-1 hover:border-primary-200 hover:shadow-[0_20px_40px_-24px_rgba(28,25,23,0.3)]"
        >
          <span class="flex items-center gap-1.5 border-b border-line bg-surface px-4 py-2.5">
            <span class="h-2.5 w-2.5 rounded-full bg-[#E8B4AE]" aria-hidden="true"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-[#EBD9A8]" aria-hidden="true"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-[#AED8BC]" aria-hidden="true"></span>
            <span class="ml-2 truncate rounded-md bg-white px-2.5 py-0.5 font-mono text-[12px] text-muted">{p.slug}.in</span>
          </span>
          <span class="block overflow-hidden">
            <img src={p.img} alt={`${p.name} — ${p.type}, ${p.city}`} width="1280" height="800" loading="lazy" class="block aspect-[8/5] w-full object-cover object-top transition duration-500 group-hover:scale-[1.03]" />
          </span>
          <span class="flex flex-1 flex-col p-6">
            <span class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <span class="font-display text-[clamp(1rem,1rem+0.5vw,1.375rem)] font-semibold text-ink">{p.name}</span>
              <span class="font-mono text-[12px] text-muted">{p.type} · {p.city}</span>
            </span>
            <span class="mt-2.5 flex-1 text-base leading-[28px] text-body">{p.desc}</span>
            <span class="mt-4 flex items-center gap-2 text-base font-medium text-ink">
              <Icon name="trending-up" class="h-[18px] w-[18px] shrink-0 text-live" />
              {p.result}
            </span>
            <span class="mt-5 inline-flex items-center gap-1.5 border-t border-line pt-4 text-base font-semibold text-primary-700">
              {dict.v2.ui.viewCase}
              <Icon name="arrow-right" class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5" />
            </span>
          </span>
        </a>
      ))}
    </div>
  </section>
  <CtaBand dict={dict} locale={locale} />
</Layout>
