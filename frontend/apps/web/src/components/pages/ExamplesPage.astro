---
import Layout from "../../layouts/Layout.astro";
import { pageUrl, type Dictionary, type Locale } from "../../i18n/utils";
interface Props { dict: Dictionary; locale: Locale; }
const { dict, locale } = Astro.props;
const work = dict.v2.work;
const trendIcon = '<path d="M16 7h6v6"/><path d="m22 7-8.5 8.5-5-5L2 17"/>';
const arrowIcon = '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>';
---

<Layout title={work.title} description={work.subtitle} locale={locale} dict={dict} slug="/examples">
  <section class="mx-auto max-w-6xl px-4 pt-10 pb-14 sm:pt-14 sm:pb-16" data-reveal>
    <h1 class="max-w-2xl font-display text-[clamp(1.875rem,1.5rem+1.9vw,2.75rem)] font-semibold leading-[1.15] text-ink">{work.title}</h1>
    <p class="mt-4 max-w-2xl text-base leading-[28px] text-body sm:text-lg sm:leading-[30px]">{work.subtitle}</p>
    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      {work.projects.map((p) => (
        <article class="group flex flex-col overflow-hidden rounded-2xl border border-line bg-white transition duration-200 hover:border-primary-500">
          <a href={pageUrl(locale, `/work/${p.slug}`)} class="block">
            <img src={p.img} alt={p.name} width="1280" height="800" loading="lazy" class="block aspect-[8/5] w-full object-cover object-top" />
          </a>
          <div class="flex flex-1 flex-col p-6">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h2 class="font-display text-[clamp(1.125rem,1.05rem+0.4vw,1.375rem)] font-semibold text-ink">{p.name}</h2>
              <p class="font-mono text-[12px] text-muted">{p.type} · {p.city}</p>
            </div>
            <p class="mt-2.5 flex-1 text-[15px] leading-[26px] text-body sm:text-base">{p.desc}</p>
            <p class="mt-4 flex items-center gap-2 text-sm font-medium text-ink">
              <svg class="h-[18px] w-[18px] shrink-0 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={trendIcon} />
              {p.result}
            </p>
            <a href={pageUrl(locale, `/work/${p.slug}`)} class="mt-5 inline-flex items-center gap-1.5 border-t border-line pt-4 text-[15px] font-semibold text-primary-700 transition-colors duration-200 hover:text-primary-600">
              {dict.v2.ui.viewCase}
              <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrowIcon} />
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>
