---
import Layout from "../../layouts/Layout.astro";
import OrderForm from "../react/OrderForm";
import { pageUrl, type Dictionary, type Locale } from "../../i18n/utils";
interface Props { dict: Dictionary; locale: Locale; }
const { dict, locale } = Astro.props;
const o = dict.order;
/* "What happens next" — the first, middle and last steps of the real
   5-step flow: tell us, see a preview, approve and go live. */
const nextSteps = [dict.how.steps[0], dict.how.steps[2], dict.how.steps[3]];
const waLink = `https://wa.me/${dict.v2.contact.waNumber}?text=${encodeURIComponent(dict.v2.contact.waText)}`;
---

<Layout title={dict.order.title} description={dict.order.subtitle} locale={locale} dict={dict} slug="/order">
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20">
    <h1 class="max-w-2xl font-display text-[clamp(1.75rem,1.35rem+2.1vw,3rem)] font-semibold leading-[1.15] text-ink">{dict.order.title}</h1>
    <p class="mt-3 max-w-2xl text-base leading-[28px] text-body">{dict.order.subtitle}</p>
    <div class="mt-8 grid items-start gap-10 lg:grid-cols-[1fr_360px]">
      <OrderForm client:load dict={dict} locale={locale} />
      {/* Order summary — Stripe's checkout rule: the summary lives in a
          persistent side column on desktop, so the buyer always sees
          what they are getting, what it costs and what happens next. */}
      <aside class="space-y-5 lg:sticky lg:top-24" aria-label={o.summaryTitle}>
        <div class="rounded-2xl border border-line bg-white p-6">
          <h2 class="font-display text-lg font-semibold text-ink">{o.summaryTitle}</h2>
          <ul class="mt-4 space-y-3">
            {dict.pricing.packages.map((pkg) => (
              <li class="flex items-baseline justify-between gap-4 border-b border-dashed border-line pb-3 text-[15px] last:border-b-0 last:pb-0">
                <span class="font-medium text-body">
                  {pkg.name}
                  {pkg.slug === "business" && (
                    <span class="ml-2 rounded-full bg-primary-50 px-2 py-0.5 text-xs font-semibold text-primary-700">{dict.v2.ui.popular}</span>
                  )}
                </span>
                <span class="shrink-0 font-display font-semibold tabular-nums text-ink">{pkg.price}</span>
              </li>
            ))}
          </ul>
          <p class="mt-4 text-sm leading-[22px] text-muted">{dict.pricing.terms}</p>
        </div>
        <div class="rounded-2xl border border-line bg-surface p-6">
          <h2 class="font-display text-lg font-semibold text-ink">{o.summarySteps}</h2>
          <ol class="mt-4 space-y-4">
            {nextSteps.map((step, i) => (
              <li class="flex gap-3">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-line bg-white font-mono text-[13px] font-semibold text-primary-700">{i + 1}</span>
                <span>
                  <span class="block text-[15px] font-semibold text-ink">{step.title}</span>
                  <span class="mt-0.5 block text-sm leading-[22px] text-body">{step.desc}</span>
                </span>
              </li>
            ))}
          </ol>
          <a href={waLink} target="_blank" rel="noopener" class="mt-5 flex items-center justify-center gap-2 rounded-xl border border-line bg-white px-4 py-3 text-[15px] font-semibold text-ink transition-colors duration-200 hover:bg-paper">
            {dict.contact.whatsapp}
          </a>
        </div>
      </aside>
    </div>
  </section>
</Layout>
