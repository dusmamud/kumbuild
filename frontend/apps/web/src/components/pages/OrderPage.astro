---
import Layout from "../../layouts/Layout.astro";
import OrderForm from "../react/OrderForm";
import type { Dictionary, Locale } from "../../i18n/utils";
interface Props { dict: Dictionary; locale: Locale; }
const { dict, locale } = Astro.props;
---

<Layout title={dict.order.title} description={dict.order.subtitle} locale={locale} dict={dict} slug="/order">
  <section class="mx-auto max-w-3xl px-4 py-14 sm:py-20">
    <h1 class="font-display text-[clamp(2rem,1.6rem+2vw,3rem)] font-semibold leading-[1.15] text-ink">{dict.order.title}</h1>
    <p class="mt-3 text-base leading-[28px] text-body">{dict.order.subtitle}</p>
    <div class="mt-8">
      <OrderForm client:load dict={dict} locale={locale} />
    </div>
  </section>
</Layout>
