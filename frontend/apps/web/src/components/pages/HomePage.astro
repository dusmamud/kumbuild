---
import Layout from "../../layouts/Layout.astro";
import Hero from "../Hero.astro";
import Marquee from "../Marquee.astro";
import StatsBand from "../StatsBand.astro";
import WhoItsFor from "../WhoItsFor.astro";
import Services from "../Services.astro";
import Industries from "../Industries.astro";
import Band from "../Band.astro";
import Included from "../Included.astro";
import HowItWorks from "../HowItWorks.astro";
import WorkFeatured from "../WorkFeatured.astro";
import Comparison from "../Comparison.astro";
import Pricing from "../Pricing.astro";
import TestimonialsSection from "../TestimonialsSection.astro";
import FaqSection from "../FaqSection.astro";
import { pageUrl, type Dictionary, type Locale } from "../../i18n/utils";
interface Props { dict: Dictionary; locale: Locale; }
const { dict, locale } = Astro.props;
const v2 = dict.v2;
---

<Layout title={dict.hero.title} description={dict.hero.subtitle} locale={locale} dict={dict} slug="/">
  <Hero dict={dict} locale={locale} />
  <Marquee dict={dict} />
  <div class="pt-14 sm:pt-16">
    <StatsBand dict={dict} />
  </div>
  <div data-reveal>
    <WhoItsFor dict={dict} no="01" />
  </div>
  <Services dict={dict} locale={locale} no="02" />
  <Industries dict={dict} no="03" />
  <Band dict={dict} />
  <div data-reveal>
    <HowItWorks dict={dict} no="04" />
  </div>
  <WorkFeatured dict={dict} locale={locale} no="05" />
  <div data-reveal>
    <Included dict={dict} no="06" />
  </div>
  <Comparison dict={dict} no="07" />
  <Pricing dict={dict} locale={locale} no="08" />
  <TestimonialsSection dict={dict} no="09" />
  <div data-reveal>
    <FaqSection dict={dict} limit={5} no="10" />
  </div>
  <section class="mx-auto max-w-6xl px-4 pb-24 sm:px-6">
    <div data-reveal class="grid items-center gap-8 rounded-[20px] bg-ink px-6 py-12 sm:px-10 lg:grid-cols-[1fr_auto]">
      <div>
        <p class="font-mono text-xs text-primary-300">{dict.home.slip.heading} · {dict.home.slip.ref}</p>
        <h2 class="mt-3 text-[clamp(1.75rem,1.4rem+1.7vw,2.25rem)] font-semibold leading-[1.2] text-white">{v2.homeV2.ctaTitle}</h2>
        <p class="mt-3 max-w-xl text-base leading-[28px] text-white/70">{v2.homeV2.ctaText}</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
        <a href={pageUrl(locale, "/order")} class="rounded-xl bg-primary-500 px-7 py-4 text-center text-base font-semibold text-white transition-[background-color,transform] duration-200 hover:bg-primary-600 active:scale-[0.98]">{dict.hero.ctaOrder}</a>
        <a href={pageUrl(locale, "/pricing")} class="rounded-xl border border-white/25 px-7 py-4 text-center text-base font-semibold text-white transition-colors duration-200 hover:border-white/60">{dict.hero.ctaPricing}</a>
      </div>
    </div>
  </section>
</Layout>
