---
import Layout from "../../layouts/Layout.astro";
import Hero from "../Hero.astro";
import Marquee from "../Marquee.astro";
import StatsBand from "../StatsBand.astro";
import WhoItsFor from "../WhoItsFor.astro";
import Services from "../Services.astro";
import Industries from "../Industries.astro";
import Band from "../Band.astro";
import Included from "../Included.astro";
import HowItWorks from "../HowItWorks.astro";
import WorkFeatured from "../WorkFeatured.astro";
import Comparison from "../Comparison.astro";
import Pricing from "../Pricing.astro";
import TestimonialsSection from "../TestimonialsSection.astro";
import FaqSection from "../FaqSection.astro";
import Icon from "../Icon.astro";
import { pageUrl, type Dictionary, type Locale } from "../../i18n/utils";
interface Props { dict: Dictionary; locale: Locale; }
const { dict, locale } = Astro.props;
const v2 = dict.v2;
const slip = dict.home.slip;
const waLink = `https://wa.me/${v2.contact.waNumber}?text=${encodeURIComponent(v2.contact.waText)}`;
/* Trust chips under the CTA copy: preview time, advance, revisions —
   the three facts a shop owner actually asks about first. */
const chips = [
  { icon: "clock", text: slip.rows[2].v },
  { icon: "wallet", text: slip.rows[1].v },
  { icon: "refresh-cw", text: slip.rows[3].v },
];
---

<Layout title={dict.hero.title} description={dict.hero.subtitle} locale={locale} dict={dict} slug="/">
  <Hero dict={dict} locale={locale} />
  <Marquee dict={dict} />
  <StatsBand dict={dict} />
  <div data-reveal>
    <WhoItsFor dict={dict} />
  </div>
  <Services dict={dict} locale={locale} />
  <Industries dict={dict} locale={locale} />
  <Band dict={dict} />
  <div data-reveal>
    <HowItWorks dict={dict} />
  </div>
  <WorkFeatured dict={dict} locale={locale} />
  <div data-reveal>
    <Included dict={dict} />
  </div>
  <Comparison dict={dict} />
  <Pricing dict={dict} locale={locale} />
  <TestimonialsSection dict={dict} />
  <div data-reveal>
    <FaqSection dict={dict} limit={5} />
  </div>
  <section class="mx-auto max-w-6xl px-4 pb-24 sm:px-6">
    <div data-reveal class="relative overflow-hidden rounded-[24px] bg-ink px-6 py-10 sm:px-10 sm:py-12">
      {/* faint paper-dot texture, kept under the content */}
      <div class="pointer-events-none absolute inset-0" style="background-image: radial-gradient(rgba(255,255,255,0.05) 1px, transparent 1.5px); background-size: 22px 22px;" aria-hidden="true"></div>
      <div class="relative grid items-center gap-10 lg:grid-cols-[1.08fr_0.92fr] lg:gap-14">
        <div>
          <p class="font-mono text-xs text-primary-300">{slip.heading} · {slip.ref}</p>
          <h2 class="mt-3 text-[clamp(1.625rem,1.35rem+1.5vw,2.125rem)] font-semibold leading-[1.18] text-white">{v2.homeV2.ctaTitle}</h2>
          <p class="mt-3 max-w-xl text-base leading-[28px] text-white/70">{v2.homeV2.ctaText}</p>
          <ul class="mt-6 flex flex-wrap gap-2.5">
            {chips.map((c) => (
              <li class="flex items-center gap-2 rounded-full border border-white/15 px-3.5 py-1.5 text-[13px] font-medium text-white/85">
                <Icon name={c.icon} class="h-4 w-4 text-primary-300" />
                {c.text}
              </li>
            ))}
          </ul>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
            <a href={pageUrl(locale, "/order")} class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary-600 px-7 py-3.5 text-base font-semibold text-white transition-[background-color,transform] duration-200 hover:bg-primary-700 active:scale-[0.98]">
              {dict.hero.ctaOrder}
              <Icon name="arrow-right" class="h-[18px] w-[18px]" />
            </a>
            <a href={waLink} target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/25 px-7 py-3.5 text-base font-semibold text-white transition-[border-color,transform] duration-200 hover:border-white/60 active:scale-[0.98]">
              <Icon name="message-circle" class="h-[18px] w-[18px]" />
              {dict.contact.whatsapp}
            </a>
          </div>
          <a href={pageUrl(locale, "/pricing")} class="mt-5 inline-block text-sm font-medium text-white/60 underline decoration-white/30 underline-offset-4 transition-colors duration-200 hover:text-white/90">{dict.hero.ctaPricing}</a>
        </div>

        {/* The signature: a paper order slip, the way an order actually
            arrives at a shop counter — package, advance, preview, status. */}
        <div data-reveal style="--reveal-delay:120ms" class="relative mx-auto w-full max-w-[380px] lg:-rotate-2">
          <div class="rounded-2xl bg-white p-6 text-ink shadow-[0_32px_64px_-24px_rgba(0,0,0,0.55)]">
            <div class="flex items-center justify-between gap-3">
              <span class="flex items-center gap-2 font-display text-base font-semibold">
                <img src="/logo/kumbuild-logo.svg" alt="" width="24" height="24" class="h-6 w-6" />
                {slip.heading}
              </span>
              <span class="font-mono text-xs text-muted">{slip.ref}</span>
            </div>
            <p class="mt-1.5 text-sm text-muted">{slip.business}</p>
            <div class="mt-4">
              {slip.rows.map((r) => (
                <div class="flex items-baseline justify-between gap-4 border-t border-dashed border-line py-2.5 text-[15px]">
                  <span class="text-muted">{r.k}</span>
                  <span class="text-right font-semibold">{r.v}</span>
                </div>
              ))}
            </div>
            <div class="mt-3 flex items-center justify-between border-t border-line pt-4">
              <span class="flex items-center gap-2 text-sm font-semibold text-live">
                <span class="h-2 w-2 animate-live-pulse rounded-full bg-live" aria-hidden="true"></span>
                {slip.status}
              </span>
              <span class="text-right">
                <span class="block font-mono text-[11px] uppercase tracking-wide text-muted">{v2.ui.from}</span>
                <span class="font-display text-lg font-semibold">{dict.pricing.packages[0].price}</span>
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
