---
import Layout from "../../layouts/Layout.astro";
import Hero from "../Hero.astro";
import Services from "../Services.astro";
import HowItWorks from "../HowItWorks.astro";
import Pricing from "../Pricing.astro";
import Examples from "../Examples.astro";
import FaqSection from "../FaqSection.astro";
import { pageUrl, type Dictionary, type Locale } from "../../i18n/utils";
interface Props { dict: Dictionary; locale: Locale; }
const { dict, locale } = Astro.props;
---

<Layout title={dict.hero.title} description={dict.hero.subtitle} locale={locale} dict={dict} slug="/">
  <Hero dict={dict} locale={locale} />
  <Services dict={dict} />
  <HowItWorks dict={dict} />
  <Pricing dict={dict} locale={locale} />
  <Examples dict={dict} />
  <FaqSection dict={dict} limit={5} />
  <section class="mx-auto max-w-6xl px-4 pb-16">
    <div class="rounded-2xl bg-primary-700 px-6 py-10 text-center text-white">
      <h2 class="text-2xl font-bold text-white">{dict.hero.title}</h2>
      <p class="mx-auto mt-2 max-w-xl text-white">{dict.hero.subtitle}</p>
      <a href={pageUrl(locale, "/order")} class="mt-6 inline-block rounded-lg bg-white px-6 py-3 font-bold text-primary-700">{dict.hero.ctaOrder}</a>
    </div>
  </section>
</Layout>
