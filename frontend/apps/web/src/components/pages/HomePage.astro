---
import Layout from "../../layouts/Layout.astro";
import Hero from "../Hero.astro";
import Marquee from "../Marquee.astro";
import WhoItsFor from "../WhoItsFor.astro";
import Services from "../Services.astro";
import Band from "../Band.astro";
import Included from "../Included.astro";
import HowItWorks from "../HowItWorks.astro";
import WorkFeatured from "../WorkFeatured.astro";
import Pricing from "../Pricing.astro";
import TestimonialsSection from "../TestimonialsSection.astro";
import FaqSection from "../FaqSection.astro";
import { pageUrl, type Dictionary, type Locale } from "../../i18n/utils";
interface Props { dict: Dictionary; locale: Locale; }
const { dict, locale } = Astro.props;
const v2 = dict.v2;
---

<Layout title={dict.hero.title} description={dict.hero.subtitle} locale={locale} dict={dict} slug="/">
  <Hero dict={dict} locale={locale} />
  <Marquee dict={dict} />
  <div data-reveal>
    <WhoItsFor dict={dict} no="01" />
  </div>
  <Services dict={dict} locale={locale} no="02" />
  <Band dict={dict} />
  <div data-reveal>
    <HowItWorks dict={dict} no="03" />
  </div>
  <WorkFeatured dict={dict} locale={locale} no="04" />
  <div data-reveal>
    <Included dict={dict} no="05" />
  </div>
  <Pricing dict={dict} locale={locale} no="06" />
  <TestimonialsSection dict={dict} no="07" />
  <div data-reveal>
    <FaqSection dict={dict} limit={5} no="08" />
  </div>
  <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6">
    <div data-reveal class="grid items-center gap-8 rounded-[20px] bg-ink px-6 py-10 sm:px-10 lg:grid-cols-[1fr_auto]">
      <div>
        <p class="font-mono text-xs text-primary-300">{dict.home.slip.heading} · {dict.home.slip.ref}</p>
        <h2 class="mt-3 text-[clamp(1.5rem,1.2rem+1.5vw,1.875rem)] font-semibold leading-[1.25] text-white">{v2.homeV2.ctaTitle}</h2>
        <p class="mt-2 max-w-xl text-[15px] leading-[26px] text-white/70 sm:text-base">{v2.homeV2.ctaText}</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
        <a href={pageUrl(locale, "/order")} class="rounded-[10px] bg-primary-500 px-6 py-3.5 text-center text-[15px] font-semibold text-white transition-[background-color,transform] duration-200 hover:bg-primary-600 active:scale-[0.98]">{dict.hero.ctaOrder}</a>
        <a href={pageUrl(locale, "/pricing")} class="rounded-[10px] border border-white/25 px-6 py-3.5 text-center text-[15px] font-semibold text-white transition-colors duration-200 hover:border-white/60">{dict.hero.ctaPricing}</a>
      </div>
    </div>
  </section>
</Layout>
