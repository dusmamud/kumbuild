---
interface Props {
  /** Section number on the homepage, e.g. "01". Omit on standalone pages. */
  no?: string;
  title: string;
  subtitle?: string;
}
const { no, title, subtitle } = Astro.props;
---

<div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-3">
  <div class="flex items-baseline gap-3">
    {no && <span class="font-mono text-sm font-medium text-primary-700">{no}</span>}
    <h2 class="text-[clamp(1.5rem,1.2rem+1.4vw,2.25rem)] font-semibold leading-[1.2]">{title}</h2>
  </div>
  {subtitle && <p class="max-w-md text-base leading-[28px] text-body sm:leading-[28px]">{subtitle}</p>}
</div>
