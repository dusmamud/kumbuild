l,{}],[\"$\",\"$L1c\",null,{}]]}]]}]}],[\"$\",\"main\",null,{\"className\":\"flex flex-1 items-start justify-center px-4 py-10 sm:items-center\",\"children\":[\"$\",\"div\",null,{\"className\":\"w-full max-w-md rounded-xl border border-line bg-surface p-6 shadow-[0_1px_2px_rgba(15,23,42,0.06)] sm:p-8\",\"children\":[\"$\",\"$L3\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L4\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]}]}],[\"$\",\"footer\",null,{\"className\":\"py-4 text-center text-xs text-muted\",\"children\":[\"Kumbuild — \",\"Tell us what to build.\"]}]]}]\n7:[\"$\",\"html\",null,{\"lang\":\"hi\",\"suppressHydrationWarning\":true,\"children\":[[\"$\",\"head\",null,{\"children\":[\"$\",\"script\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"(function(){try{var m=document.cookie.match(/(?:^|; )kb_theme=([^;]*)/);var t=m?decodeURIComponent(m[1]):\\\"system\\\";var d=t===\\\"dark\\\"||(t!==\\\"light\\\"&&window.matchMedia(\\\"(prefers-color-scheme: dark)\\\").matches)?\\\"dark\\\":\\\"light\\\";document.documentElement.setAttribute(\\\"data-theme\\\",d);}catch(e){}})();\"}}]}],[\"$\",\"body\",null,{\"children\":\"$L1d\"}]]}]\n1e:I[17254,[\"$18\",\"$19\",\"$1a\"],\"default\"]\n:HL[\"/logo/kumbuild-logo.svg\",\"image\"]\n17:[\"$\",\"$L1e\",null,{\"ref\":\"$undefined\",\"href\":\"/hi/login\",\"locale\":\"$undefined\",\"localeCookie\":{\"name\":\"NEXT_LOCALE\",\"sameSite\":\"lax\"},\"className\":\"flex items-center gap-2\",\"children\":[[\"$\",\"img\",null,{\"src\":\"/logo/kumbuild-logo.svg\",\"alt\":\"Kumbuild\",\"width\":32,\"height\":32}],[\"$\",\"span\",null,{\"className\":\"text-lg font-bold text-ink\",\"children\":\"Kumbuild\"}]]}]\n1f:I[35342,[\"$18\",\"$19\"],\"default\"]\n1d:[\"$\",\"$L1f\",null,{\"formats\":\"$undefined\",\"locale\":\"hi\",\"messages\":{\"about\":{\"p1\":\"Kumbuild chhote businesses ke liye done-for-you website service hai. Dukaan, clinic, tuition centre, salon aur restaurant wale batayein unhe kya chahiye — aur hum unke liye website bana dete hain.\",\"p2\":\"Aapko code seekhne, designer hire karne, ya hosting aur domain samajhne ki zaroorat nahi. Bas batayein kya banana hai, preview approve karein, aur live ho jayein.\",\"title\":\"Kumbuild ke baare me\"},\"common\":{\"backHome\":\"Home par wapas\",\"learnMore\":\"Aur jaanein\"},\"contact\":{\"email\":\"Email karein\",\"note\":\"Support hours aur response time launch par bataye jayenge.\",\"subtitle\":\"Order karne se pehle koi sawaal hai? Message karein — hum WhatsApp par reply karte hain.\",\"title\":\"Sampark karein\",\"whatsapp\":\"WhatsApp par chat karein\"},\"examples\":{\"comingSoon\":\"Jald aa raha hai — Phase 3\",\"items\":[{\"desc\":\"Dukaan ke liye catalogue website — products, price aur WhatsApp order button.\",\"title\":\"Shop demo\"},{\"desc\":\"Clinic ke liye booking website — services, timing aur appointment enquiry form.\",\"title\":\"Clinic demo\"},{\"desc\":\"Tuition centre ke liye business website — courses, timing aur admission enquiry.\",\"title\":\"Tuition demo\"}],\"subtitle\":\"Portfolio ke liye hum demo websites bana rahe hain — ek shop, ek clinic aur ek tuition centre.\",\"title\":\"Example websites\"},\"faq\":{\"items\":[{\"a\":\"Kumbuild ek done-for-you website service hai. Aap batayein kya banana hai, aur hum aapke liye website bana dete hain. Aapko code seekhne ya kisi tool me design karne ki zaroorat nahi.\",\"q\":\"Kumbuild kya hai?\"},{\"a\":\"Advance payment aur poora content milne ke baad 3–5 working days — preview link milne tak. Content late mile to time aage badhega.\",\"q\":\"Meri website kitne din me ban jayegi?\"},{\"a\":\"Business ka naam, services aur price, WhatsApp number, address, timing aur real photos. Poori list order page par hai.\",\"q\":\"Website banane ke liye mujhe kya dena hoga?\"},{\"a\":\"Starter ₹3,999, Business ₹7,999, Premium ₹14,999 (sab draft hain). Har saal renewal ₹1,999 (draft) hai.\",\"q\":\"Website kitne ki banegi?\"},{\"a\":\"Order ke time 50% advance, baaki 50% approval ke baad, website live karne se pehle. Payment Razorpay se hoga — UPI, cards, netbanking aur wallets chalenge.\",\"q\":\"Payment kaise karna hoga?\"},{\"a\":\"2 revision rounds free hain. Preview dekh ke changes batayein, hum dobara preview bhejenge. Uske baad extra charge lagega — amount abhi decide nahi hua.\",\"q\":\"Website pasand na aaye to kya hoga?\"},{\"a\":\"kumbuild.com/order par form bharein, package choose karein, account banayein aur advance dein.\",\"q\":\"Order kaise karun?\"},{\"a\":\"home.kumbuild.com par login karein — Orders me status dikhega: Received → In progress → Preview ready → Revision → Approved → Live.\",\"q\":\"Order ka status kahan dekhu?\"},{\"a\":\"Kaam shuru hone se pehle cancel karein to poora advance refund hoga. Kaam shuru hone ke baad advance refund nahi hoga.\",\"q\":\"Order cancel karun to refund milega?\"}],\"subtitle\":\"Order karne se pehle log aksar yehi poochhte hain.\",\"title\":\"Aam sawaal-jawab\"},\"footer\":{\"company\":\"Company\",\"draftNote\":\"Dikhayi gayi prices draft hain, payment se pehle confirm ki jayengi.\",\"legal\":\"Legal\",\"rights\":\"All rights reserved.\",\"services\":\"Services\",\"tagline\":\"Tell us what to build.\"},\"hero\":{\"badge\":\"Chhote businesses ke liye done-for-you websites\",\"ctaOrder\":\"Meri website order karein\",\"ctaPricing\":\"Pricing dekhein\",\"note\":\"3–5 working days me delivery · 50% advance · 2 free revisions\",\"subtitle\":\"Aapki dukaan, clinic, tuition centre, salon ya restaurant ke liye fast, mobile-first website banate hain — aapko bas batana hai kya chahiye. Na code, na design tools, na jhanjhat.\",\"title\":\"Tell us what to build.\"},\"how\":{\"steps\":[{\"desc\":\"Order form bharein — business details, package, photos aur WhatsApp number.\",\"title\":\"Batayein\"},{\"desc\":\"Razorpay se 50% advance dein — UPI, card, netbanking ya wallet.\",\"title\":\"Advance\"},{\"desc\":\"Hum aapki website banate hain aur 3–5 working days me preview link bhejte hain.\",\"title\":\"Preview\"},{\"desc\":\"Changes batayein — 2 revision rounds free hain. Pasand aaye to approve karein.\",\"title\":\"Approve\"},{\"desc\":\"Baaki 50% dein aur aapki website aapke domain par live ho jayegi.\",\"title\":\"Go live\"}],\"subtitle\":\"Paanch steps. Aap batayein, hum banate hain — aapko sirf dekhna aur approve karna hai.\",\"title\":\"Kaise kaam karta hai\"},\"locale\":\"hi\",\"name\":\"Hindi\",\"nativeName\":\"हिन्दी\",\"nav\":{\"contact\":\"Sampark\",\"examples\":\"Examples\",\"faq\":\"FAQ\",\"home\":\"Home\",\"howItWorks\":\"Kaise kaam karta hai\",\"login\":\"Login\",\"order\":\"Abhi order karein\",\"pricing\":\"Pricing\",\"services\":\"Services\"},\"order\":{\"businessName\":\"Business ka naam\",\"businessType\":\"Business ka type\",\"businessTypeOptions\":[\"Shop\",\"Clinic\",\"Tuition / Coaching\",\"Salon\",\"Restaurant / Cafe\",\"Other\"],\"contentLanguage\":\"Website ki language\",\"message\":\"Apne business ke baare me batayein (1–2 lines)\",\"name\":\"Aapka naam\",\"note\":\"Is form me koi payment nahi li jati. Advance payment order confirm hone ke baad hogi.\",\"package\":\"Package choose karein\",\"phone\":\"Phone number\",\"reference\":\"Order reference\",\"required\":\"Zaroori\",\"submit\":\"Order submit karein\",\"subtitle\":\"Ye form bharein. Hum aapke package aur content confirm karne ke liye WhatsApp par sampark karenge.\",\"successText\":\"Dhanyavaad! Hum aapke package aur content confirm karne ke liye jald hi WhatsApp par message karenge. Aapka reference neeche hai — please save kar lein.\",\"successTitle\":\"Order mil gaya!\",\"title\":\"Apni website order karein\",\"whatsapp\":\"WhatsApp number\"},\"pricing\":{\"note\":\"Prices draft hain, payment se pehle confirm ki jayengi.\",\"packages\":[{\"bestFor\":\"Chhoti dukaan ya Instagram page — ek page hi kaafi hai.\",\"cta\":\"Starter choose karein\",\"features\":[\"1 page\",\"Mobile responsive\",\"WhatsApp button\",\"Google Maps\",\"Contact / enquiry form\",\"Basic SEO\",\"SSL (https)\"],\"name\":\"Starter\",\"per\":\"one-time\",\"price\":\"₹3,999\",\"slug\":\"starter\"},{\"bestFor\":\"Clinic, tuition, salon — poori website chahiye.\",\"cta\":\"Business choose karein\",\"features\":[\"5 pages tak\",\"Starter ka sab kuch\",\"Services + gallery\",\"Apne business ke baare me\",\"Mobile responsive\",\"Basic SEO\",\"SSL (https)\"],\"name\":\"Business\",\"per\":\"one-time\",\"price\":\"₹7,999\",\"slug\":\"business\"},{\"bestFor\":\"Booking, WhatsApp order ya catalogue chahiye.\",\"cta\":\"Premium choose karein\",\"features\":[\"Business ka sab kuch\",\"Booking / appointment form\",\"WhatsApp order button\",\"Catalogue / menu list\",\"Zaroorat ke hisaab se zyada pages\",\"Basic SEO\",\"SSL (https)\"],\"name\":\"Premium\",\"per\":\"one-time\",\"price\":\"₹14,999\",\"slug\":\"premium\"}],\"renewal\":{\"desc\":\"Domain renewal, hosting, chhoti updates (phone, timing, ek-do lines) aur support.\",\"per\":\"per year\",\"price\":\"₹1,999\",\"title\":\"Yearly renewal\"},\"subtitle\":\"One-time prices. Koi hidden charges nahi. Yearly renewal se domain, hosting aur chhoti updates chalti rehti hain.\",\"terms\":\"Order par 50% advance · baaki 50% approval par, go-live se pehle · 2 free revision rounds · Payment Razorpay se (UPI, cards, netbanking, wallets).\",\"title\":\"Simple pricing\"},\"privacy\":{\"intro\":\"Draft — poori privacy policy launch se pehle yahan hogi. Order form se mili aapki details sirf aapki website banane aur aapse order ke baare me sampark karne ke liye use hoti hain.\",\"title\":\"Privacy policy\"},\"services\":{\"items\":[{\"desc\":\"Aapke business ki poori website — 1 se 5 pages: Home, Services, About, Gallery aur Contact.\",\"for\":\"Shop, clinic, salon, gym, restaurant\",\"slug\":\"business-website\",\"title\":\"Business Website\"},{\"desc\":\"Ek page, ek hi kaam ke liye — Instagram ya Facebook bio link se aane wale visitor ko enquiry ke liye WhatsApp par bhejna.\",\"for\":\"Instagram / Facebook sellers aur creators\",\"slug\":\"landing-page\",\"title\":\"Landing Page\"},{\"desc\":\"Services, timing aur appointment ya enquiry form. Customer time batata hai — aap confirm karte hain. (Live calendar nahi hai.)\",\"for\":\"Clinic, salon, tuition aur coaching\",\"slug\":\"booking-website\",\"title\":\"Booking / Enquiry Website\"},{\"desc\":\"Aapke products ya menu — photo, naam aur price — aur WhatsApp order button. (Payment checkout wala store nahi hai.)\",\"for\":\"Shop, restaurant, cafe, boutique, home bakers\",\"slug\":\"catalogue-website\",\"title\":\"Catalogue / Menu Website\"}],\"subtitle\":\"Chaar services. Har website mobile-first, fast hai, aur usme WhatsApp button, Google Maps, contact form, basic SEO aur SSL milta hai.\",\"title\":\"Hum aapke liye kya banate hain\"},\"terms\":{\"intro\":\"Draft — poori terms launch se pehle publish hongi. Short me: 50% advance, 2 free revision rounds, aur jo content aap denge wo aapka hona chahiye.\",\"title\":\"Terms of service\"},\"trust\":[\"Mobile-first design\",\"Fast loading\",\"WhatsApp button\",\"Google Maps included\"]},\"now\":\"$undefined\",\"timeZone\":\"Asia/Calcutta\",\"children\":\"$L20\"}]\n20:[\"$\",\"$L3\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L4\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":[[\"$\",\"div\",null,{\"className\":\"flex min-h-screen flex-col items-center justify-center px-4 text-center\",\"children\":[[\"$\",\"h1\",null,{\"className\":\"text-4xl font-bold\",\"children\":\"404\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-muted\",\"children\":\"Ye page nahi mila.\"}],\"$L21\"]}],[]],\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"