o/kumbuild-logo.svg\\\",\\\"alt\\\":\\\"Kumbuild\\\",\\\"width\\\":32,\\\"height\\\":32}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-lg font-bold text-ink\\\",\\\"children\\\":\\\"Kumbuild\\\"}]]}]\\n20:I[35342,[\\\"$18\\\",\\\"$19\\\"],\\\"default\\\"]\\n1f:[\\\"$\\\",\\\"$L20\\\",null,{\\\"formats\\\":\\\"$undefined\\\",\\\"locale\\\":\\\"bn\\\",\\\"messages\\\":{\\\"about\\\":{\\\"p1\\\":\\\"Kumbuild ছোট ব্যবসার জন্য done-for-you ওয়েবসাইট সার্ভিস। দোকান, ক্লিনিক, টিউশন সেন্টার, সেলুন আর রেস্টুরেন্ট — কী বানাতে হবে বলুন, আমরা ওয়েবসাইট বানিয়ে দেব।\\\",\\\"p2\\\":\\\"আপনাকে কোড শিখতে হবে না, ডিজাইনার নিয়োগ করতে হবে না, হোস্টিং আর ডোমেইন বুঝতে হবে না। শুধু বলুন কী বানাতে হবে, প্রিভিউ অনুমোদন করুন, আর লাইভ হয়ে যান।\\\",\\\"title\\\":\\\"Kumbuild সম্পর্কে\\\"},\\\"common\\\":{\\\"backHome\\\":\\\"হোমে ফিরে যান\\\",\\\"learnMore\\\":\\\"আরও জানুন\\\"},\\\"contact\\\":{\\\"email\\\":\\\"ইমেইল করুন\\\",\\\"note\\\":\\\"সাপোর্টের সময় ও উত্তরের সময় লঞ্চের সময় জানানো হবে।\\\",\\\"subtitle\\\":\\\"অর্ডার করার আগে কোনো প্রশ্ন আছে? মেসেজ করুন — আমরা WhatsApp-এ উত্তর দিই।\\\",\\\"title\\\":\\\"যোগাযোগ করুন\\\",\\\"whatsapp\\\":\\\"WhatsApp-এ চ্যাট করুন\\\"},\\\"examples\\\":{\\\"comingSoon\\\":\\\"শীঘ্রই আসছে — Phase 3\\\",\\\"items\\\":[{\\\"desc\\\":\\\"দোকানের জন্য ক্যাটালগ ওয়েবসাইট — প্রোডাক্ট, দাম আর WhatsApp অর্ডার বোতাম।\\\",\\\"title\\\":\\\"Shop demo\\\"},{\\\"desc\\\":\\\"ক্লিনিকের জন্য বুকিং ওয়েবসাইট — সার্ভিস, সময় আর অ্যাপয়েন্টমেন্ট enquiry ফর্ম।\\\",\\\"title\\\":\\\"Clinic demo\\\"},{\\\"desc\\\":\\\"টিউশন সেন্টারের জন্য ব্যবসার ওয়েবসাইট — কোর্স, সময় আর ভর্তির enquiry।\\\",\\\"title\\\":\\\"Tuition demo\\\"}],\\\"subtitle\\\":\\\"পোর্টফোলিওর জন্য আমরা ডেমো ওয়েবসাইট বানাচ্ছি — একটি দোকান, একটি ক্লিনিক আর একটি টিউশন সেন্টার।\\\",\\\"title\\\":\\\"উদাহরণ ওয়েবসাইট\\\"},\\\"faq\\\":{\\\"items\\\":[{\\\"a\\\":\\\"Kumbuild একটি done-for-you ওয়েবসাইট সার্ভিস। আপনি বলুন কী বানাতে হবে, আমরা আপনার জন্য ওয়েবসাইট বানিয়ে দেব। আপনাকে কোড শিখতে হবে না বা কোনো টুলে ডিজাইন করতে হবে না।\\\",\\\"q\\\":\\\"Kumbuild কী?\\\"},{\\\"a\\\":\\\"অগ্রিম পেমেন্ট আর সম্পূর্ণ কনটেন্ট পাওয়ার পর ৩–৫ working days — প্রিভিউ লিংক পাওয়া পর্যন্ত। কনটেন্ট দেরিতে পেলে সময় বাড়বে।\\\",\\\"q\\\":\\\"আমার ওয়েবসাইট কত দিনে তৈরি হবে?\\\"},{\\\"a\\\":\\\"ব্যবসার নাম, সার্ভিস আর দাম, WhatsApp নম্বর, ঠিকানা, সময় আর আসল ছবি। সম্পূর্ণ তালিকা অর্ডার পেজে আছে।\\\",\\\"q\\\":\\\"ওয়েবসাইট বানাতে আমাকে কী দিতে হবে?\\\"},{\\\"a\\\":\\\"Starter ₹3,999, Business ₹7,999, Premium ₹14,999 (সব draft)। প্রতি বছর renewal ₹1,999 (draft)।\\\",\\\"q\\\":\\\"ওয়েবসাইটের দাম কত?\\\"},{\\\"a\\\":\\\"অর্ডারের সময় ৫০% অগ্রিম, বাকি ৫০% অনুমোদনের পর, ওয়েবসাইট লাইভ করার আগে। পেমেন্ট Razorpay দিয়ে হবে — UPI, কার্ড, নেটব্যাংকিং আর ওয়ালেট চলবে।\\\",\\\"q\\\":\\\"পেমেন্ট কীভাবে করব?\\\"},{\\\"a\\\":\\\"২টি revision round ফ্রি। প্রিভিউ দেখে পরিবর্তন বলুন, আমরা আবার প্রিভিউ পাঠাব। তারপর অতিরিক্ত চার্জ লাগবে — পরিমাণ এখনও ঠিক হয়নি।\\\",\\\"q\\\":\\\"ওয়েবসাইট পছন্দ না হলে কী হবে?\\\"},{\\\"a\\\":\\\"kumbuild.com/order-এ ফর্ম পূরণ করুন, প্যাকেজ বেছে নিন, অ্যাকাউন্ট তৈরি করুন আর অগ্রিম দিন।\\\",\\\"q\\\":\\\"অর্ডার কীভাবে করব?\\\"},{\\\"a\\\":\\\"home.kumbuild.com-এ লগইন করুন — Orders-এ স্ট্যাটাস দেখা যাবে: Received → In progress → Preview ready → Revision → Approved → Live।\\\",\\\"q\\\":\\\"আমার অর্ডারের স্ট্যাটাস কোথায় দেখব?\\\"},{\\\"a\\\":\\\"কাজ শুরু হওয়ার আগে বাতিল করলে পুরো অগ্রিম ফেরত পাবেন। কাজ শুরু হওয়ার পর অগ্রিম ফেরত হবে না।\\\",\\\"q\\\":\\\"অর্ডার বাতিল করলে কি রিফান্ড পাব?\\\"}],\\\"subtitle\\\":\\\"অর্ডার করার আগে মানুষ সাধারণত এগুলোই জিজ্ঞেস করেন।\\\",\\\"title\\\":\\\"সচরাচর জিজ্ঞাসা\\\"},\\\"footer\\\":{\\\"company\\\":\\\"Company\\\",\\\"draftNote\\\":\\\"দেখানো দামগুলো draft, পেমেন্টের আগে নিশ্চিত করা হবে।\\\",\\\"legal\\\":\\\"Legal\\\",\\\"rights\\\":\\\"All rights reserved.\\\",\\\"services\\\":\\\"Services\\\",\\\"tagline\\\":\\\"Tell us what to build.\\\"},\\\"hero\\\":{\\\"badge\\\":\\\"ছোট ব্যবসার জন্য done-for-you ওয়েবসাইট\\\",\\\"ctaOrder\\\":\\\"আমার ওয়েবসাইট অর্ডার করুন\\\",\\\"ctaPricing\\\":\\\"Pricing দেখুন\\\",\\\"note\\\":\\\"৩–৫ working days-এ ডেলিভারি · ৫০% অগ্রিম · ২টি ফ্রি revision\\\",\\\"subtitle\\\":\\\"আপনার দোকান, ক্লিনিক, টিউশন সেন্টার, সেলুন বা রেস্টুরেন্টের জন্য দ্রুত, mobile-first ওয়েবসাইট বানাই — আপনাকে শুধু বলতে হবে কী চাই। কোনো কোড নেই, কোনো ডিজাইন টুল নেই, কোনো ঝামেলা নেই।\\\",\\\"title\\\":\\\"Tell us what to build.\\\"},\\\"how\\\":{\\\"steps\\\":[{\\\"desc\\\":\\\"অর্ডার ফর্ম পূরণ করুন — ব্যবসার বিবরণ, প্যাকেজ, ছবি আর WhatsApp নম্বর।\\\",\\\"title\\\":\\\"বলুন\\\"},{\\\"desc\\\":\\\"Razorpay দিয়ে ৫০% অগ্রিম দিন — UPI, কার্ড, নেটব্যাংকিং বা ওয়ালেট।\\\",\\\"title\\\":\\\"অগ্রিম\\\"},{\\\"desc\\\":\\\"আমরা আপনার ওয়েবসাইট বানাই আর ৩–৫ working days-এ প্রিভিউ লিংক পাঠাই।\\\",\\\"title\\\":\\\"প্রিভিউ\\\"},{\\\"desc\\\":\\\"পরিবর্তন বলুন — ২টি revision round ফ্রি। ভালো লাগলে অনুমোদন করুন।\\\",\\\"title\\\":\\\"অনুমোদন\\\"},{\\\"desc\\\":\\\"বাকি ৫০% দিন আর আপনার ওয়েবসাইট আপনার ডোমেইনে লাইভ হয়ে যাবে।\\\",\\\"title\\\":\\\"লাইভ করুন\\\"}],\\\"subtitle\\\":\\\"পাঁচটি ধাপ। আপনি বলুন, আমরা বানাই — আপনাকে শুধু দেখতে আর অনুমোদন করতে হবে।\\\",\\\"title\\\":\\\"কীভাবে কাজ করে\\\"},\\\"locale\\\":\\\"bn\\\",\\\"name\\\":\\\"Bengali\\\",\\\"nativeName\\\":\\\"বাংলা\\\",\\\"nav\\\":{\\\"contact\\\":\\\"যোগাযোগ\\\",\\\"examples\\\":\\\"উদাহরণ\\\",\\\"faq\\\":\\\"FAQ\\\",\\\"home\\\":\\\"হোম\\\",\\\"howItWorks\\\":\\\"কীভাবে কাজ করে\\\",\\\"login\\\":\\\"লগইন\\\",\\\"order\\\":\\\"এখনই অর্ডার করুন\\\",\\\"pricing\\\":\\\"Pricing\\\",\\\"services\\\":\\\"Services\\\"},\\\"order\\\":{\\\"businessName\\\":\\\"ব্যবসার নাম\\\",\\\"businessType\\\":\\\"ব্যবসার ধরন\\\",\\\"businessTypeOptions\\\":[\\\"Shop\\\",\\\"Clinic\\\",\\\"Tuition / Coaching\\\",\\\"Salon\\\",\\\"Restaurant / Cafe\\\",\\\"Other\\\"],\\\"contentLanguage\\\":\\\"ওয়েবসাইটের ভাষা\\\",\\\"message\\\":\\\"আপনার ব্যবসা সম্পর্কে বলুন (১–২ লাইন)\\\",\\\"name\\\":\\\"আপনার নাম\\\",\\\"note\\\":\\\"এই ফর্মে কোনো পেমেন্ট নেওয়া হয় না। অগ্রিম পেমেন্ট অর্ডার নিশ্চিত হওয়ার পর হবে।\\\",\\\"package\\\":\\\"প্যাকেজ বেছে নিন\\\",\\\"phone\\\":\\\"ফোন নম্বর\\\",\\\"reference\\\":\\\"অর্ডার রেফারেন্স\\\",\\\"required\\\":\\\"আবশ্যক\\\",\\\"submit\\\":\\\"অর্ডার জমা দিন\\\",\\\"subtitle\\\":\\\"এই ফর্মটি পূরণ করুন। আপনার প্যাকেজ আর কনটেন্ট নিশ্চিত করতে আমরা WhatsApp-এ যোগাযোগ করব।\\\",\\\"successText\\\":\\\"ধন্যবাদ! আপনার প্যাকেজ আর কনটেন্ট নিশ্চিত করতে আমরা শীঘ্রই WhatsApp-এ মেসেজ করব। আপনার রেফারেন্স নিচে দেওয়া আছে — দয়া করে সংরক্ষণ করুন।\\\",\\\"successTitle\\\":\\\"অর্ডার পাওয়া গেছে!\\\",\\\"title\\\":\\\"আপনার ওয়েবসাইট অর্ডার করুন\\\",\\\"whatsapp\\\":\\\"WhatsApp নম্বর\\\"},\\\"pricing\\\":{\\\"note\\\":\\\"দামগুলো draft, পেমেন্টের আগে নিশ্চিত করা হবে।\\\",\\\"packages\\\":[{\\\"bestFor\\\":\\\"ছোট দোকান বা Instagram পেজ — এক পেজই যথেষ্ট।\\\",\\\"cta\\\":\\\"Starter বেছে নিন\\\",\\\"features\\\":[\\\"১ পেজ\\\",\\\"Mobile responsive\\\",\\\"WhatsApp বোতাম\\\",\\\"Google Maps\\\",\\\"Contact / enquiry ফর্ম\\\",\\\"Basic SEO\\\",\\\"SSL (https)\\\"],\\\"name\\\":\\\"Starter\\\",\\\"per\\\":\\\"one-time\\\",\\\"price\\\":\\\"₹3,999\\\",\\\"slug\\\":\\\"starter\\\"},{\\\"bestFor\\\":\\\"ক্লিনিক, টিউশন, সেলুন — সম্পূর্ণ ওয়েবসাইট দরকার।\\\",\\\"cta\\\":\\\"Business বেছে নিন\\\",\\\"features\\\":[\\\"৫ পেজ পর্যন্ত\\\",\\\"Starter-এর সবকিছু\\\",\\\"Services + gallery\\\",\\\"আপনার ব্যবসা সম্পর্কে\\\",\\\"Mobile responsive\\\",\\\"Basic SEO\\\",\\\"SSL (https)\\\"],\\\"name\\\":\\\"Business\\\",\\\"per\\\":\\\"one-time\\\",\\\"price\\\":\\\"₹7,999\\\",\\\"slug\\\":\\\"business\\\"},{\\\"bestFor\\\":\\\"বুকিং, WhatsApp অর্ডার বা ক্যাটালগ দরকার।\\\",\\\"cta\\\":\\\"Premium বেছে নিন\\\",\\\"features\\\":[\\\"Business-এর সবকিছু\\\",\\\"Booking / appointment ফর্ম\\\",\\\"WhatsApp অর্ডার বোতাম\\\",\\\"Catalogue / menu তালিকা\\\",\\\"প্রয়োজন অনুযায়ী আরও পেজ\\\",\\\"Basic SEO\\\",\\\"SSL (https)\\\"],\\\"name\\\":\\\"Premium\\\",\\\"per\\\":\\\"one-time\\\",\\\"price\\\":\\\"₹14,999\\\",\\\"slug\\\":\\\"premium\\\"}],\\\"renewal\\\":{\\\"desc\\\":\\\"ডোমেইন renewal, হোস্টিং, ছোট আপডেট (ফোন, সময়, এক-দুই লাইন) আর সাপোর্ট।\\\",\\\"per\\\":\\\"per year\\\",\\\"price\\\":\\\"₹1,999\\\",\\\"title\\\":\\\"Yearly renewal\\\"},\\\"subtitle\\\":\\\"One-time দাম। কোনো লুকানো চার্জ নেই। Yearly renewal-এ ডোমেইন, হোস্টিং আর ছোট আপডেট চালু থাকে।\\\",\\\"terms\\\":\\\"অর্ডারে ৫০% অগ্রিম · বাকি ৫০% অনুমোদনে, লাইভ করার আগে · ২টি ফ্রি revision round · Razorpay দিয়ে পেমেন্ট (UPI, কার্ড, নেটব্যাংকিং, ওয়ালেট)।\\\",\\\"title\\\":\\\"সহজ pricing\\\"},\\\"privacy\\\":{\\\"intro\\\":\\\"Draft — সম্পূর্ণ privacy policy লঞ্চের আগে এখানে থাকবে। অর্ডার ফর্ম থেকে পাওয়া আপনার বিবরণ শুধু আপনার ওয়েবসাইট বানাতে আর অর্ডার সম্পর্কে যোগাযোগ করতে ব্যবহৃত হয়।\\\",\\\"title\\\":\\\"Privacy policy\\\"},\\\"services\\\":{\\\"items\\\":[{\\\"desc\\\":\\\"আপনার ব্যবসার সম্পূর্ণ ওয়েবসাইট — ১ থেকে ৫ পেজ: Home, Services, About, Gallery আর Contact।\\\",\\\"for\\\":\\\"দোকান, ক্লিনিক, সেলুন, জিম, রেস্টুরেন্ট\\\",\\\"slug\\\":\\\"business-website\\\",\\\"title\\\":\\\"Business Website\\\"},{\\\"desc\\\":\\\"এক পেজ, একটাই কাজের জন্য — Instagram বা Facebook bio লিংক থেকে আসা ভিজিটরকে enquiry-র জন্য WhatsApp-এ পাঠানো।\\\",\\\"for\\\":\\\"Instagram / Facebook বিক্রেতা আর creator\\\",\\\"slug\\\":\\\"landing-page\\\",\\\"title\\\":\\\"Landing Page\\\"},{\\\"desc\\\":\\\"সার্ভিস, সময় আর অ্যাপয়েন্টমেন্ট বা enquiry ফর্ম। গ্রাহক সময় বলবেন — আপনি নিশ্চিত করবেন। (লাইভ ক্যালেন্ডার নয়।)\\\",\\\"for\\\":\\\"ক্লিনিক, সেলুন, টিউশন আর কোচিং\\\",\\\"slug\\\":\\\"booking-website\\\",\\\"title\\\":\\\"Booking / Enquiry Website\\\"},{\\\"desc\\\":\\\"আপনার প্রোডাক্ট বা মেনু — ছবি, নাম আর দাম — আর WhatsApp অর্ডার বোতাম। (পেমেন্ট checkout-সহ দোকান নয়।)\\\",\\\"for\\\":\\\"দোকান, রেস্টুরেন্ট, ক্যাফে, বুটিক, home baker\\\",\\\"slug\\\":\\\"catalogue-website\\\",\\\"title\\\":\\\"Catalogue / Menu Website\\\"}],\\\"subtitle\\\":\\\"চারটি সার্ভিস। প্রতিটি ওয়েবসাইট mobile-first, দ্রুত, আর তাতে WhatsApp বোতাম, Google Maps, contact ফর্ম, basic SEO আর SSL থাকে।\\\",\\\"title\\\":\\\"আমরা আপনার জন্য কী বানাই\\\"},\\\"terms\\\":{\\\"intro\\\":\\\"Draft — সম্পূর্ণ শর্তাবলী লঞ্চের আগে প্রকাশ করা হবে। সংক্ষেপে: ৫০% অগ্রিম, ২টি ফ্রি revision round, আর আপনি যে কনটেন্ট দেবেন তা আপনার হতে হবে।\\\",\\\"title\\\":\\\"Terms of service\\\"},\\\"trust\\\":[\\\"Mobile-first ডিজাইন\\\",\\\"দ্রুত লোডিং\\\",\\\"WhatsApp বোতাম\\\",\\\"Google Maps সহ\\\"]},\\\"now\\\":\\\"$undefined\\\",\\\"timeZone\\\":\\\"Asia/Calcutta\\\",\\\"children\\\":\\\"$L21\\\"}]\\n21:[\\\"$\\\",\\\"$L3\\\",null,{\\\"parallelRouterKey\\\":\\\"children\\\",\\\"error\\\":\\\"$undefined\\\",\\\"errorStyles\\\":\\\"$undefined\\\",\\\"errorScripts\\\":\\\"$undefined\\\",\\\"template\\\":[\\\"$\\\",\\\"$L4\\\",null,{}],\\\"templateStyles\\\":\\\"$undefined\\\",\\\"templateScripts\\\":\\\"$undefined\\\",\\\"notFound\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex min-h-screen flex-col items-center justify-center px-4 text-center\\\",\\\"children\\\":[[\\\"$\\\",\\\"h1\\\",null,{\\\"className\\\":\\\"text-4xl font-bold\\\",\\\"children\\\":\\\"404\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-2 text-muted\\\",\\\"children\\\":\\\"Ye page nahi mila.\\\"}],\\\"$L22\\\"]}],[]],\\\"forbidden\\\":\\\"$undefined\\\",\\\"unauthorized\\\":\\\"$undefined\\\"}]\\n22:[\\\"$\\\",\\\"$L1b\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"href\\\":\\\"/bn/login\\\",\\\"locale\\\":\\\"$undefined\\\",\\\"localeCookie\\\":\\\"$17:props:localeCookie\\\",\\\"className\\\":\\\"mt-6 font-semibold text-primary-text\\\",\\\"children\\\":\\\"Login par jao →\\\"}]\\n12:[[\\\"$\\\",\\\"meta\\\",\\\"0\\\",{\\\"charSet\\\":\\\"utf-8\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\\\"viewport\\\",\\\"content\\\":\\\"width=device-width, initial-scale=1\\\"}]]\\nf:null\\n15:[]\\n\"])</script></body></html>","rsc":"1:\"$Sreact.fragment\"\n2:\"/_next/static/chunks/1f9w4rw4lue12.js\"\n3:I[97479,[\"$2\"],\"default\"]\n4:I[68405,[\"$2\"],\"default