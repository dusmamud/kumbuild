:HL[\"/logo/kumbuild-logo.svg\",\"image\"]\n1c:[\"$\",\"$L1b\",null,{\"ref\":\"$undefined\",\"href\":\"/login\",\"locale\":\"$undefined\",\"localeCookie\":\"$17:props:localeCookie\",\"className\":\"flex items-center gap-2\",\"children\":[[\"$\",\"img\",null,{\"src\":\"/logo/kumbuild-logo.svg\",\"alt\":\"Kumbuild\",\"width\":32,\"height\":32}],[\"$\",\"span\",null,{\"className\":\"text-lg font-bold text-ink\",\"children\":\"Kumbuild\"}]]}]\n20:I[35342,[\"$18\",\"$19\"],\"default\"]\n1f:[\"$\",\"$L20\",null,{\"formats\":\"$undefined\",\"locale\":\"en-US\",\"messages\":{\"about\":{\"p1\":\"Kumbuild is a done-for-you website service for small businesses. Shop owners, clinics, tuition centres, salons and restaurants tell us what they need — and we build the website for them.\",\"p2\":\"You don't need to learn code, hire a designer, or figure out hosting and domains. Tell us what to build, approve the preview, and go live.\",\"title\":\"About Kumbuild\"},\"common\":{\"backHome\":\"Back to home\",\"learnMore\":\"Learn more\"},\"contact\":{\"email\":\"Email us\",\"note\":\"Support hours and response time will be announced at launch.\",\"subtitle\":\"Questions before ordering? Message us — we reply on WhatsApp.\",\"title\":\"Contact us\",\"whatsapp\":\"Chat on WhatsApp\"},\"examples\":{\"comingSoon\":\"Coming soon — Phase 3\",\"items\":[{\"desc\":\"A catalogue website for a shop — products, prices and WhatsApp order button.\",\"title\":\"Shop demo\"},{\"desc\":\"A booking website for a clinic — services, timings and appointment enquiry form.\",\"title\":\"Clinic demo\"},{\"desc\":\"A business website for a tuition centre — courses, timings and admission enquiry.\",\"title\":\"Tuition demo\"}],\"subtitle\":\"Demo websites we are building as our portfolio — a shop, a clinic and a tuition centre.\",\"title\":\"Example websites\"},\"faq\":{\"items\":[{\"a\":\"Kumbuild is a done-for-you website service. You tell us what to build, and we build the website for you. You don't need to learn code or design anything in a tool.\",\"q\":\"What is Kumbuild?\"},{\"a\":\"3–5 working days after advance payment and complete content — until you get the preview link. If content comes late, the time moves ahead.\",\"q\":\"How many days will my website take?\"},{\"a\":\"Business name, services and prices, WhatsApp number, address, timings, and real photos. The full list is on the order page.\",\"q\":\"What do I need to give you?\"},{\"a\":\"Starter ₹3,999, Business ₹7,999, Premium ₹14,999 (all draft). Yearly renewal is ₹1,999 (draft).\",\"q\":\"How much will a website cost?\"},{\"a\":\"50% advance at order time, the remaining 50% after approval, before the website goes live. Payment is through Razorpay — UPI, cards, netbanking and wallets.\",\"q\":\"How do I pay?\"},{\"a\":\"2 revision rounds are free. See the preview, tell us the changes, and we will send a new preview. Extra rounds cost extra — amount to be decided.\",\"q\":\"What if I don't like the website?\"},{\"a\":\"Fill the form on kumbuild.com/order, choose a package, create an account and pay the advance.\",\"q\":\"How do I order?\"},{\"a\":\"Login at home.kumbuild.com — Orders shows the status: Received → In progress → Preview ready → Revision → Approved → Live.\",\"q\":\"Where do I check my order status?\"},{\"a\":\"Cancel before work starts and the full advance is refunded. After work starts, the advance is not refunded.\",\"q\":\"What if I cancel my order?\"}],\"subtitle\":\"Everything people usually ask before ordering.\",\"title\":\"Frequently asked questions\"},\"footer\":{\"company\":\"Company\",\"draftNote\":\"Prices shown are draft and will be confirmed before payment.\",\"legal\":\"Legal\",\"rights\":\"All rights reserved.\",\"services\":\"Services\",\"tagline\":\"Tell us what to build.\"},\"hero\":{\"badge\":\"Done-for-you websites for small businesses\",\"ctaOrder\":\"Order my website\",\"ctaPricing\":\"See pricing\",\"note\":\"Delivery in 3–5 working days · 50% advance · 2 free revisions\",\"subtitle\":\"We build a fast, mobile-first website for your shop, clinic, tuition centre, salon or restaurant — you just tell us what you need. No code, no design tools, no hassle.\",\"title\":\"Tell us what to build.\"},\"how\":{\"steps\":[{\"desc\":\"Fill the order form — business details, package, photos and WhatsApp number.\",\"title\":\"Tell us\"},{\"desc\":\"Pay 50% advance through Razorpay — UPI, card, netbanking or wallet.\",\"title\":\"Advance\"},{\"desc\":\"We build your website and send you a preview link in 3–5 working days.\",\"title\":\"Preview\"},{\"desc\":\"Ask for changes — 2 revision rounds are free. Approve when you love it.\",\"title\":\"Approve\"},{\"desc\":\"Pay the remaining 50% and your website goes live with your domain.\",\"title\":\"Go live\"}],\"subtitle\":\"Five steps. You tell us, we build — you only review and approve.\",\"title\":\"How it works\"},\"locale\":\"en-US\",\"name\":\"English\",\"nativeName\":\"English\",\"nav\":{\"contact\":\"Contact\",\"examples\":\"Examples\",\"faq\":\"FAQ\",\"home\":\"Home\",\"howItWorks\":\"How it works\",\"login\":\"Login\",\"order\":\"Order now\",\"pricing\":\"Pricing\",\"services\":\"Services\"},\"order\":{\"businessName\":\"Business name\",\"businessType\":\"Business type\",\"businessTypeOptions\":[\"Shop\",\"Clinic\",\"Tuition / Coaching\",\"Salon\",\"Restaurant / Cafe\",\"Other\"],\"contentLanguage\":\"Website language\",\"message\":\"Tell us about your business (1–2 lines)\",\"name\":\"Your name\",\"note\":\"No payment is taken in this form. Advance payment happens after we confirm your order.\",\"package\":\"Choose a package\",\"phone\":\"Phone number\",\"reference\":\"Order reference\",\"required\":\"Required\",\"submit\":\"Submit order\",\"subtitle\":\"Fill this form. We will contact you on WhatsApp to confirm your package and content.\",\"successText\":\"Thanks! We will message you on WhatsApp shortly to confirm your package and collect your content. Your reference is shown below — please save it.\",\"successTitle\":\"Order received!\",\"title\":\"Order your website\",\"whatsapp\":\"WhatsApp number\"},\"pricing\":{\"note\":\"Prices are draft and will be confirmed before you pay.\",\"packages\":[{\"bestFor\":\"Small shop or Instagram page — one page is enough.\",\"cta\":\"Choose Starter\",\"features\":[\"1 page\",\"Mobile responsive\",\"WhatsApp button\",\"Google Maps\",\"Contact / enquiry form\",\"Basic SEO\",\"SSL (https)\"],\"name\":\"Starter\",\"per\":\"one-time\",\"price\":\"₹3,999\",\"slug\":\"starter\"},{\"bestFor\":\"Clinic, tuition, salon — you need a full website.\",\"cta\":\"Choose Business\",\"features\":[\"Up to 5 pages\",\"Everything in Starter\",\"Services + gallery\",\"About your business\",\"Mobile responsive\",\"Basic SEO\",\"SSL (https)\"],\"name\":\"Business\",\"per\":\"one-time\",\"price\":\"₹7,999\",\"slug\":\"business\"},{\"bestFor\":\"Booking, WhatsApp orders or a catalogue.\",\"cta\":\"Choose Premium\",\"features\":[\"Everything in Business\",\"Booking / appointment form\",\"WhatsApp order button\",\"Catalogue / menu list\",\"More pages as needed\",\"Basic SEO\",\"SSL (https)\"],\"name\":\"Premium\",\"per\":\"one-time\",\"price\":\"₹14,999\",\"slug\":\"premium\"}],\"renewal\":{\"desc\":\"Domain renewal, hosting, small updates (phone, timings, a line or two) and support.\",\"per\":\"per year\",\"price\":\"₹1,999\",\"title\":\"Yearly renewal\"},\"subtitle\":\"One-time prices. No hidden charges. Yearly renewal keeps your domain, hosting and small updates running.\",\"terms\":\"50% advance on order · remaining 50% on approval, before go-live · 2 free revision rounds · Payment by Razorpay (UPI, cards, netbanking, wallets).\",\"title\":\"Simple pricing\"},\"privacy\":{\"intro\":\"Draft — this page will carry the full privacy policy before launch. Your details from the order form are used only to build your website and contact you about your order.\",\"title\":\"Privacy policy\"},\"services\":{\"items\":[{\"desc\":\"A complete website for your business — 1 to 5 pages: Home, Services, About, Gallery and Contact.\",\"for\":\"Shops, clinics, salons, gyms, restaurants\",\"slug\":\"business-website\",\"title\":\"Business Website\"},{\"desc\":\"One page built for one job — turn visitors from your Instagram or Facebook bio link into enquiries on WhatsApp.\",\"for\":\"Instagram / Facebook sellers and creators\",\"slug\":\"landing-page\",\"title\":\"Landing Page\"},{\"desc\":\"Services, timings and an appointment or enquiry form. Customers tell you a time — you confirm it. (Not a live calendar.)\",\"for\":\"Clinics, salons, tuition and coaching\",\"slug\":\"booking-website\",\"title\":\"Booking / Enquiry Website\"},{\"desc\":\"Your products or menu with photo, name and price — and a WhatsApp order button. (Not a payment checkout store.)\",\"for\":\"Shops, restaurants, cafes, boutiques, home bakers\",\"slug\":\"catalogue-website\",\"title\":\"Catalogue / Menu Website\"}],\"subtitle\":\"Four services. Every website is mobile-first, fast, and comes with a WhatsApp button, Google Maps, a contact form, basic SEO and SSL.\",\"title\":\"What we build for you\"},\"terms\":{\"intro\":\"Draft — the full terms will be published before launch. In short: 50% advance, 2 free revision rounds, and content you provide must be yours to use.\",\"title\":\"Terms of service\"},\"trust\":[\"Mobile-first design\",\"Fast loading\",\"WhatsApp button\",\"Google Maps included\"]},\"now\":\"$undefined\",\"timeZone\":\"Asia/Calcutta\",\"children\":\"$L21\"}]\n21:[\"$\",\"$L3\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L4\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":[[\"$\",\"div\",null,{\"className\":\"flex min-h-screen flex-col items-center justify-center px-4 text-center\",\"children\":[[\"$\",\"h1\",null,{\"className\":\"text-4xl font-bold\",\"children\":\"404\"}],[\