---
// Shared layout for the Kumbuild blog — header with theme toggle,
// footer with routes back to the main site. Theme: saved choice
// (localStorage kb-theme) else system; inline script runs before
// paint so there is no flash (THEME.md no-flash rule).
import { Icon } from "astro-icon/components";
import "../styles/theme.css";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  type?: "website" | "article";
}

const { title, description, ogImage = "/blog/blog-shop.webp", type = "website" } = Astro.props;
const fullTitle = title === "Kumbuild Blog" ? title : `${title} — Kumbuild Blog`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/logo/kumbuild-logo.svg" />
    <script is:inline>
      (function () {
        var saved = null;
        try { saved = localStorage.getItem("kb-theme"); } catch (e) {}
        var dark = saved ? saved === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.dataset.theme = dark ? "dark" : "light";
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:type" content={type} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Kumbuild Blog" />
    <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title="Kumbuild Blog RSS" href="/rss.xml" />
    <meta name="theme-color" content="#faf9f6" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@500;600;700&display=swap"
    />
  </head>
  <body class="min-h-screen">
    <header class="sticky top-0 z-40 border-b border-line bg-paper/90 backdrop-blur-md">
      <div class="mx-auto flex h-16 max-w-3xl items-center gap-3 px-4 sm:px-6">
        <a href="/" class="flex items-center gap-2.5 text-ink">
          <img src="/logo/kumbuild-logo.svg" alt="Kumbuild" width="32" height="32" class="h-8 w-8" />
          <span class="font-display text-lg font-bold">Kumbuild</span>
          <span class="rounded-full bg-primary-50 px-2.5 py-0.5 font-mono text-xs font-medium text-primary-700">blog</span>
        </a>
        <nav class="ml-auto flex items-center gap-1.5 sm:gap-3" aria-label="Blog">
          <button
            type="button"
            data-search-open
            class="flex items-center gap-2 rounded-lg border border-line bg-card px-3 py-2 text-sm text-muted transition-colors hover:text-ink"
            aria-label="Search articles"
          >
            <Icon name="lucide:search" class="h-4 w-4" />
            <span class="hidden sm:inline">Search</span>
          </button>
          <button
            type="button"
            data-theme-toggle
            class="flex h-9 w-9 items-center justify-center rounded-lg border border-line bg-card text-body transition-colors hover:text-ink"
            aria-label="Switch theme"
          >
            <span data-icon-sun class="hidden"><Icon name="lucide:sun" class="h-[18px] w-[18px]" /></span>
            <span data-icon-moon class="hidden"><Icon name="lucide:moon" class="h-[18px] w-[18px]" /></span>
          </button>
          <a href="https://kumbuild.com/order" class="hidden rounded-xl bg-cta px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-cta-hover sm:block">
            Get your website
          </a>
        </nav>
      </div>
    </header>

    <div data-search-dialog class="fixed inset-0 z-50 hidden items-start justify-center bg-black/40 px-4 pt-24 backdrop-blur-sm">
      <div class="w-full max-w-xl overflow-hidden rounded-2xl border border-line bg-card shadow-2xl">
        <div class="flex items-center justify-between border-b border-line px-4 py-2.5">
          <span class="font-mono text-xs text-muted">Search the blog</span>
          <button type="button" data-search-close class="rounded-md px-2 py-1 text-sm text-muted hover:text-ink" aria-label="Close search">Esc</button>
        </div>
        <div id="pagefind-search" class="max-h-[55vh] overflow-y-auto p-3"></div>
      </div>
    </div>

    <main>
      <slot />
    </main>

    <footer class="mt-24 border-t border-line bg-surface">
      <div class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-4 px-4 py-8 text-sm text-muted sm:px-6">
        <p class="flex items-center gap-2">
          <img src="/logo/kumbuild-logo.svg" alt="" width="20" height="20" class="h-5 w-5" />
          Kumbuild Blog — notes for business owners.
        </p>
        <p class="flex gap-5">
          <a href="https://kumbuild.com" class="transition-colors hover:text-primary-700">kumbuild.com</a>
          <a href="https://docs.kumbuild.com" class="transition-colors hover:text-primary-700">Docs</a>
          <a href="/rss.xml" class="transition-colors hover:text-primary-700">RSS</a>
        </p>
      </div>
    </footer>

    <script>
      import Lenis from "lenis";
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const lenis = new Lenis({ duration: 1.1, easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)) });
        const raf = (time: number) => { lenis.raf(time); requestAnimationFrame(raf); };
        requestAnimationFrame(raf);
      }

      const root = document.documentElement;
      const sun = document.querySelector("[data-icon-sun]");
      const moon = document.querySelector("[data-icon-moon]");
      const paintToggle = () => {
        const dark = root.dataset.theme === "dark";
        sun?.classList.toggle("hidden", !dark);
        moon?.classList.toggle("hidden", dark);
      };
      paintToggle();
      document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        try { localStorage.setItem("kb-theme", next); } catch (e) {}
        paintToggle();
      });

      const dialog = document.querySelector("[data-search-dialog]") as HTMLElement | null;
      let pagefindReady: Promise<void> | null = null;
      function initPagefind() {
        if (!pagefindReady) {
          pagefindReady = (async () => {
            const link = document.createElement("link");
            link.rel = "stylesheet";
            link.href = "/pagefind/pagefind-ui.css";
            document.head.appendChild(link);
            const pagefindUrl = "/pagefind/pagefind-ui.js";
            const { PagefindUI } = await import(/* @vite-ignore */ pagefindUrl);
            new PagefindUI({ element: "#pagefind-search", showImages: false, showSubResults: true });
          })();
        }
        return pagefindReady;
      }
      function openSearch() {
        if (!dialog) return;
        dialog.classList.remove("hidden");
        dialog.classList.add("flex");
        void initPagefind().then(() => {
          dialog.querySelector(".pagefind-ui__search-input")?.focus();
        });
      }
      function closeSearch() {
        dialog?.classList.add("hidden");
        dialog?.classList.remove("flex");
      }
      document.querySelector("[data-search-open]")?.addEventListener("click", openSearch);
      document.querySelector("[data-search-close]")?.addEventListener("click", closeSearch);
      dialog?.addEventListener("click", (e) => { if (e.target === dialog) closeSearch(); });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeSearch();
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") { e.preventDefault(); openSearch(); }
      });
    </script>
  </body>
</html>
