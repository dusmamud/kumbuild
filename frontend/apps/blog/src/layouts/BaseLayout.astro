---
// Shared layout for the Kumbuild blog — header with theme toggle,
// footer with routes back to the main site. Theme: saved choice
// (localStorage kb-theme) else system; inline script runs before
// paint so there is no flash (THEME.md no-flash rule).
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import { NAV_LINKS, topicSlug } from "../lib/site";
import "../styles/theme.css";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const { title, description, ogImage = "/blog/blog-shop.webp", type = "website", publishedTime, modifiedTime, noindex = false, jsonLd } = Astro.props;
const fullTitle = title === "Kumbuild Blog" ? title : `${title} — Kumbuild Blog`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const posts = await getCollection("blog", ({ data }) => !data.draft);
const topics = [...new Set(posts.map((p) => p.data.tag))].map((tag) => ({ tag, slug: topicSlug(tag) }));
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/logo/kumbuild-logo.svg" />
    <link rel="icon" type="image/png" href="/logo/kumbuild-logo.png" />
    <link rel="apple-touch-icon" href="/logo/kumbuild-logo.png" />
    <script is:inline>
      (function () {
        var saved = null;
        try { saved = localStorage.getItem("kb-theme"); } catch (e) {}
        var dark = saved ? saved === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.dataset.theme = dark ? "dark" : "light";
        document.documentElement.classList.toggle("dark", dark);
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:type" content={type} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Kumbuild Blog" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />
    <meta property="og:image:alt" content={fullTitle} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).toString()} />
    <meta name="twitter:image:alt" content={fullTitle} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="alternate" type="application/rss+xml" title="Kumbuild Blog RSS" href="/rss.xml" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#faf9f6" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#111113" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@500;600;700&display=swap"
    />
  </head>
  <body class="min-h-screen">
    <div class="bg-[#1c1917] text-white">
      <div class="mx-auto flex min-h-9 max-w-6xl items-center justify-between gap-3 px-4 py-1 text-[12.5px] sm:px-6">
        <p class="flex min-w-0 items-center gap-2 font-medium">
          <span class="h-2 w-2 shrink-0 rounded-full bg-[#4ade80]" aria-hidden="true"></span>
          <span>Websites for small businesses<span class="hidden sm:inline"> — live in 3–5 days</span></span>
        </p>
        <p class="hidden font-mono text-[12px] text-white/70 md:block">From ₹3,999 · No advance for a quote</p>
      </div>
    </div>

    <header class="sticky top-0 z-40 border-b border-line bg-paper/90 backdrop-blur-md">
      <div class="mx-auto flex h-16 max-w-6xl items-center gap-3 px-4 sm:px-6">
        <a href="/" class="flex items-center gap-2.5 text-ink">
          <img src="/logo/kumbuild-logo.svg" alt="Kumbuild" width="32" height="32" class="h-8 w-8" />
          <span class="font-display text-lg font-bold">Kumbuild</span>
          <span class="rounded-full bg-primary-50 px-2.5 py-0.5 font-mono text-xs font-medium text-primary-700">blog</span>
        </a>
        <nav class="ml-6 hidden items-center gap-1 lg:flex" aria-label="Blog">
          {NAV_LINKS.slice(0, 3).map((l) => (
            <a href={l.href} class="rounded-lg px-3 py-2 text-[15px] font-medium text-body transition-colors hover:bg-surface hover:text-ink">{l.label}</a>
          ))}
          <span class="relative">
            <button type="button" data-topics-toggle class="flex items-center gap-1 rounded-lg px-3 py-2 text-[15px] font-medium text-body transition-colors hover:bg-surface hover:text-ink" aria-haspopup="true">
              All topics
              <Icon name="lucide:chevron-down" class="h-4 w-4" />
            </button>
            <span data-topics-menu class="absolute left-0 top-full z-50 hidden w-56 pt-2">
              <span class="block overflow-hidden rounded-xl border border-line bg-card py-2 shadow-xl">
                {topics.map((t) => (
                  <a href={`/topic/${t.slug}/`} class="flex items-center justify-between px-4 py-2 text-[15px] text-body transition-colors hover:bg-surface hover:text-ink">
                    {t.tag}
                    <Icon name="lucide:arrow-right" class="h-3.5 w-3.5 text-faint" />
                  </a>
                ))}
              </span>
            </span>
          </span>
        </nav>
        <div class="ml-auto flex items-center gap-1.5 sm:gap-2.5">
          <button
            type="button"
            data-search-open
            class="flex min-h-[44px] items-center gap-2 rounded-lg border border-line bg-card px-3 py-2 text-sm text-muted transition-colors hover:text-ink lg:min-h-9"
            aria-label="Search articles"
          >
            <Icon name="lucide:search" class="h-4 w-4" />
            <span class="hidden sm:inline">Search</span>
            <kbd class="hidden rounded border border-line bg-surface px-1.5 font-mono text-[11px] text-muted md:inline">⌘K</kbd>
          </button>
          <button
            type="button"
            data-theme-toggle
            class="flex h-11 w-11 items-center justify-center rounded-lg border border-line bg-card text-body transition-colors hover:text-ink lg:h-9 lg:w-9"
            aria-label="Switch theme"
          >
            <span data-icon-sun class="hidden"><Icon name="lucide:sun" class="h-[18px] w-[18px]" /></span>
            <span data-icon-moon class="hidden"><Icon name="lucide:moon" class="h-[18px] w-[18px]" /></span>
          </button>
          <a href="https://kumbuild.com/order" class="hidden rounded-xl bg-cta px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-cta-hover md:block">
            Get your website
          </a>
          <button type="button" data-menu-toggle class="flex h-11 w-11 items-center justify-center rounded-lg border border-line bg-card text-body lg:hidden" aria-label="Menu">
            <span data-icon-menu><Icon name="lucide:menu" class="h-5 w-5" /></span>
            <span data-icon-close class="hidden"><Icon name="lucide:x" class="h-5 w-5" /></span>
          </button>
        </div>
      </div>
      <div data-mobile-menu class="hidden border-t border-line bg-paper lg:hidden">
        <nav class="mx-auto max-w-6xl space-y-1 px-4 py-4 sm:px-6" aria-label="Menu">
          {NAV_LINKS.map((l) => (
            <a href={l.href} class="block rounded-lg px-3 py-3 text-base font-medium text-body transition-colors hover:bg-surface hover:text-ink">{l.label}</a>
          ))}
          <p class="px-3 pb-1 pt-4 font-mono text-xs text-muted">TOPICS</p>
          {topics.map((t) => (
            <a href={`/topic/${t.slug}/`} class="block rounded-lg px-3 py-3 text-base text-body transition-colors hover:bg-surface hover:text-ink">{t.tag}</a>
          ))}
          <a href="https://kumbuild.com/order" class="mt-3 flex items-center justify-center rounded-xl bg-cta px-4 py-3 text-base font-semibold text-white">Get your website</a>
        </nav>
      </div>
    </header>

    <div data-search-dialog class="fixed inset-0 z-50 hidden items-start justify-center bg-black/40 px-4 pt-24 backdrop-blur-sm">
      <div class="w-full max-w-xl overflow-hidden rounded-2xl border border-line bg-card shadow-2xl">
        <div class="flex items-center justify-between border-b border-line px-4 py-2.5">
          <span class="font-mono text-xs text-muted">Search the blog</span>
          <button type="button" data-search-close class="rounded-md px-2 py-1 text-sm text-muted hover:text-ink" aria-label="Close search">Esc</button>
        </div>
        <div id="pagefind-search" class="max-h-[55vh] overflow-y-auto p-3"></div>
      </div>
    </div>

    <main>
      <slot />
    </main>

    <footer class="mt-24 border-t border-line bg-surface">
      <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
        <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
          <div>
            <p class="flex items-center gap-2.5 text-ink">
              <img src="/logo/kumbuild-logo.svg" alt="Kumbuild" width="30" height="30" class="h-[30px] w-[30px]" />
              <span class="font-display text-lg font-bold">Kumbuild</span>
              <span class="rounded-full bg-primary-50 px-2.5 py-0.5 font-mono text-xs font-medium text-primary-700">blog</span>
            </p>
            <p class="mt-4 max-w-xs text-[15px] leading-[26px] text-body">
              Done-for-you websites for small businesses. This blog answers the questions owners actually ask — in plain words, no jargon.
            </p>
            <p class="mt-5 flex gap-2.5">
              <a href="https://wa.me/919876543210" target="_blank" rel="noopener" aria-label="WhatsApp" class="flex h-11 w-11 items-center justify-center rounded-xl border border-line bg-card text-body transition-colors hover:text-primary-700"><Icon name="lucide:message-circle" class="h-[18px] w-[18px]" /></a>
              <a href="https://kumbuild.com" aria-label="Kumbuild main site" class="flex h-11 w-11 items-center justify-center rounded-xl border border-line bg-card text-body transition-colors hover:text-primary-700"><Icon name="lucide:globe" class="h-[18px] w-[18px]" /></a>
              <a href="/rss.xml" aria-label="RSS feed" class="flex h-11 w-11 items-center justify-center rounded-xl border border-line bg-card text-body transition-colors hover:text-primary-700"><Icon name="lucide:rss" class="h-[18px] w-[18px]" /></a>
            </p>
          </div>
          <nav aria-label="Read">
            <p class="font-mono text-xs font-medium text-muted">READ</p>
            <ul class="mt-4 space-y-2.5 text-[15px]">
              <li><a href="/#latest" class="block py-1 text-body transition-colors hover:text-primary-700">Latest articles</a></li>
              <li><a href="/#topics" class="block py-1 text-body transition-colors hover:text-primary-700">Browse by topic</a></li>
              <li><a href="/#faq" class="block py-1 text-body transition-colors hover:text-primary-700">Blog FAQ</a></li>
              <li><a href="/rss.xml" class="block py-1 text-body transition-colors hover:text-primary-700">RSS feed</a></li>
            </ul>
          </nav>
          <nav aria-label="Topics">
            <p class="font-mono text-xs font-medium text-muted">TOPICS</p>
            <ul class="mt-4 space-y-2.5 text-[15px]">
              {topics.map((t) => (
                <li><a href={`/topic/${t.slug}/`} class="block py-1 text-body transition-colors hover:text-primary-700">{t.tag}</a></li>
              ))}
            </ul>
          </nav>
          <nav aria-label="Kumbuild">
            <p class="font-mono text-xs font-medium text-muted">KUMBUILD</p>
            <ul class="mt-4 space-y-2.5 text-[15px]">
              <li><a href="https://kumbuild.com" class="block py-1 text-body transition-colors hover:text-primary-700">kumbuild.com</a></li>
              <li><a href="https://kumbuild.com/pricing" class="block py-1 text-body transition-colors hover:text-primary-700">Pricing</a></li>
              <li><a href="https://kumbuild.com/examples" class="block py-1 text-body transition-colors hover:text-primary-700">Recent work</a></li>
              <li><a href="https://docs.kumbuild.com" class="block py-1 text-body transition-colors hover:text-primary-700">Help docs</a></li>
              <li><a href="https://kumbuild.com/order" class="font-semibold text-cta transition-opacity hover:opacity-80">Order a website</a></li>
            </ul>
          </nav>
        </div>
        <div class="mt-12 flex flex-wrap items-center justify-between gap-3 border-t border-line pt-6 text-sm text-muted">
          <p>© {year} Kumbuild. Written for business owners, by the people who build the websites.</p>
          <p class="flex gap-5">
            <a href="https://kumbuild.com/privacy" class="transition-colors hover:text-primary-700">Privacy</a>
            <a href="https://kumbuild.com/terms" class="transition-colors hover:text-primary-700">Terms</a>
            <a href="https://kumbuild.com/refund" class="transition-colors hover:text-primary-700">Refund policy</a>
          </p>
        </div>
      </div>
    </footer>

    <script>
      import Lenis from "lenis";
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const lenis = new Lenis({ duration: 1.1, easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)) });
        const raf = (time: number) => { lenis.raf(time); requestAnimationFrame(raf); };
        requestAnimationFrame(raf);
      }

      const root = document.documentElement;
      const sun = document.querySelector("[data-icon-sun]");
      const moon = document.querySelector("[data-icon-moon]");
      const paintToggle = () => {
        const dark = root.dataset.theme === "dark";
        sun?.classList.toggle("hidden", !dark);
        moon?.classList.toggle("hidden", dark);
      };
      paintToggle();
      const topicsMenu = document.querySelector("[data-topics-menu]");
      const topicsToggle = document.querySelector("[data-topics-toggle]");
      topicsToggle?.addEventListener("click", (e) => {
        e.stopPropagation();
        topicsMenu?.classList.toggle("hidden");
      });
      document.addEventListener("click", () => topicsMenu?.classList.add("hidden"));

      const mobileMenu = document.querySelector("[data-mobile-menu]");
      const menuIcon = document.querySelector("[data-icon-menu]");
      const closeIcon = document.querySelector("[data-icon-close]");
      document.querySelector("[data-menu-toggle]")?.addEventListener("click", () => {
        const open = mobileMenu?.classList.toggle("hidden") === false;
        menuIcon?.classList.toggle("hidden", open);
        closeIcon?.classList.toggle("hidden", !open);
      });
      mobileMenu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => {
        mobileMenu.classList.add("hidden");
        menuIcon?.classList.remove("hidden");
        closeIcon?.classList.add("hidden");
      }));

      document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        root.classList.toggle("dark", next === "dark");
        try { localStorage.setItem("kb-theme", next); } catch (e) {}
        paintToggle();
      });

      const dialog = document.querySelector("[data-search-dialog]") as HTMLElement | null;
      let pagefindReady: Promise<void> | null = null;
      function initPagefind() {
        if (!pagefindReady) {
          pagefindReady = (async () => {
            const link = document.createElement("link");
            link.rel = "stylesheet";
            link.href = "/pagefind/pagefind-ui.css";
            document.head.appendChild(link);
            const pagefindUrl = "/pagefind/pagefind-ui.js";
            const { PagefindUI } = await import(/* @vite-ignore */ pagefindUrl);
            new PagefindUI({ element: "#pagefind-search", showImages: false, showSubResults: true });
          })();
        }
        return pagefindReady;
      }
      function openSearch() {
        if (!dialog) return;
        dialog.classList.remove("hidden");
        dialog.classList.add("flex");
        void initPagefind().then(() => {
          dialog.querySelector(".pagefind-ui__search-input")?.focus();
        });
      }
      function closeSearch() {
        dialog?.classList.add("hidden");
        dialog?.classList.remove("flex");
      }
      document.querySelector("[data-search-open]")?.addEventListener("click", openSearch);
      document.querySelector("[data-search-close]")?.addEventListener("click", closeSearch);
      dialog?.addEventListener("click", (e) => { if (e.target === dialog) closeSearch(); });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeSearch();
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") { e.preventDefault(); openSearch(); }
      });
    </script>
    <!-- Mock phase only: pages.dev pe *.kumbuild.com links ko sibling *.pages.dev URLs pe badal do. Custom domain lagne ke baad ye kuch nahi karega. -->
    <script>
      (function () {
        function rewrite() {
          if (!window.location.hostname.endsWith(".pages.dev")) return;
          var map = {
            "kumbuild.com": "kumbuild-web.pages.dev",
            "blog.kumbuild.com": "kumbuild-blog.pages.dev",
            "docs.kumbuild.com": "kumbuild-docs.pages.dev",
            "account.kumbuild.com": "kumbuild-account.pages.dev",
            "auth.kumbuild.com": "kumbuild-account.pages.dev",
            "admin.kumbuild.com": "kumbuild-admin.pages.dev",
            "home.kumbuild.com": "kumbuild-home.pages.dev",
          };
          document.querySelectorAll('a[href*="kumbuild.com"]').forEach(function (a) {
            try {
              var u = new URL(a.getAttribute("href"), window.location.origin);
              if (map[u.hostname]) {
                u.hostname = map[u.hostname];
                a.setAttribute("href", u.toString());
              }
            } catch (e) {}
          });
        }
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", rewrite);
        } else {
          rewrite();
        }
      })();
    </script>
  </body>
</html>
