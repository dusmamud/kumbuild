---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" });
---

<BaseLayout title="Page not found" description="This page does not exist on the Kumbuild blog. Browse the latest articles instead." noindex>
  <section class="mx-auto max-w-6xl px-4 pt-16 sm:px-6 sm:pt-24">
    <div class="max-w-2xl">
      <p class="font-mono text-sm font-medium text-primary-700">404</p>
      <h1 class="mt-4 font-display text-[clamp(2rem,1.6rem+2vw,3rem)] font-semibold leading-[1.12] text-ink">
        This page is not here.
      </h1>
      <p class="mt-4 text-lg leading-[30px] text-body">
        The link may be old, or the address may have a typo. The articles are all safe — start from one of these:
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href="/" class="inline-flex min-h-[44px] items-center gap-2 rounded-xl bg-cta px-5 py-3 text-base font-semibold text-white transition-colors hover:bg-cta-hover">
          <Icon name="lucide:arrow-left" class="h-4 w-4" />
          Back to the blog
        </a>
        <button type="button" data-search-open class="inline-flex min-h-[44px] items-center gap-2 rounded-xl border border-line bg-card px-5 py-3 text-base font-semibold text-ink transition-colors hover:border-primary-300">
          <Icon name="lucide:search" class="h-5 w-5" />
          Search articles
        </button>
      </div>
    </div>

    <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <a href={`/${post.id}/`} class="group flex flex-col overflow-hidden rounded-2xl border border-line bg-card transition-[border-color,box-shadow,transform] duration-300 hover:-translate-y-0.5 hover:border-primary-200 hover:shadow-[0_20px_40px_-24px_rgba(28,25,23,0.3)]">
          {post.data.heroImage && <img src={post.data.heroImage} alt="" width="1200" height="675" loading="lazy" class="aspect-[16/9] w-full object-cover" />}
          <span class="flex flex-1 flex-col p-6">
            <span class="flex flex-wrap items-center gap-3 font-mono text-xs text-muted">
              <span class="rounded-full bg-primary-50 px-2.5 py-1 font-sans text-xs font-semibold text-primary-700">{post.data.tag}</span>
              {fmt(post.data.pubDate)}
            </span>
            <span class="mt-3 font-display text-lg font-semibold leading-snug text-ink group-hover:text-primary-700">{post.data.title}</span>
            <span class="mt-4 font-mono text-xs text-muted">{post.data.readMins} min read</span>
          </span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
