---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const [featured, ...rest] = posts;
const fmt = (d: Date) =>
  d.toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" });
---

<BaseLayout title="Kumbuild Blog" description="Notes for business owners — getting found on Google, taking orders on WhatsApp, and what a website should really cost. No jargon, no courses to buy.">
  <section class="mx-auto max-w-3xl px-4 pt-14 sm:px-6 sm:pt-20">
    <p class="flex items-center gap-3 text-[13px] font-semibold text-primary-700">
      <span class="h-px w-8 bg-primary-500" aria-hidden="true"></span>
      Kumbuild Blog
    </p>
    <h1 class="mt-5 font-display text-[clamp(2rem,1.55rem+2.2vw,3rem)] font-semibold leading-[1.12] text-ink">
      Notes for business owners.
    </h1>
    <p class="mt-4 max-w-xl text-lg leading-[30px] text-body">
      Short, practical reads on getting customers from the internet — no jargon, no courses to buy.
    </p>
  </section>

  {featured && (
    <section class="mx-auto max-w-3xl px-4 pt-12 sm:px-6">
      <a href={`/${featured.id}/`} class="group block overflow-hidden rounded-[24px] border border-line bg-card transition-[border-color,box-shadow,transform] duration-300 hover:-translate-y-0.5 hover:border-primary-200 hover:shadow-[0_24px_44px_-24px_rgba(28,25,23,0.35)]">
        {featured.data.heroImage && (
          <img src={featured.data.heroImage} alt="" width="1200" height="675" class="aspect-[16/9] w-full object-cover" />
        )}
        <span class="block p-6 sm:p-8">
          <span class="flex flex-wrap items-center gap-3 font-mono text-xs text-muted">
            <span class="rounded-full bg-primary-50 px-2.5 py-1 font-sans text-xs font-semibold text-primary-700">{featured.data.tag}</span>
            {fmt(featured.data.pubDate)} · {featured.data.readMins} min read
          </span>
          <span class="mt-3 block font-display text-[clamp(1.4rem,1.2rem+1vw,1.75rem)] font-semibold leading-snug text-ink group-hover:text-primary-700">
            {featured.data.title}
          </span>
          <span class="mt-2 block text-base leading-[28px] text-body">{featured.data.description}</span>
          <span class="mt-4 inline-flex items-center gap-1.5 text-base font-semibold text-primary-700">
            Read the article
            <Icon name="lucide:arrow-right" class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5" />
          </span>
        </span>
      </a>
    </section>
  )}

  <section class="mx-auto max-w-3xl px-4 pt-12 sm:px-6">
    <div class="grid gap-5 sm:grid-cols-2">
      {rest.map((post) => (
        <a href={`/${post.id}/`} class="group flex flex-col overflow-hidden rounded-2xl border border-line bg-card transition-[border-color,box-shadow,transform] duration-300 hover:-translate-y-0.5 hover:border-primary-200 hover:shadow-[0_20px_40px_-24px_rgba(28,25,23,0.3)]">
          {post.data.heroImage && (
            <img src={post.data.heroImage} alt="" width="1200" height="675" loading="lazy" class="aspect-[16/9] w-full object-cover" />
          )}
          <span class="flex flex-1 flex-col p-6">
            <span class="flex flex-wrap items-center gap-3 font-mono text-xs text-muted">
              <span class="rounded-full bg-primary-50 px-2.5 py-1 font-sans text-xs font-semibold text-primary-700">{post.data.tag}</span>
              {fmt(post.data.pubDate)}
            </span>
            <span class="mt-3 font-display text-lg font-semibold leading-snug text-ink group-hover:text-primary-700">{post.data.title}</span>
            <span class="mt-2 flex-1 text-[15px] leading-[26px] text-body">{post.data.description}</span>
            <span class="mt-4 font-mono text-xs text-muted">{post.data.readMins} min read</span>
          </span>
        </a>
      ))}
    </div>

    <div class="mt-16 rounded-[24px] border border-line bg-surface p-7 text-center sm:p-10">
      <h2 class="font-display text-[clamp(1.5rem,1.3rem+1.2vw,2rem)] font-semibold text-ink">Your customers are searching. Be the result they find.</h2>
      <p class="mx-auto mt-3 max-w-md text-base leading-[28px] text-body">Tell us what to build — a professional website for your business, live in 3–5 working days.</p>
      <a href="https://kumbuild.com/order" class="mt-6 inline-flex items-center gap-2 rounded-xl bg-cta px-7 py-3.5 text-base font-semibold text-white transition-colors hover:bg-cta-hover">
        Order your website
        <Icon name="lucide:arrow-right" class="h-4 w-4" />
      </a>
    </div>
  </section>
</BaseLayout>
