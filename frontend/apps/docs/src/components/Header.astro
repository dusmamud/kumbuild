---
// Docs header override — Starlight's default header, plus the
// brand's order-slip utility strip on top (live dot + offer line)
// and a quick link row. The strip uses fixed ink/green values so it
// reads the same in light and dark, exactly like the blog header.
import Default from "@astrojs/starlight/components/Header.astro";
---

<div class="kb-strip">
  <p class="kb-strip-left">
    <span class="kb-dot" aria-hidden="true"></span>
    Help for Kumbuild customers
  </p>
  <p class="kb-strip-right">
    <!-- Custom domain live hai (Nov 2026) — links seedha kumbuild.com par. -->
    <a href="https://kumbuild.com/pricing/">Websites from ₹3,999</a>
    <span aria-hidden="true">·</span>
    <a href="https://kumbuild.com/order/">Order yours</a>
  </p>
</div>
<Default {...Astro.props} />

<style>
  .kb-strip {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    background: #1c1917; color: #fff;
    font-size: 0.78rem;
    /* Exact height so starlight.css can compensate --sl-nav-height by the
       same amount; bleed to the header's edges by cancelling its actual
       horizontal padding (--sl-nav-pad-x, equal to content-pad today). */
    height: var(--kb-strip-height, 2rem);
    flex: none;
    padding: 0 max(1rem, env(safe-area-inset-left)) 0 max(1rem, env(safe-area-inset-right));
    margin: 0 calc(-1 * var(--sl-nav-pad-x, 1rem));
  }
  .kb-strip p { margin: 0; display: flex; align-items: center; gap: 0.5rem; }
  .kb-dot { width: 0.5rem; height: 0.5rem; border-radius: 999px; background: #4ade80; }
  .kb-strip-right { color: rgba(255,255,255,0.65); font-family: var(--sl-font-mono); font-size: 0.72rem; }
  .kb-strip a { color: #fff; text-decoration: none; font-weight: 500; }
  .kb-strip a:hover { text-decoration: underline; }
  /* Sidebar pages on MOBILE only: Starlight reserves room for the fixed
     menu button on the right (gap + pad + button size) — cancel that too
     so the strip bleeds edge-to-edge instead of stopping ~48px short.
     From 50rem Starlight itself drops the reserve (menu button hidden),
     so the base -pad-x margin is correct there and this must not apply.
     The menu button sits below the strip, so nothing collides. */
  @media (max-width: 50rem) {
    html[data-has-sidebar] .kb-strip {
      margin-inline-end: calc(-1 * (var(--sl-nav-gap) + var(--sl-nav-pad-x) + var(--sl-menu-button-size)));
    }
  }
  /* Pre-existing specificity trap: `.kb-strip p { display: flex }`
     (0,1,1) beats a bare `.kb-strip-right` (0,1,0), so the old rule
     never hid the strip on mobile. Qualify it to (0,2,0). */
  @media (max-width: 40rem) { .kb-strip .kb-strip-right { display: none; } }
</style>
