---
import Default from "@astrojs/starlight/components/Head.astro";
import ClientRouter from "astro/components/ClientRouter.astro";
---

<Default {...Astro.props} />
<!-- Astro 7 view transitions: ClientRouter now lives in astro/components
  (astro/transitions was removed in Astro 7 — no config change needed,
  no experimental flag). Short cross-fade only; see starlight.css for the
  duration + the reduced-motion kill-switch. -->
<ClientRouter />
<!-- Fonts self-hosted (/fonts/fonts.css) — Google CDN request nahi. -->
<link rel="stylesheet" href="/fonts/fonts.css" />
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#faf9f6" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#111113" />
<!-- Radix slateDark vars resolve under .dark; Starlight toggles data-theme, so keep .dark in sync (initial + on change). Runs inline in <head>, after Starlight's own theme script, so the first paint already has the right class. -->
<script is:inline>
  (function () {
    function sync() {
      document.documentElement.classList.toggle("dark", document.documentElement.dataset.theme === "dark");
    }
    sync();
    new MutationObserver(sync).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
  })();
</script>
<!-- Scroll reveal (motion-safe only): adds html.kb-motion, then fades each
  top-level content block / card in via IntersectionObserver. Gated on
  prefers-reduced-motion so reduced-motion + no-JS readers never see
  hidden content. Re-runs on astro:page-load (fires on first load and
  after every ClientRouter navigation). -->
<script>
  (function () {
    if (!window.matchMedia("(prefers-reduced-motion: no-preference)").matches) return;
    document.documentElement.classList.add("kb-motion");
    var seen = new WeakSet();
    function init() {
      var els = document.querySelectorAll(
        ".sl-markdown-content > *, .card-grid > *, .hero .copy, .hero .actions"
      );
      if (!("IntersectionObserver" in window)) {
        els.forEach(function (el) { el.classList.add("kb-reveal", "kb-in"); });
        return;
      }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add("kb-in");
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.05, rootMargin: "0px 0px 100px 0px" });
      els.forEach(function (el) {
        if (seen.has(el)) return;
        seen.add(el);
        el.classList.add("kb-reveal");
        io.observe(el);
      });
      /* Safety net (manual fix 2026-11-21): never leave content hidden.
         If the observer never fires for an element — fast scroll, odd
         layout, slow device — reveal everything after 1.2s anyway. */
      setTimeout(function () {
        els.forEach(function (el) { el.classList.add("kb-in"); });
      }, 1200);
    }
    init();
    document.addEventListener("astro:page-load", init);
  })();
</script>
<!-- View-transition safety: Astro's router swaps <body> without re-running
  Starlight's head theme script, so if a swap ever resets <html> attrs,
  re-apply the stored theme (localStorage 'starlight-theme') after swap.
  The .dark sync observer above then follows data-theme as usual. -->
<script>
  document.addEventListener("astro:after-swap", function () {
    try {
      var stored = localStorage.getItem("starlight-theme");
      if (stored === "light" || stored === "dark") {
        document.documentElement.dataset.theme = stored;
      }
    } catch (e) {}
  });
</script>
<!-- Drawer focus (audit F9): Starlight's mobile drawer is a popover and
  opens without moving focus, so keyboard users tab from the Menu button
  instead of the top of the drawer. No Starlight fork needed — the
  popover `toggle` event fires on open/close; capture it on document
  (it does not bubble, and the listener must survive ClientRouter swaps)
  and move focus to the first sidebar link on open. On close, if focus
  was lost to <body>, return it to the Menu button. -->
<script>
  document.addEventListener(
    "toggle",
    function (e) {
      if (!e.target || e.target.id !== "starlight__sidebar") return;
      if (e.newState === "open") {
        var first = e.target.querySelector("a[href]");
        if (first) first.focus();
      } else if (document.activeElement === document.body) {
        var btn = document.querySelector("starlight-menu-btn button, [aria-controls='starlight__sidebar']");
        if (btn) btn.focus();
      }
    },
    true
  );
</script>
<!-- Mock phase only: pages.dev pe *.kumbuild.com links ko sibling *.pages.dev URLs pe badal do. Custom domain lagne ke baad ye kuch nahi karega. -->
<script>
  (function () {
    function rewrite() {
      if (!window.location.hostname.endsWith(".pages.dev")) return;
      var map = {
        "kumbuild.com": "kumbuild-main-8hs.pages.dev",
        "blog.kumbuild.com": "kumbuild-blog-7ha.pages.dev",
        "docs.kumbuild.com": "kumbuild-docs-4fs.pages.dev",
      };
      document.querySelectorAll('a[href*="kumbuild.com"]').forEach(function (a) {
        try {
          var u = new URL(a.getAttribute("href"), window.location.origin);
          if (map[u.hostname]) {
            u.hostname = map[u.hostname];
            a.setAttribute("href", u.toString());
          }
        } catch (e) {}
      });
    }
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", rewrite);
    } else {
      rewrite();
    }
    // ClientRouter navigations swap content without a full load — re-run
    // the rewrite on every page swap too.
    document.addEventListener("astro:page-load", rewrite);
  })();
</script>
